+TEST_CASE("SSX Reflex distinguishes control-only workers from incomplete physics", "[ssx-reflex]") {
+  for (unsigned scenario = 0; scenario < 7; ++scenario) {
+    CAPTURE(scenario);
+    GuestReflex scheduler;
+    unsigned cancels = 0;
+    GuestReflex::Backend backend;
+    backend.begin = [](uint64_t) { return true; };
+    backend.end = [](uint64_t) { return true; };
+    backend.bind = [](uint64_t a, uint64_t b) { return a == b; };
+    backend.cancel = [&](uint64_t) { ++cancels; };
+    scheduler.Attach(&scheduler, backend, true);
+    REQUIRE(scheduler.BeginRenderUpdate(1, [] { return true; }));
+    scheduler.Complete(1);
+    std::atomic<bool> finished{false}, begun{false};
+    std::thread worker([&] {
+      begun = scheduler.BeginWorker(1000);
+      if (begun) {
+        const auto update = scheduler.InputUpdateForWorker(1000);
+        if (scenario != 1) {
+          scheduler.Input(1000);
+          for (uint32_t user = 0; user < (scenario == 5 ? 1u : 4u); ++user)
+            scheduler.ConsumedInput(1000, update, user);
+        }
+        if (scenario >= 2 && scenario <= 4)
+          scheduler.BeginSamples(1000);
+        if (scenario == 2 || scenario == 3 || scenario == 6)
+          scheduler.Published(1000, {uint64_t(1) << 32 | 10, 1, 123});
+        if (scenario == 2)
+          scheduler.Published(1000, {uint64_t(2) << 32 | 20, 2, 123});
+        scheduler.EndWorker(1000);
+      }
+      finished = true;
+    });
+    bool valid = true;
+    for (uint64_t render = 2; render < 102 && !finished.load(); ++render) {
+      valid &= scheduler.BeginRenderUpdate(render, [] { return true; });
+      scheduler.Complete(render);
+      std::this_thread::sleep_for(1ms);
+    }
+    worker.join();
+    CHECK(begun.load());
+    CHECK(valid == (scenario < 3));
+    CHECK(cancels == (scenario < 3 ? 0 : 1));
+    scheduler.Detach(&scheduler);
+  }
+}
