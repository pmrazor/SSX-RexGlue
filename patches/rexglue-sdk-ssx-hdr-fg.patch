diff --git a/tests/unit/graphics/ssx_hdr_test.cpp b/tests/unit/graphics/ssx_hdr_test.cpp
index 5443f29..cd7195c 100644
--- a/tests/unit/graphics/ssx_hdr_test.cpp
+++ b/tests/unit/graphics/ssx_hdr_test.cpp
@@ -3,6 +3,81 @@
 #include <rex/ui/d3d12/ssx_hdr_layers.h>
 #include <limits>
 using namespace rex::ui::d3d12;
+TEST_CASE("SSX HDR status excludes menus repeats calibration and SDR output", "[SSX][HDR]") {
+  SsxHDRStatus status;
+  status.SetCurrent(SsxHDRPath::kNative);
+  CHECK(status.RecordAt(1, 100, SsxHDRPath::kNative, true));
+  CHECK_FALSE(status.RecordAt(1.1, 100, SsxHDRPath::kLayers, true));
+  CHECK_FALSE(status.RecordAt(1.2, 99, SsxHDRPath::kLayers, true));
+  CHECK_FALSE(status.RecordAt(1.3, 101, SsxHDRPath::kFrontend, false));
+  CHECK_FALSE(status.RecordAt(1.4, 102, SsxHDRPath::kCalibration, true));
+  CHECK_FALSE(status.RecordAt(1.5, 103, SsxHDRPath::kSDRDisplay, true));
+  CHECK_FALSE(status.RecordAt(1.6, 0, SsxHDRPath::kFrameTiming, false));
+  CHECK_FALSE(status.RecordAt(std::numeric_limits<double>::quiet_NaN(), 104, SsxHDRPath::kNative, true));
+  CHECK(status.RecordAt(2, 104, SsxHDRPath::kLayers, true));
+  CHECK(status.RecordAt(2.1, 105, SsxHDRPath::kNative, true));
+  const auto snapshot = status.ReadAt(3);
+  CHECK(snapshot.path == SsxHDRPath::kNative);
+  CHECK(snapshot.native_frames == 2);
+  CHECK(snapshot.fallback_frames == 1);
+  CHECK(snapshot.last_fallback == SsxHDRPath::kLayers);
+  CHECK(snapshot.recent_fallback);
+  CHECK_FALSE(status.ReadAt(7.1).recent_fallback);
+  CHECK_FALSE(status.ReadAt(1).recent_fallback);
+}
+TEST_CASE("SSX HDR planner reports missing native scene instead of native output", "[SSX][HDR]") {
+  SsxFrameInputs input;
+  SsxHDRConstants k;
+  SsxHDRPath path = SsxHDRPath::kNative;
+  CHECK_FALSE(PlanSsxHDR(input, k, true, true, &path));
+  CHECK(path == SsxHDRPath::kRetainedScene);
+  CHECK(k.native_scene == 0);
+  CHECK(IsSsxHDRRaceFallback(path));
+}
