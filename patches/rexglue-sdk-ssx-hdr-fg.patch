+void SsxHDRStatus::SetCurrent(SsxHDRPath path) {
+  std::lock_guard lock(mutex_);
+  snapshot_.path = path;
+}
+bool SsxHDRStatus::RecordAt(double now, uint64_t render_id, SsxHDRPath path, bool race) {
+  std::lock_guard lock(mutex_);
+  if (!std::isfinite(now) || !render_id || render_id <= last_render_) return false;
+  last_render_ = render_id;
+  if (!race) return false;
+  if (path == SsxHDRPath::kNative) {
+    ++snapshot_.native_frames;
+  } else if (IsSsxHDRRaceFallback(path)) {
+    ++snapshot_.fallback_frames;
+    snapshot_.last_fallback = path;
+    last_fallback_time_ = now;
+  } else return false;
+  return true;
+}
+SsxHDRStatus::Snapshot SsxHDRStatus::ReadAt(double now) const {
+  std::lock_guard lock(mutex_);
+  auto result = snapshot_;
+  result.recent_fallback = last_fallback_time_ >= 0 && std::isfinite(now) &&
+      now >= last_fallback_time_ && now - last_fallback_time_ <= 5;
+  return result;
