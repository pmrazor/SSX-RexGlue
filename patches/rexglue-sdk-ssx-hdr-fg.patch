+TEST_CASE("SSX FG rejects mismatched display formats and scRGB", "[SSX][HDR][FG]") {
+  CHECK(Streamline::ValidFGColorFormat(DXGI_FORMAT_R10G10B10A2_UNORM, true));
+  CHECK_FALSE(Streamline::ValidFGColorFormat(DXGI_FORMAT_R10G10B10A2_UNORM, false));
+  for (auto format : {DXGI_FORMAT_R8G8B8A8_UNORM, DXGI_FORMAT_B8G8R8A8_UNORM}) {
+    CHECK(Streamline::ValidFGColorFormat(format, false));
+    CHECK_FALSE(Streamline::ValidFGColorFormat(format, true));
+  }
+  for (auto format : {DXGI_FORMAT_R16G16B16A16_FLOAT, DXGI_FORMAT_R10G10B10A2_TYPELESS,
+                       DXGI_FORMAT_UNKNOWN}) {
+    CHECK_FALSE(Streamline::ValidFGColorFormat(format, false));
+    CHECK_FALSE(Streamline::ValidFGColorFormat(format, true));
+  }
+}
