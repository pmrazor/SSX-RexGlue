+#pragma once
+#include <cstdint>
+#include <mutex>
+
+namespace rex::ui::d3d12 {
+enum class SsxHDRPath {
+  kOff, kNative, kCalibration, kSDRDisplay, kFrontend,
+  kFrameTiming, kFrameInputs, kRetainedScene, kSceneColor, kExposure, kGrading, kLayers
+};
+const char* SsxHDRPathName(SsxHDRPath path);
+inline bool IsSsxHDRRaceFallback(SsxHDRPath path) {
+  return path >= SsxHDRPath::kFrameTiming && path <= SsxHDRPath::kLayers;
+}
+// Report composition, not just the swap-chain color space. Counters count each
+// successfully presented rendered race frame once, excluding menus, pauses,
+// repeated UI paints, calibration, SDR displays and generated presentations.
+class SsxHDRStatus {
+ public:
+  struct Snapshot {
+    SsxHDRPath path = SsxHDRPath::kOff, last_fallback = SsxHDRPath::kOff;
+    uint64_t native_frames = 0, fallback_frames = 0;
+    bool recent_fallback = false;
+  };
+  static SsxHDRStatus& Get();
+  static double Now();
+  void SetCurrent(SsxHDRPath path);
+  bool RecordAt(double now, uint64_t render_id, SsxHDRPath path, bool race);
+  Snapshot ReadAt(double now) const;
+  Snapshot Read() const { return ReadAt(Now()); }
+ private:
+  mutable std::mutex mutex_;
+  Snapshot snapshot_;
+  uint64_t last_render_ = 0;
+  double last_fallback_time_ = -1;
+};
+}  // namespace rex::ui::d3d12
