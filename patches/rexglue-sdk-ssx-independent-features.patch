 namespace rex::ui::d3d12 {
+Streamline::Quality SsxSelectedQuality() {
+  if (!REXCVAR_GET(d3d12_ssx_quality)) return Streamline::Quality::kDLAA;
+  const auto mode = REXCVAR_GET(d3d12_ssx_dlss_mode);
+  if (mode == "balanced") return Streamline::Quality::kBalanced;
+  if (mode == "performance") return Streamline::Quality::kPerformance;
+  return Streamline::Quality::kQuality;
+}
+const char* SsxSelectedQualityName() {
+  switch (SsxSelectedQuality()) {
+    case Streamline::Quality::kQuality: return "Quality";
+    case Streamline::Quality::kBalanced: return "Balanced";
+    case Streamline::Quality::kPerformance: return "Performance";
+    default: return "DLAA";
+  }
+}
+uint32_t SsxRasterScale(uint32_t output_scale) {
+  // ReXGlue raster/EDRAM allocation supports integer scales. Round UP so the
+  // experimental input resampler never invents detail below the selected size.
+  // NVIDIA's optimal input dimensions are queried separately at reconstruction.
+  switch (SsxSelectedQuality()) {
+    case Streamline::Quality::kQuality: return (output_scale * 2 + 2) / 3;
+    case Streamline::Quality::kBalanced: return (output_scale * 58 + 99) / 100;
+    case Streamline::Quality::kPerformance: return (output_scale + 1) / 2;
+    default: return output_scale;
+  }
+}
