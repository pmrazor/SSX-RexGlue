diff --git a/src/ui/shaders/ssx_reconstruction_inputs.cs.hlsl b/src/ui/shaders/ssx_reconstruction_inputs.cs.hlsl
new file mode 100644
index 0000000..9eccb6c
--- /dev/null
+++ b/src/ui/shaders/ssx_reconstruction_inputs.cs.hlsl
@@ -0,0 +1,26 @@
+// Experimental integer-raster bridge to NVIDIA's optimal input dimensions.
+// Depth and motion use the same source pixel; motion remains in input pixels.
+cbuffer Parameters : register(b0) { uint2 source_size; uint2 target_size; };
+Texture2D<float4> color_in : register(t0);
+Texture2D<float> depth_in : register(t1);
+Texture2D<float2> motion_in : register(t2);
+RWTexture2D<float4> color_out : register(u0);
+RWTexture2D<float> depth_out : register(u1);
+RWTexture2D<float2> motion_out : register(u2);
+[numthreads(8,8,1)]
+void main(uint3 id : SV_DispatchThreadID) {
+  if (any(id.xy >= target_size)) return;
+  float2 uv = (float2(id.xy) + .5) * float2(source_size) / float2(target_size);
+  int2 hi = int2(source_size) - 1;
+  int2 nearest = clamp(int2(uv), int2(0,0), hi);
+  float2 pos = uv - .5;
+  int2 p = int2(floor(pos));
+  float2 f = frac(pos);
+  float4 a = color_in.Load(int3(clamp(p,int2(0,0),hi),0));
+  float4 b = color_in.Load(int3(clamp(p+int2(1,0),int2(0,0),hi),0));
+  float4 c = color_in.Load(int3(clamp(p+int2(0,1),int2(0,0),hi),0));
+  float4 d = color_in.Load(int3(clamp(p+int2(1,1),int2(0,0),hi),0));
+  color_out[id.xy] = lerp(lerp(a,b,f.x),lerp(c,d,f.x),f.y);
+  depth_out[id.xy] = depth_in.Load(int3(nearest,0));
+  motion_out[id.xy] = motion_in.Load(int3(nearest,0)) * float2(target_size) / float2(source_size);
+}
