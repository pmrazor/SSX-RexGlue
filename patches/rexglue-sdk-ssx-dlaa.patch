+++ b/src/ui/d3d12/ssx_reconstruction.cpp
@@ -0,0 +1,291 @@
+#include <rex/ui/d3d12/ssx_reconstruction.h>
+#include <rex/ui/d3d12/d3d12_provider.h>
+#include <rex/ui/d3d12/d3d12_submission_tracker.h>
+#include <rex/ui/d3d12/d3d12_util.h>
