diff --git a/src/ui/shaders/ssx_reconstruction_encode.cs.hlsl b/src/ui/shaders/ssx_reconstruction_encode.cs.hlsl
new file mode 100644
index 0000000..5d86050
--- /dev/null
+++ b/src/ui/shaders/ssx_reconstruction_encode.cs.hlsl
@@ -0,0 +1,15 @@
+// Return reconstructed linear RGB to the representation consumed by SSX's
+// original tone map. Keep the original alpha; DLSS alpha upscaling is disabled.
+cbuffer Constants : register(b0) { uint2 extent; float inverse_color_scale; uint unused; };
+Texture2D<float4> reconstructed : register(t0);
+Texture2D<float4> original : register(t1);
+RWTexture2D<float4> encoded : register(u0);
+[numthreads(8,8,1)]
+void main(uint3 id : SV_DispatchThreadID) {
+  if (any(id.xy >= extent)) return;
+  float4 raw = original.Load(int3(id.xy,0));
+  float3 value = reconstructed.Load(int3(id.xy,0)).rgb;
+  // A failed numerical pixel keeps its guest color, not a purple/NaN result.
+  float3 result = all(isfinite(value)) ? sqrt(max(value,0))*inverse_color_scale : raw.rgb;
+  encoded[id.xy] = float4(result,raw.a);
+}
