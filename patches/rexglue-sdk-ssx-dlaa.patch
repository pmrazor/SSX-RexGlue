 using namespace rex::ui::d3d12;
 
+TEST_CASE("SSX frozen scene boundary retains the producer pool slot", "[ssx-inputs]") {
+  SsxFrameInputPool pool;
+  auto producer=pool.Acquire(1,0);
+  auto* original=producer.get();
+  auto frozen=std::make_shared<SsxFrameInputs>(*producer);
+  frozen->producer_owner=producer;
+  producer.reset();
+  std::array<std::shared_ptr<SsxFrameInputs>,5> other;
+  for(auto& item:other) {
+    item=pool.Acquire(2,0); REQUIRE(item); CHECK(item.get()!=original);
+  }
+  CHECK_FALSE(pool.Acquire(3,0));
+  frozen.reset();
+  CHECK(pool.Acquire(3,0).get()==original);
+}
