+namespace rex::ui::d3d12 {
+class D3D12Provider;
+// Decompose the captured unjittered world-to-clip transform. Reject skewed,
+// off-axis and non-perspective cameras rather than supplying invented constants.
+// The returned projection and history use SSX's reversed device-depth space.
+bool BuildSsxSRCamera(const SsxFrameMetadata& frame, const SsxMotionPlan& motion,
+                      Streamline::SRCamera& camera);
+
+// Experimental same-resolution reconstruction at the guest tone-map boundary.
+// Single command-processor-thread owner. Uses separate command lists on the
+// provider's direct queue; the caller first submits all input-producing work.
+class SsxReconstruction {
+ public:
+  struct Result {
+    bool submitted = false, applied = false, reset = false;
+    const char* reason = "unavailable";
+  };
+  SsxReconstruction();
+  ~SsxReconstruction();
+  Result Submit(const D3D12Provider& provider, const std::shared_ptr<const SsxFrameInputs>& frame,
+                ID3D12Resource* destination, D3D12_RESOURCE_STATES destination_state,
+                double seconds);
+
+ private:
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+};
+}  // namespace rex::ui::d3d12
