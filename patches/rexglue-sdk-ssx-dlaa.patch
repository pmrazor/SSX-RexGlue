+bool D3D12CommandProcessor::ReconstructSsxScene(uint64_t vs, uint64_t ps,
+    const draw_util::ViewportInfo& viewport, bool& restarted) {
+  using namespace ui::d3d12;
+  restarted = false;
+  if (!REXCVAR_GET(d3d12_ssx_dlaa) || ssx_reconstruction_failed_ || !ssx_inputs_ ||
+      ssx_inputs_->metadata.guest_frame != frame_current_ ||
+      ssx_reconstruction_frame_ == frame_current_) return true;
+  const auto& f = ssx_inputs_->metadata;
+  if (!f.scale_x || !f.scale_y ||
+      IdentifySsxPass(ssx_title_id_,vs,ps,viewport.xy_extent[0]/f.scale_x,
+                      viewport.xy_extent[1]/f.scale_y) != SsxPass::kToneMap) return true;
+  ssx_reconstruction_frame_ = frame_current_;
+  auto* sr = GetD3D12Provider().GetStreamline();
+  if (!sr || !sr->support().sr || render_target_cache_->GetPath() != RenderTargetCache::Path::kPixelShaderInterlock ||
+      !f.jitter_enabled || f.scene_msaa_samples != 1) {
+    REXGPU_WARN("SSX_DLAA fallback frame={} reason=prerequisites scene_samples={} jitter={}",
+                frame_current_,f.scene_msaa_samples,f.jitter_enabled);
+    ssx_reconstruction_failed_ = true;
+    return true;
+  }
+  const auto alignment = CheckSsxTemporalAlignment(*ssx_inputs_);
+  if (alignment != SsxAlignmentStatus::kCompatible) {
+    // Menu/loading packets may have no world camera or early scene depth.
+    // They don't consume a DLSS frame; the next complete packet resets history.
+    if (!ssx_reconstruction_log_frame_ || frame_current_-ssx_reconstruction_log_frame_ >= 120) {
+      ssx_reconstruction_log_frame_ = frame_current_;
+      REXGPU_WARN("SSX_DLAA skipped frame={} reason={}",frame_current_,SsxAlignmentName(alignment));
+    }
+    if (alignment == SsxAlignmentStatus::kJitterCoverage ||
+        alignment == SsxAlignmentStatus::kDepthView || alignment == SsxAlignmentStatus::kExtent)
+      ssx_reconstruction_failed_ = true;
+    return true;
+  }
+  D3D12TextureCache::ActiveTextureSnapshotSource source;
+  if (!texture_cache_->GetActiveTextureSnapshotSource(0,source)) return true;
+  auto frozen = std::make_shared<SsxFrameInputs>(*ssx_inputs_);
+  frozen->producer_owner = ssx_inputs_;
+  frozen->metadata.output_width = frozen->textures[0].width;
+  frozen->metadata.output_height = frozen->textures[0].height;
+  if (!EndSubmission(false)) return false;
+  // The previous submission includes all scene draws, resolves and input copies.
+  // Separate lists isolate DLSS/native-motion binding changes from guest draws.
+  if (!ssx_reconstruction_) ssx_reconstruction_ = std::make_unique<SsxReconstruction>();
+  const double seconds = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+  const auto result = ssx_reconstruction_->Submit(GetD3D12Provider(),frozen,source.resource,source.state,seconds);
+  if (result.submitted) NotifyQueueOperationsDoneDirectly();
+  if (!result.applied) ssx_reconstruction_failed_ = true;
+  if (!result.applied || !ssx_reconstruction_log_frame_ || frame_current_-ssx_reconstruction_log_frame_ >= 120) {
+    ssx_reconstruction_log_frame_ = frame_current_;
+    REXGPU_INFO("SSX_DLAA frame={} scene={}x{} scene_samples={} applied={} reset={} reason={} insertion=before_tone_map",
+                frame_current_,frozen->textures[0].width,frozen->textures[0].height,
+                f.scene_msaa_samples,result.applied,result.reset,result.reason);
+  }
+  restarted = true;
+  return BeginSubmission(true);
+}
