diff --git a/tests/unit/graphics/ssx_motion_test.cpp b/tests/unit/graphics/ssx_motion_test.cpp
index 606c6ca..288dfd7 100644
--- a/tests/unit/graphics/ssx_motion_test.cpp
+++ b/tests/unit/graphics/ssx_motion_test.cpp
@@ -2,8 +2,66 @@
 #include <catch2/catch_approx.hpp>
 #include <limits>
 #include <rex/ui/d3d12/ssx_camera_motion.h>
+#include <rex/ui/d3d12/ssx_reconstruction.h>
 
 using namespace rex::ui::d3d12;
+
+TEST_CASE("SSX DLSS camera decomposition preserves reversed depth and world position", "[ssx-motion]") {
+  SsxFrameMetadata f;
+  f.camera_samples=1; f.camera_viewport_valid=true; f.guest_viewport_z={-1,1};
+  const float a=8000.f/(8000.f-.5f), b=-.5f*a;
+  f.world_to_clip_candidate={1.5f,0,0,0, 0,8.f/3,0,0, 0,0,-a,-1, -75,-1600.f/3,1000*a+b,1000};
+  SsxMotionPlan p; p.usable=true; p.constants.reset=1;
+  Streamline::SRCamera c;
+  REQUIRE(BuildSsxSRCamera(f,p,c));
+  CHECK(c.position[0]==Catch::Approx(50).margin(.001));
+  CHECK(c.position[1]==Catch::Approx(200).margin(.001));
+  CHECK(c.position[2]==Catch::Approx(1000).margin(.001));
+  CHECK(c.near_plane==Catch::Approx(.5).margin(.001));
+  CHECK(c.far_plane==Catch::Approx(8000).margin(40));
+  for (auto [distance,expected] : {std::pair{c.near_plane,1.f},std::pair{c.far_plane,0.f}}) {
+    const auto& m=c.view_to_clip;
+    CHECK((-distance*m[10]+m[14])/distance==Catch::Approx(expected).margin(.00001));
+  }
+  auto bad=f; bad.world_to_clip_candidate[1]+=.2f;
+  CHECK_FALSE(BuildSsxSRCamera(bad,p,c));
+  bad=f; bad.world_to_clip_candidate[3]+=.1f;
+  CHECK_FALSE(BuildSsxSRCamera(bad,p,c));
+  bad=f; bad.guest_viewport_z={1,0};
+  CHECK_FALSE(BuildSsxSRCamera(bad,p,c));
+  bad=f; bad.camera_conflict=true;
+  CHECK_FALSE(BuildSsxSRCamera(bad,p,c));
+}
+
+TEST_CASE("SSX DLSS history transforms both ends of reversed clip space", "[ssx-motion]") {
+  SsxFrameMetadata f;
+  f.guest_frame=1; f.scene_width=1120; f.scene_height=584; f.scale_x=f.scale_y=3;
+  f.camera_samples=1; f.camera_viewport_valid=true; f.captured_mask=3;
+  f.guest_viewport_xy={560,-292,560,292}; f.guest_viewport_z={-1,1};
+  const float a=8000.f/(8000.f-.5f), b=-.5f*a;
+  f.world_to_clip_candidate={1.5f,0,0,0, 0,8.f/3,0,0, 0,0,-a,-1, -75,-1600.f/3,1000*a+b,1000};
+  const auto previous=f.world_to_clip_candidate;
+  SsxMotionHistory h; h.Advance(f,1);
+  f.guest_frame=2;
+  f.world_to_clip_candidate[12]-=.3f;
+  f.world_to_clip_candidate[14]+=a*.25f;
+  f.world_to_clip_candidate[15]+=.25f;
+  const auto plan=h.Advance(f,1.016);
+  REQUIRE(plan.constants.reset==0);
+  Streamline::SRCamera c;
+  REQUIRE(BuildSsxSRCamera(f,plan,c));
+  auto transform=[](const std::array<double,4>& v,const std::array<float,16>& m) {
+    std::array<double,4> out{};
+    for(unsigned i=0;i<4;++i) for(unsigned j=0;j<4;++j) out[i]+=v[j]*m[j*4+i];
+    return out;
+  };
+  const std::array<double,4> point{55,210,800,1};
+  auto current=transform(point,f.world_to_clip_candidate), target=transform(point,previous);
+  current[2]=current[3]-current[2]; target[2]=target[3]-target[2];
+  const auto actual=transform(current,c.clip_to_previous);
+  for(unsigned i=0;i<3;++i)
+    CHECK(actual[i]/actual[3]==Catch::Approx(target[i]/target[3]).margin(.00001));
+}
