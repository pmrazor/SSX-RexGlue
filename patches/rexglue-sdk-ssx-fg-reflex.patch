+  bool created = false;
+  if (!snapshot.Prepare(GetD3D12Provider().GetDevice(), desc.Format, uint32_t(desc.Width),
+                        desc.Height, created))
+    return;
+  snapshot.resource->SetName(L"SSX post-effects pre-HUD candidate");
+  snapshot.view_format = DXGI_FORMAT_R8G8B8A8_UNORM;
+  snapshot.source_mip = 0;
+  snapshot.guest_address = source.guest_address;
+  snapshot.host_swizzle = source.host_swizzle;
+  snapshot.swizzled_signs = source.swizzled_signs;
+  snapshot.guest_fetch = source.guest_fetch;
