+bool Streamline::GetReflexState(ReflexState& state) {
+  state = {};
+#if REX_HAS_STREAMLINE
+  if (!impl_->attached || !impl_->reflex_state)
+    return false;
+  sl::ReflexState value{};
+  if (!Check(impl_->reflex_state(value), "Reflex latency reports"))
+    return false;
+  state.low_latency_available = value.lowLatencyAvailable;
+  state.reports_available = value.latencyReportAvailable;
+  state.flash_driver_controlled = value.flashIndicatorDriverControlled;
+  if (!state.reports_available)
+    return true;
+  for (size_t i = 0; i < state.reports.size(); ++i) {
+    const auto& s = value.frameReport[i];
+    auto& d = state.reports[i];
+    d.frame_id = s.frameID;
+    d.simulation_start_us = s.simStartTime;
+    d.simulation_end_us = s.simEndTime;
+    d.render_start_us = s.renderSubmitStartTime;
+    d.render_end_us = s.renderSubmitEndTime;
+    d.present_start_us = s.presentStartTime;
+    d.present_end_us = s.presentEndTime;
+    d.driver_start_us = s.driverStartTime;
+    d.driver_end_us = s.driverEndTime;
+    d.queue_start_us = s.osRenderQueueStartTime;
+    d.queue_end_us = s.osRenderQueueEndTime;
+    d.gpu_start_us = s.gpuRenderStartTime;
+    d.gpu_end_us = s.gpuRenderEndTime;
+    d.gpu_active_us = s.gpuActiveRenderTimeUs;
+    d.gpu_frame_us = s.gpuFrameTimeUs;
+  }
+  return true;
+#else
+  return false;
+#endif
+}
