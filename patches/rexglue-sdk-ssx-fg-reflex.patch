diff --git a/include/rex/ui/guest_frame_timing.h b/include/rex/ui/guest_frame_timing.h
new file mode 100644
index 0000000..7fb5473
--- /dev/null
+++ b/include/rex/ui/guest_frame_timing.h
@@ -0,0 +1,74 @@
+// Bounded CPU timing diagnostics. These events are NOT NVIDIA Reflex markers.
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <filesystem>
+#include <mutex>
+#include <vector>
+
+namespace rex::ui {
+
+class GuestFrameTiming {
+ public:
+  enum class Event : uint32_t {
+    kInputBegin,
+    kInputEnd,
+    kWorkerDispatchBegin,
+    kWorkerDispatchEnd,
+    kWorkerBegin,
+    kWorkerEnd,
+    kRenderDispatchBegin,
+    kRenderDispatchEnd,
+    kRenderBegin,
+    kRenderEnd,
+    kSynchronizedRenderBegin,
+    kSynchronizedRenderEnd,
+    kGuestSwap,
+    kCommandProcessorSwap,
+    kReconstructionBegin,
+    kReconstructionEnd,
+    kHostSubmit,
+    kPresentBegin,
+    kPresentEnd
+  };
+  struct Record {
+    uint64_t time_ns, id, related, detail;
+    uint32_t thread;
+    Event event;
+  };
+  static constexpr size_t kMaxRecords = 32768;
+  static GuestFrameTiming& Get();
+  // Single control thread, normally SSX's independent input polling thread.
+  // A capture.request file starts a five-second capture. No per-frame disk IO
+  // on the renderer; this thread writes the bounded buffer on completion.
+  void PollCapture(const std::filesystem::path& directory);
+  void BeginCapture(uint64_t duration_ns = 5000000000ull);
+  std::vector<Record> FinishCapture();
+  bool capturing() const { return capturing_.load(std::memory_order_relaxed); }
+  uint64_t NewId() { return next_id_.fetch_add(1, std::memory_order_relaxed); }
+  void Add(Event event, uint64_t id, uint64_t related = 0, uint64_t detail = 0);
+  // TLS scope identity is carried in the actual VdSwap packet. A global
+  // "latest render" value would silently attribute cross-thread work wrongly.
+  static uint64_t CurrentRender();
+  static uint64_t ExchangeRender(uint64_t id);
+
+ private:
+  std::atomic<bool> capturing_{false};
+  std::atomic<uint64_t> next_id_{1};
+  std::mutex mutex_;
+  std::vector<Record> records_;
+  uint64_t deadline_ns_ = 0;
+  // PollCapture control-thread-only fields.
+  uint64_t next_poll_ns_ = 0;
+  bool writing_capture_ = false;
+};
+
+// The private extension of PM4_XE_SWAP is explicitly versioned. Old four-word
+// swap packets retain their existing meaning. No guest addresses are replaced.
+constexpr uint32_t kGuestTimingSwapSignature = 0x52465431;  // RFT1
+inline uint64_t DecodeGuestTimingSwap(uint32_t signature, uint32_t lo, uint32_t hi) {
+  return signature == kGuestTimingSwapSignature ? uint64_t(lo) | (uint64_t(hi) << 32) : 0;
+}
+
+}  // namespace rex::ui
