+bool Streamline::SetFrameGenerationLoaded(bool loaded) {
+#if REX_HAS_STREAMLINE
+  if (!impl_->attached || !support_.fg)
+    return false;
+  if (loaded == impl_->fg_loaded)
+    return true;
+  if (!loaded && !SetFrameGenerationActive(false))
+    return false;
+  if (!Check(impl_->feature_loaded(sl::kFeatureDLSS_G, loaded), "FG load/unload"))
+    return false;
+  impl_->fg_loaded = loaded;
+  impl_->fg_reset = true;
+  if (loaded &&
+      (!impl_->ImportFeature(impl_->fg_options, sl::kFeatureDLSS_G, "slDLSSGSetOptions") ||
+       !impl_->ImportFeature(impl_->fg_state, sl::kFeatureDLSS_G, "slDLSSGGetState")))
+    return false;
+  return true;
+#else
+  (void)loaded;
+  return false;
+#endif
+}
+
+bool Streamline::SetFrameGenerationActive(bool active) {
+#if REX_HAS_STREAMLINE
+  if (!impl_->attached || !support_.fg ||
+      (active && (!impl_->fg_loaded || !impl_->reflex_configured ||
+                  impl_->reflex_mode == ReflexMode::kOff || !support_.low_latency_available)))
+    return false;
+  if (!impl_->fg_loaded)
+    return !active;
+  if (active == impl_->fg_active)
+    return true;
+  sl::DLSSGOptions options{};
+  options.mode = active ? sl::DLSSGMode::eOn : sl::DLSSGMode::eOff;
+  options.numFramesToGenerate = 1;
+  options.flags = sl::DLSSGFlags::eRetainResourcesWhenOff;
+  if (!Check(impl_->fg_options(sl::ViewportHandle(0), options), "FG activation"))
+    return false;
+  impl_->fg_reset |= active != impl_->fg_active;
+  impl_->fg_active = active;
+  return true;
+#else
+  (void)active;
+  return false;
+#endif
+}
+
+bool Streamline::ClearFrameGenerationTags(ID3D12GraphicsCommandList* list,
+                                          const std::shared_ptr<Frame>& frame) {
+#if REX_HAS_STREAMLINE
+  impl_->fg_reset = true;
+  if (!impl_->attached || !list || !frame || frame->owner != this || frame->phase != 3 ||
+      !frame->token || uint32_t(*frame->token) != frame->token_id)
+    return false;
+  sl::ResourceTag tags[] = {
+      {nullptr, sl::kBufferTypeDepth, sl::eValidUntilPresent},
+      {nullptr, sl::kBufferTypeMotionVectors, sl::eValidUntilPresent},
+      {nullptr, sl::kBufferTypeHUDLessColor, sl::eValidUntilPresent},
+      {nullptr, sl::kBufferTypeUIAlpha, sl::eValidUntilPresent},
+      {nullptr, sl::kBufferTypeUIColorAndAlpha, sl::eValidUntilPresent},
+      {nullptr, sl::kBufferTypeBackbuffer, sl::eValidUntilPresent},
+      {nullptr, sl::kBufferTypeBidirectionalDistortionField, sl::eValidUntilPresent}};
+  const bool ok = Check(
+      impl_->tag_frame(*frame->token, sl::ViewportHandle(0), tags, uint32_t(std::size(tags)), list),
+      "FG clear tags");
+  frame->fg_tagged = ok;
+  return ok;
+#else
+  (void)list;
+  (void)frame;
+  return false;
+#endif
+}
+
+bool Streamline::TagFrameGeneration(ID3D12GraphicsCommandList* list,
+                                    const std::shared_ptr<Frame>& timeline, const FGFrame& frame,
+                                    uint32_t backbuffer_width, uint32_t backbuffer_height) {
+#if REX_HAS_STREAMLINE
+  // A rejected frame clears the old tags and resets history. The caller suspends
+  // FG before presenting that frame; rejection is never a successful dispatch.
+  const bool pending_reset = impl_->fg_reset;
+  if (!ClearFrameGenerationTags(list, timeline) || !impl_->fg_active || !frame.depth ||
+      !frame.motion || !frame.hudless || !ValidCamera(frame.camera, frame.jitter_pixels))
+    return false;
+  const auto depth = frame.depth->GetDesc(), motion = frame.motion->GetDesc();
+  const auto color = frame.hudless->GetDesc();
+  auto texture = [](const D3D12_RESOURCE_DESC& d) {
+    return d.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D && d.Width && d.Height &&
+           d.DepthOrArraySize == 1 && d.MipLevels == 1 && d.SampleDesc.Count == 1 &&
+           !(d.Flags & D3D12_RESOURCE_FLAG_DENY_SHADER_RESOURCE);
+  };
+  if (!texture(depth) || !texture(motion) || !texture(color) ||
+      depth.Format != DXGI_FORMAT_R32_FLOAT ||
+      (motion.Format != DXGI_FORMAT_R16G16_FLOAT && motion.Format != DXGI_FORMAT_R32G32_FLOAT) ||
+      (color.Format != DXGI_FORMAT_R8G8B8A8_UNORM && color.Format != DXGI_FORMAT_B8G8R8A8_UNORM) ||
+      depth.Width != motion.Width || depth.Height != motion.Height ||
+      color.Width != backbuffer_width || color.Height != backbuffer_height ||
+      frame.depth == frame.motion || frame.hudless == frame.motion || frame.hudless == frame.depth)
+    return false;
+  if (frame.ui_alpha) {
+    const auto ui = frame.ui_alpha->GetDesc();
+    if (!texture(ui) || ui.Width != color.Width || ui.Height != color.Height ||
+        (ui.Format != DXGI_FORMAT_R8_UNORM && ui.Format != DXGI_FORMAT_R16_FLOAT &&
+         ui.Format != DXGI_FORMAT_R32_FLOAT))
+      return false;
+  }
+  auto& t = *timeline;
+  const auto& c = frame.camera;
+  if (t.sr_evaluated) {
+    const auto& s = t.camera;
+    if (t.width != depth.Width || t.height != depth.Height || t.jitter != frame.jitter_pixels ||
+        t.depth_inverted != frame.depth_inverted || ((frame.reset || pending_reset) && !t.reset) ||
+        s.view_to_clip != c.view_to_clip || s.clip_to_view != c.clip_to_view ||
+        s.clip_to_previous != c.clip_to_previous || s.previous_to_clip != c.previous_to_clip ||
+        s.position != c.position || s.up != c.up || s.right != c.right || s.forward != c.forward ||
+        s.near_plane != c.near_plane || s.far_plane != c.far_plane ||
+        s.vertical_fov != c.vertical_fov || s.aspect != c.aspect)
+      return false;
+  } else {
+    const auto constants =
+        FrameConstants(c, frame.jitter_pixels, uint32_t(depth.Width), depth.Height,
+                       frame.depth_inverted, frame.reset || pending_reset);
+    if (!Check(impl_->constants(constants, *t.token, sl::ViewportHandle(0)), "FG constants"))
+      return false;
+  }
+  const auto color_state =
+      D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+  sl::Resource resources[] = {
+      {sl::ResourceType::eTex2d, frame.depth, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE},
+      {sl::ResourceType::eTex2d, frame.motion, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE},
+      {sl::ResourceType::eTex2d, frame.hudless, color_state},
+      {sl::ResourceType::eTex2d, frame.ui_alpha, color_state}};
+  const sl::Extent input{0, 0, uint32_t(depth.Width), depth.Height};
+  const sl::Extent output{0, 0, backbuffer_width, backbuffer_height};
+  sl::ResourceTag tags[] = {
+      {&resources[0], sl::kBufferTypeDepth, sl::eValidUntilPresent, &input},
+      {&resources[1], sl::kBufferTypeMotionVectors, sl::eValidUntilPresent, &input},
+      {&resources[2], sl::kBufferTypeHUDLessColor, sl::eValidUntilPresent, &output},
+      {nullptr, sl::kBufferTypeBackbuffer, sl::eValidUntilPresent, &output},
+      {frame.ui_alpha ? &resources[3] : nullptr, sl::kBufferTypeUIAlpha, sl::eValidUntilPresent,
+       &output}};
+  if (!Check(
+          impl_->tag_frame(*t.token, sl::ViewportHandle(0), tags, uint32_t(std::size(tags)), list),
+          "FG tags"))
+    return false;
+  impl_->fg_reset = false;
+  return true;
+#else
+  (void)list;
+  (void)timeline;
+  (void)frame;
+  (void)backbuffer_width;
+  (void)backbuffer_height;
+  return false;
+#endif
+}
+
+bool Streamline::GetFrameGenerationState(FGState& state) {
+  state = {};
+#if REX_HAS_STREAMLINE
+  if (!impl_->attached || !support_.fg || !impl_->fg_loaded)
+    return false;
+  sl::DLSSGState value{};
+  if (!Check(impl_->fg_state(sl::ViewportHandle(0), value, nullptr), "FG present state"))
+    return false;
+  state.status = uint32_t(value.status);
+  state.frames_presented = value.numFramesActuallyPresented;
+  state.minimum_dimension = value.minWidthOrHeight;
+  state.max_generated_frames = value.numFramesToGenerateMax;
+  state.inputs_fence = static_cast<ID3D12Fence*>(value.inputsProcessingCompletionFence);
+  state.inputs_fence_value = value.lastPresentInputsProcessingCompletionFenceValue;
+  return true;
+#else
+  return false;
+#endif
+}
