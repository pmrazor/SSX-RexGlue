--- /dev/null
+++ b/src/ui/d3d12/ssx_fg_color.cpp
@@ -0,0 +1,166 @@
+#include <rex/ui/d3d12/ssx_fg_color.h>
+#include <rex/ui/d3d12/d3d12_provider.h>
+#include <rex/ui/d3d12/d3d12_util.h>
+#include <cstring>
+#include <algorithm>
+
+namespace rex::ui::d3d12 {
+namespace {
+#include "ui/shaders/bytecode/d3d12_5_1/ssx_fg_color_cs.h"
+using Microsoft::WRL::ComPtr;
+struct Constants {
+  uint32_t width, height, reserved[2];
+  std::array<uint32_t, 256> gamma;
+};
+void Transition(ID3D12GraphicsCommandList* list, ID3D12Resource* resource,
+                D3D12_RESOURCE_STATES before, D3D12_RESOURCE_STATES after) {
+  D3D12_RESOURCE_BARRIER b{};
+  b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  b.Transition = {resource, D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES, before, after};
+  list->ResourceBarrier(1, &b);
+}
+}  // namespace
+bool CanBuildSsxFGColor(const SsxFrameInputs& input, uint32_t width, uint32_t height) {
+  const auto& m = input.metadata;
+  const auto& t = input.fg_hudless;
+  // Deliberately limited to the measured DLAA full-screen composition. Window
+  // scaling, PWL ramps and arbitrary/cropped guest UVs need their own validation.
+  if (!m.fg_hudless_captured || m.fg_hudless_failed || m.fg_hudless_duplicate || m.fg_gamma_pwl ||
+      !m.depth_before_lighting || !m.camera_samples || m.camera_conflict || m.scale_x != 3 ||
+      m.scale_y != 3 || !IsKnownSsxScene(m.scene_width, m.scene_height) || width != 3840 ||
+      height != 2160 || m.output_width != width || m.output_height != height ||
+      t.width != m.scene_width * 3 || t.height != m.scene_height * 3 ||
+      t.view_format != DXGI_FORMAT_R8G8B8A8_UNORM || t.host_swizzle != 0x60A || t.swizzled_signs ||
+      !t.resource)
+    return false;
+  const auto d = t.resource->GetDesc();
+  return d.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D && d.MipLevels == 1 &&
+         d.DepthOrArraySize == 1 && d.SampleDesc.Count == 1 &&
+         d.Format == DXGI_FORMAT_R8G8B8A8_TYPELESS && d.Width == t.width && d.Height == t.height;
+}
+
+struct SsxFGColor::Impl {
+  struct Slot {
+    std::shared_ptr<SsxFGColorFrame> output = std::make_shared<SsxFGColorFrame>();
+    ComPtr<ID3D12DescriptorHeap> heap;
+    ComPtr<ID3D12Resource> constants;
+  };
+  std::array<Slot, 6> slots;
+  ComPtr<ID3D12RootSignature> root;
+  ComPtr<ID3D12PipelineState> pipeline;
+  bool Initialize(const D3D12Provider& provider) {
+    if (pipeline)
+      return true;
+    D3D12_DESCRIPTOR_RANGE ranges[] = {{D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 1, 0, 0, 0},
+                                       {D3D12_DESCRIPTOR_RANGE_TYPE_UAV, 1, 0, 0, 1}};
+    D3D12_ROOT_PARAMETER params[2]{};
+    params[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+    params[0].Descriptor = {0, 0};
+    params[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    params[1].DescriptorTable = {2, ranges};
+    D3D12_STATIC_SAMPLER_DESC sampler{};
+    sampler.Filter = D3D12_FILTER_MIN_MAG_LINEAR_MIP_POINT;
+    sampler.AddressU = sampler.AddressV = sampler.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    sampler.MaxLOD = D3D12_FLOAT32_MAX;
+    sampler.ComparisonFunc = D3D12_COMPARISON_FUNC_ALWAYS;
+    D3D12_ROOT_SIGNATURE_DESC desc{};
+    desc.NumParameters = 2;
+    desc.pParameters = params;
+    desc.NumStaticSamplers = 1;
+    desc.pStaticSamplers = &sampler;
+    root.Attach(util::CreateRootSignature(provider, desc));
+    if (!root)
+      return false;
+    pipeline.Attach(util::CreateComputePipeline(provider.GetDevice(), ssx_fg_color_cs,
+                                                sizeof(ssx_fg_color_cs), root.Get()));
+    return bool(pipeline);
+  }
+  bool Prepare(ID3D12Device* device, Slot& slot, uint32_t width, uint32_t height) {
+    if (slot.output->color && slot.heap && slot.constants)
+      return true;
+    D3D12_DESCRIPTOR_HEAP_DESC heap{};
+    heap.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+    heap.NumDescriptors = 2;
+    heap.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+    if (!slot.heap && FAILED(device->CreateDescriptorHeap(&heap, IID_PPV_ARGS(&slot.heap))))
+      return false;
+    D3D12_RESOURCE_DESC buffer{};
+    util::FillBufferResourceDesc(buffer, (sizeof(Constants) + 255) & ~size_t(255),
+                                 D3D12_RESOURCE_FLAG_NONE);
+    if (!slot.constants &&
+        FAILED(device->CreateCommittedResource(&util::kHeapPropertiesUpload, D3D12_HEAP_FLAG_NONE,
+                                               &buffer, D3D12_RESOURCE_STATE_GENERIC_READ, nullptr,
+                                               IID_PPV_ARGS(&slot.constants))))
+      return false;
+    D3D12_RESOURCE_DESC texture{};
+    texture.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    texture.Width = width;
+    texture.Height = height;
+    texture.DepthOrArraySize = texture.MipLevels = texture.SampleDesc.Count = 1;
+    texture.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    texture.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    if (!slot.output->color &&
+        FAILED(device->CreateCommittedResource(&util::kHeapPropertiesDefault, D3D12_HEAP_FLAG_NONE,
+                                               &texture, GuestInputTexture::kReadState, nullptr,
+                                               IID_PPV_ARGS(&slot.output->color))))
+      return false;
+    slot.output->color->SetName(L"SSX display gamma matched HUDless color");
+    return true;
+  }
+};
+SsxFGColor::SsxFGColor() : impl_(std::make_unique<Impl>()) {}
+SsxFGColor::~SsxFGColor() = default;
+std::shared_ptr<SsxFGColorFrame> SsxFGColor::Record(
+    const D3D12Provider& provider, ID3D12GraphicsCommandList* list,
+    const std::shared_ptr<const SsxFrameInputs>& frame, uint32_t width, uint32_t height,
+    uint64_t submission, uint64_t completed) {
+  if (!list || !frame || !CanBuildSsxFGColor(*frame, width, height) || !impl_->Initialize(provider))
+    return {};
+  auto* device = provider.GetDevice();
+  for (auto& slot : impl_->slots) {
+    auto& out = slot.output;
+    if (out.use_count() != 1 || out->submission > completed ||
+        (out->fg_fence && out->fg_fence->GetCompletedValue() < out->fg_fence_value))
+      continue;
+    if (!impl_->Prepare(device, slot, width, height))
+      return {};
+    Constants k{width, height, {0, 0}, {}};
+    std::copy_n(frame->metadata.fg_gamma_ramp.begin(), 256, k.gamma.begin());
+    void* mapped = nullptr;
+    D3D12_RANGE none{};
+    if (FAILED(slot.constants->Map(0, &none, &mapped)))
+      return {};
+    std::memcpy(mapped, &k, sizeof(k));
+    slot.constants->Unmap(0, nullptr);
+    auto handle = slot.heap->GetCPUDescriptorHandleForHeapStart();
+    D3D12_SHADER_RESOURCE_VIEW_DESC srv{};
+    srv.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    srv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    srv.Texture2D.MipLevels = 1;
+    srv.Shader4ComponentMapping = D3D12_ENCODE_SHADER_4_COMPONENT_MAPPING(2, 1, 0, 3);
+    device->CreateShaderResourceView(frame->fg_hudless.resource.Get(), &srv, handle);
+    handle.ptr += provider.GetViewDescriptorSize();
+    D3D12_UNORDERED_ACCESS_VIEW_DESC uav{};
+    uav.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    uav.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+    device->CreateUnorderedAccessView(out->color.Get(), nullptr, &uav, handle);
+    Transition(list, out->color.Get(), GuestInputTexture::kReadState,
+               D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    auto* heap = slot.heap.Get();
+    list->SetDescriptorHeaps(1, &heap);
+    list->SetComputeRootSignature(impl_->root.Get());
+    list->SetPipelineState(impl_->pipeline.Get());
+    list->SetComputeRootConstantBufferView(0, slot.constants->GetGPUVirtualAddress());
+    list->SetComputeRootDescriptorTable(1, heap->GetGPUDescriptorHandleForHeapStart());
+    list->Dispatch((width + 7) / 8, (height + 7) / 8, 1);
+    Transition(list, out->color.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+               GuestInputTexture::kReadState);
+    out->input = frame;
+    out->submission = submission;
+    out->fg_fence.Reset();
+    out->fg_fence_value = 0;
+    return out;
+  }
+  return {};
+}
+}  // namespace rex::ui::d3d12
