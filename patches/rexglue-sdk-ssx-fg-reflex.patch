+bool Streamline::ConfigureReflex(ReflexMode mode, uint32_t frame_limit_us) {
+#if REX_HAS_STREAMLINE
+  if (!impl_->attached || !support_.reflex || !support_.pcl ||
+      (mode == ReflexMode::kOff && impl_->fg_active))
+    return false;
+  sl::ReflexOptions options{};
+  switch (mode) {
+    case ReflexMode::kOff:
+      options.mode = sl::ReflexMode::eOff;
+      break;
+    case ReflexMode::kOn:
+      options.mode = sl::ReflexMode::eLowLatency;
+      break;
+    case ReflexMode::kOnWithBoost:
+      options.mode = sl::ReflexMode::eLowLatencyWithBoost;
+      break;
+    default:
+      return false;
+  }
+  options.frameLimitUs = frame_limit_us;
+  sl::PCLOptions pcl{};
+  pcl.idThread = GetCurrentThreadId();
+  sl::PCLState state{};
+  if (!Check(impl_->pcl_options(pcl), "PCL options") ||
+      !Check(impl_->pcl_state(state), "PCL state") ||
+      !Check(impl_->reflex_options(options), "Reflex options"))
+    return false;
+  impl_->ping_message = state.statsWindowMessage;
+  impl_->reflex_mode = mode;
+  impl_->reflex_configured = true;
+  return true;
+#else
+  (void)mode;
+  (void)frame_limit_us;
+  return false;
+#endif
+}
