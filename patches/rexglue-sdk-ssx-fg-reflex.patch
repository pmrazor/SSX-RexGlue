+std::shared_ptr<Streamline::Frame> Streamline::BeginFrame() {
+#if REX_HAS_STREAMLINE
+  if (!impl_->attached || !impl_->reflex_configured)
+    return nullptr;
+  auto frame = std::make_shared<Frame>();
+  if (!Check(impl_->frame_token(frame->token, nullptr), "frame token") || !frame->token ||
+      !Check(impl_->reflex_sleep(*frame->token), "Reflex sleep") ||
+      !Check(impl_->pcl_marker(sl::PCLMarker::eSimulationStart, *frame->token), "simulation start"))
+    return nullptr;
+  frame->owner = this;
+  frame->token_id = uint32_t(*frame->token);
+  frame->phase = 1;
+  return frame;
+#else
+  return nullptr;
+#endif
+}
+
+bool Streamline::MarkFrame(const std::shared_ptr<Frame>& frame, Marker marker) {
+#if REX_HAS_STREAMLINE
+  if (!impl_->attached || !frame || frame->owner != this || !frame->token ||
+      uint32_t(*frame->token) != frame->token_id)
+    return false;
+  sl::PCLMarker pcl;
+  unsigned expected = 0;
+  switch (marker) {
+    case Marker::kSimulationEnd:
+      pcl = sl::PCLMarker::eSimulationEnd;
+      expected = 1;
+      break;
+    case Marker::kRenderSubmitStart:
+      pcl = sl::PCLMarker::eRenderSubmitStart;
+      expected = 2;
+      break;
+    case Marker::kRenderSubmitEnd:
+      pcl = sl::PCLMarker::eRenderSubmitEnd;
+      expected = 3;
+      break;
+    case Marker::kPresentStart:
+      pcl = sl::PCLMarker::ePresentStart;
+      expected = 4;
+      break;
+    case Marker::kPresentEnd:
+      pcl = sl::PCLMarker::ePresentEnd;
+      expected = 5;
+      break;
+    case Marker::kInputFlash:
+      pcl = sl::PCLMarker::eTriggerFlash;
+      break;
+    case Marker::kLatencyPing:
+      pcl = sl::PCLMarker::ePCLatencyPing;
+      break;
+    default:
+      return false;
+  }
+  if ((expected && frame->phase != expected) || (!expected && frame->phase != 1))
+    return false;
+  // Never present an active FG frame without explicitly tagging or clearing it.
+  if (marker == Marker::kPresentStart && impl_->fg_active && !frame->fg_tagged)
+    return false;
+  if (!Check(impl_->pcl_marker(pcl, *frame->token), "PCL marker"))
+    return false;
+  if (expected)
+    ++frame->phase;
+  return true;
+#else
+  (void)frame;
+  (void)marker;
+  return false;
+#endif
+}
