+#include <rex/ui/d3d12/ssx_fg_capture.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <fstream>
+#include <chrono>
+
+REXCVAR_DEFINE_STRING(d3d12_ssx_fg_capture_path, "", "UI/D3D12",
+                      "Local FG-input diagnostics. Create capture.request here for one paired "
+                      "post-effects source and final guest-image readback. FG stays disabled.")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+
+namespace rex::ui::d3d12 {
+void SsxFGCapture::Complete(uint64_t completed) {
+  if (!readback_ || completed < submission_)
+    return;
+  void* data = nullptr;
+  D3D12_RANGE range{0, size_t(bytes_)};
+  if (SUCCEEDED(readback_->Map(0, &range, &data))) {
+    try {
+      if (!std::filesystem::create_directories(directory_))
+        throw std::runtime_error("capture directory exists");
+      const char* names[] = {"post-effects.bin", "final-guest.bin"};
+      for (size_t i = 0; i < 2; ++i) {
+        std::ofstream file;
+        file.exceptions(std::ios::failbit | std::ios::badbit);
+        file.open(directory_ / names[i], std::ios::binary);
+        const auto& fp = footprints_[i];
+        for (uint32_t y = 0; y < fp.Footprint.Height; ++y)
+          file.write(
+              static_cast<const char*>(data) + fp.Offset + uint64_t(y) * fp.Footprint.RowPitch,
+              uint64_t(fp.Footprint.Width) * 4);
+        file.close();
+      }
+      std::ofstream json;
+      json.exceptions(std::ios::failbit | std::ios::badbit);
+      json.open(directory_ / "metadata.partial");
+      const auto& m = frame_->metadata;
+      const auto& t = frame_->fg_hudless;
+      json << "{\n\"guest_frame\":" << m.guest_frame << ",\n\"source_width\":" << t.width
+           << ",\n\"source_height\":" << t.height << ",\n\"source_format\":\"RGBA8_TYPELESS\","
+           << "\n\"final_width\":" << footprints_[1].Footprint.Width
+           << ",\n\"final_height\":" << footprints_[1].Footprint.Height
+           << ",\n\"final_format\":\"R10G10B10A2_UNORM\",\n\"source_swizzle\":" << t.host_swizzle
+           << ",\n\"source_signs\":" << t.swizzled_signs << ",\n\"source_fetch\":[";
+      for (unsigned i = 0; i < 6; ++i)
+        json << (i ? "," : "") << t.guest_fetch[i];
+      json << "],\n\"candidate_draw\":" << m.fg_hudless_draw
+           << ",\n\"gamma_pwl\":" << (m.fg_gamma_pwl ? "true" : "false") << ",\n\"gamma_ramp\":[";
+      for (unsigned i = 0; i < (m.fg_gamma_pwl ? 384u : 256u); ++i)
+        json << (i ? "," : "") << m.fg_gamma_ramp[i];
+      json << "],\n\"retained_motion\":" << (frame_->fg_temporal ? "true" : "false")
+           << ",\n\"fg_enabled\":false\n}\n";
+      json.close();
+      std::filesystem::rename(directory_ / "metadata.partial", directory_ / "metadata.json");
+      REXGPU_INFO("SSX_FG_CAPTURE saved frame={} path={}", m.guest_frame, directory_.string());
+    } catch (const std::exception& e) {
+      REXGPU_WARN("SSX_FG_CAPTURE write failed: {}", e.what());
+    }
+    D3D12_RANGE empty{};
+    readback_->Unmap(0, &empty);
+  } else
+    REXGPU_WARN("SSX_FG_CAPTURE Map failed");
+  readback_.Reset();
+  final_.Reset();
+  frame_.reset();
+  directory_.clear();
+}
+
+void SsxFGCapture::Record(ID3D12Device* device, ID3D12GraphicsCommandList* list,
+                          const std::shared_ptr<const SsxFrameInputs>& frame,
+                          ID3D12Resource* final_color, uint64_t submission, uint64_t completed) {
+  Complete(completed);
+  if (readback_ || !frame || !final_color || !frame->fg_hudless.resource ||
+      !frame->metadata.fg_hudless_captured || frame->metadata.fg_hudless_failed ||
+      frame->metadata.fg_hudless_duplicate || !frame->metadata.camera_samples ||
+      !frame->metadata.depth_before_lighting)
+    return;
+  const auto path = REXCVAR_GET(d3d12_ssx_fg_capture_path);
+  if (path.empty())
+    return;
+  const auto request = std::filesystem::path(path) / "capture.request";
+  std::error_code ec;
+  if (!std::filesystem::is_regular_file(request, ec))
+    return;
+  ID3D12Resource* sources[] = {frame->fg_hudless.resource.Get(), final_color};
+  if (sources[0]->GetDesc().Format != DXGI_FORMAT_R8G8B8A8_TYPELESS ||
+      sources[1]->GetDesc().Format != DXGI_FORMAT_R10G10B10A2_UNORM)
+    return;
+  bytes_ = 0;
+  for (unsigned i = 0; i < 2; ++i) {
+    const auto desc = sources[i]->GetDesc();
+    if (desc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D || desc.SampleDesc.Count != 1 ||
+        desc.MipLevels != 1 || desc.DepthOrArraySize != 1)
+      return;
+    device->GetCopyableFootprints(&desc, 0, 1, (bytes_ + 511) & ~uint64_t(511), &footprints_[i],
+                                  nullptr, nullptr, nullptr);
+    bytes_ = footprints_[i].Offset + uint64_t(footprints_[i].Footprint.RowPitch) * desc.Height;
+  }
+  D3D12_HEAP_PROPERTIES heap{};
+  heap.Type = D3D12_HEAP_TYPE_READBACK;
+  D3D12_RESOURCE_DESC buffer{};
+  buffer.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+  buffer.Width = bytes_;
+  buffer.Height = buffer.DepthOrArraySize = buffer.MipLevels = buffer.SampleDesc.Count = 1;
+  buffer.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+  if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &buffer,
+                                             D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                             IID_PPV_ARGS(&readback_))))
+    return;
+  for (unsigned i = 0; i < 2; ++i) {
+    D3D12_RESOURCE_BARRIER barrier{};
+    barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier.Transition = {
+        sources[i], D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES,
+        i ? D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE : GuestInputTexture::kReadState,
+        D3D12_RESOURCE_STATE_COPY_SOURCE};
+    list->ResourceBarrier(1, &barrier);
+    D3D12_TEXTURE_COPY_LOCATION from{}, to{};
+    from.pResource = sources[i];
+    from.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    to.pResource = readback_.Get();
+    to.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    to.PlacedFootprint = footprints_[i];
+    list->CopyTextureRegion(&to, 0, 0, 0, &from, nullptr);
+    std::swap(barrier.Transition.StateBefore, barrier.Transition.StateAfter);
+    list->ResourceBarrier(1, &barrier);
+  }
+  frame_ = frame;
+  final_ = final_color;
+  submission_ = submission;
+  const auto unique = std::chrono::steady_clock::now().time_since_epoch().count();
+  directory_ =
+      std::filesystem::path(path) /
+      ("frame-" + std::to_string(frame->metadata.guest_frame) + "-" + std::to_string(unique));
+  std::filesystem::remove(request, ec);
+  REXGPU_INFO("SSX_FG_CAPTURE queued frame={} bytes={}", frame->metadata.guest_frame, bytes_);
+}
