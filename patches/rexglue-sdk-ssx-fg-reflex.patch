diff --git a/src/ui/shaders/ssx_fg_color.cs.hlsl b/src/ui/shaders/ssx_fg_color.cs.hlsl
new file mode 100644
index 0000000..8b5febe
--- /dev/null
+++ b/src/ui/shaders/ssx_fg_color.cs.hlsl
@@ -0,0 +1,22 @@
+// SSX final full-screen copy, guest 8-bit target quantization, then the exact
+// 256-entry display LUT from IssueSwap. Final RGBA8 matches the SDR presenter.
+cbuffer Constants : register(b0) {
+  uint2 output_size;
+  uint2 reserved;
+  uint4 gamma_words[64];
+};
+Texture2D<float4> post_effects : register(t0);
+SamplerState linear_clamp : register(s0);
+RWTexture2D<unorm float4> hudless : register(u0);
+uint Gamma(uint code) { return gamma_words[code >> 2][code & 3]; }
+[numthreads(8, 8, 1)]
+void main(uint3 id : SV_DispatchThreadID) {
+  if (any(id.xy >= output_size)) return;
+  float2 uv = (float2(id.xy) + .5) / float2(output_size);
+  float3 rgb = post_effects.SampleLevel(linear_clamp, uv, 0).rgb;
+  uint3 code = uint3(saturate(rgb) * 255 + .5);
+  float3 display = float3((Gamma(code.r) >> 20) & 1023,
+                         (Gamma(code.g) >> 10) & 1023,
+                         Gamma(code.b) & 1023) / 1023;
+  hudless[id.xy] = float4(display, 1);
+}
