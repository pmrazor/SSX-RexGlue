+void GuestFrameTiming::BeginCapture(uint64_t duration_ns) {
+  std::lock_guard lock(mutex_);
+  records_.clear();
+  records_.reserve(kMaxRecords);
+  deadline_ns_ = Now() + duration_ns;
+  capturing_.store(true, std::memory_order_release);
+}
+std::vector<GuestFrameTiming::Record> GuestFrameTiming::FinishCapture() {
+  std::lock_guard lock(mutex_);
+  capturing_.store(false, std::memory_order_release);
+  return std::exchange(records_, {});
+}
+void GuestFrameTiming::Add(Event event, uint64_t id, uint64_t related, uint64_t detail) {
+  if (!capturing())
+    return;
+  std::lock_guard lock(mutex_);
+  if (!capturing())
+    return;
+  const auto now = Now();
+  if (now >= deadline_ns_ || records_.size() >= kMaxRecords) {
+    capturing_.store(false, std::memory_order_release);
+    return;
+  }
+  // Logical trace thread IDs do not expose OS handles and are stable per thread.
+  static std::atomic<uint32_t> next_thread{1};
+  thread_local const uint32_t thread = next_thread.fetch_add(1);
+  records_.push_back({now, id, related, detail, thread, event});
+}
+void GuestFrameTiming::PollCapture(const std::filesystem::path& directory) {
+  const auto now = Now();
+  if (now < next_poll_ns_)
+    return;
+  next_poll_ns_ = now + 250000000ull;
+  if (writing_capture_) {
+    // Also finish if no renderer events arrive (minimized or during loading).
+    bool finished;
+    {
+      std::lock_guard lock(mutex_);
+      finished = !capturing() || now >= deadline_ns_;
+    }
+    if (!finished)
+      return;
+    const auto records = FinishCapture();
+    writing_capture_ = false;
+    const auto path = directory / ("timing-" + std::to_string(now) + ".csv");
+    std::ofstream out(path);
+    out << "time_ns,thread,event,id,related,detail\n";
+    for (const auto& r : records)
+      out << r.time_ns << ',' << r.thread << ',' << names[size_t(r.event)] << ',' << r.id << ','
+          << r.related << ',' << r.detail << '\n';
+    out.flush();
+    if (out)
+      REXLOG_INFO("SSX_TIMING_CAPTURE records={} file={} reflex_markers=false", records.size(),
+                  path.string());
+    else
+      REXLOG_ERROR("SSX_TIMING_CAPTURE write failed: {}", path.string());
+    return;
+  }
+  std::error_code ec;
+  if (!std::filesystem::remove(directory / "capture.request", ec))
+    return;
+  BeginCapture();
+  writing_capture_ = true;
+}
