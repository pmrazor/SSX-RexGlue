diff --git a/tests/unit/graphics/guest_frame_timing_test.cpp b/tests/unit/graphics/guest_frame_timing_test.cpp
new file mode 100644
index 0000000..1dc9419
--- /dev/null
+++ b/tests/unit/graphics/guest_frame_timing_test.cpp
@@ -0,0 +1,58 @@
+#include <catch2/catch_test_macros.hpp>
+#include <rex/ui/guest_frame_timing.h>
+#include <thread>
+#include <set>
+
+using rex::ui::GuestFrameTiming;
+using Event = GuestFrameTiming::Event;
+
+TEST_CASE("SSX timing keeps concurrent records bounded and uniquely identified", "[ssx-timing]") {
+  GuestFrameTiming trace;
+  trace.BeginCapture(60000000000ull);
+  auto record = [&] {
+    for (unsigned i = 0; i < 20000; ++i)
+      trace.Add(Event::kGuestSwap, trace.NewId());
+  };
+  std::thread a(record), b(record);
+  a.join();
+  b.join();
+  const auto records = trace.FinishCapture();
+  REQUIRE(records.size() == GuestFrameTiming::kMaxRecords);
+  std::set<uint64_t> ids;
+  uint64_t previous = 0;
+  for (const auto& r : records) {
+    CHECK(r.time_ns >= previous);
+    previous = r.time_ns;
+    ids.insert(r.id);
+  }
+  CHECK(ids.size() == records.size());
+  CHECK_FALSE(trace.capturing());
+  trace.Add(Event::kGuestSwap, 1);
+  CHECK(trace.FinishCapture().empty());
+}
+
+TEST_CASE("SSX render scope is thread local and nested scopes restore identity", "[ssx-timing]") {
+  REQUIRE(GuestFrameTiming::ExchangeRender(19) == 0);
+  bool independent = false;
+  std::thread worker([&] {
+    independent = GuestFrameTiming::CurrentRender() == 0;
+    GuestFrameTiming::ExchangeRender(23);
+  });
+  worker.join();
+  CHECK(independent);
+  CHECK(GuestFrameTiming::CurrentRender() == 19);
+  CHECK(GuestFrameTiming::ExchangeRender(27) == 19);
+  CHECK(GuestFrameTiming::ExchangeRender(19) == 27);
+  CHECK(GuestFrameTiming::ExchangeRender(0) == 19);
+}
+
+TEST_CASE("SSX swap timing rejects unversioned payloads and preserves 64-bit IDs", "[ssx-timing]") {
+  using rex::ui::DecodeGuestTimingSwap;
+  CHECK(DecodeGuestTimingSwap(0, 0xFFFFFFFF, 0xFFFFFFFF) == 0);
+  CHECK(DecodeGuestTimingSwap(rex::ui::kGuestTimingSwapSignature, 0x89ABCDEF, 0x12345678) ==
+        0x1234567889ABCDEFull);
+  GuestFrameTiming trace;
+  trace.BeginCapture(0);
+  trace.Add(Event::kGuestSwap, 1);
+  CHECK(trace.FinishCapture().empty());
+}
diff --git a/tests/unit/graphics/ssx_frame_inputs_test.cpp b/tests/unit/graphics/ssx_frame_inputs_test.cpp
index 589c6ff..e844a8c 100644
--- a/tests/unit/graphics/ssx_frame_inputs_test.cpp
+++ b/tests/unit/graphics/ssx_frame_inputs_test.cpp
@@ -3,6 +3,43 @@
 
 using namespace rex::ui::d3d12;
 
+TEST_CASE("SSX FG motion waits for both consumers and its producer fence", "[ssx-inputs]") {
+  SsxFGTemporalPool pool;
+  std::array<std::shared_ptr<const SsxFGTemporal>, SsxFGTemporalPool::kSlotCount> held;
+  for (size_t i = 0; i < held.size(); ++i) {
+    auto frame = pool.Acquire(10 + i, 0);
+    REQUIRE(frame);
+    frame->submission = 100 + i;
+    held[i] = std::move(frame);
+  }
+  CHECK_FALSE(pool.Acquire(20, 200));
+  auto consumer = held[0];
+  held[0].reset();
+  CHECK_FALSE(pool.Acquire(20, 200));
+  auto* original = consumer.get();
+  consumer.reset();
+  CHECK_FALSE(pool.Acquire(20, 99));
+  auto recycled = pool.Acquire(20, 100);
+  REQUIRE(recycled);
+  CHECK(recycled.get() == original);
+  CHECK(recycled->guest_frame == 20);
+  CHECK(held[1]->guest_frame == 11);
+}
+
+TEST_CASE("SSX frame recycling releases old FG motion without a reference cycle", "[ssx-inputs]") {
+  SsxFrameInputPool pool;
+  auto frame = pool.Acquire(1, 0);
+  auto motion = std::make_shared<SsxFGTemporal>();
+  std::weak_ptr<const SsxFGTemporal> weak = motion;
+  frame->fg_temporal = std::move(motion);
+  frame.reset();
+  CHECK_FALSE(weak.expired());
+  auto next = pool.Acquire(2, 0);
+  REQUIRE(next);
+  CHECK_FALSE(next->fg_temporal);
+  CHECK(weak.expired());
+}
+
