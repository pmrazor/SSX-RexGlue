+        continue;
+      REXKRNL_INFO("  thread {:4} {:26} lr={:08X} count={:6} total={:8.1f}ms timeout={}",
+                   k.thread_id, kWaitKindNames[k.kind], k.lr, val.count, val.total_ms,
+                   val.last_timeout == INT64_MIN ? std::string("none")
