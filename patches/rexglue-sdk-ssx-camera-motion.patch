diff --git a/src/ui/d3d12/ssx_camera_motion.cpp b/src/ui/d3d12/ssx_camera_motion.cpp
new file mode 100644
index 0000000..41d636c
--- /dev/null
+++ b/src/ui/d3d12/ssx_camera_motion.cpp
@@ -0,0 +1,261 @@
+#include <rex/ui/d3d12/ssx_camera_motion.h>
+
+#include <algorithm>
+#include <rex/logging.h>
+#include <rex/ui/d3d12/d3d12_provider.h>
+#include <rex/ui/d3d12/d3d12_util.h>
+
+namespace rex::ui::d3d12 {
+namespace {
+#include "ui/shaders/bytecode/d3d12_5_1/ssx_camera_motion_cs.h"
+using Microsoft::WRL::ComPtr;
+void Transition(ID3D12GraphicsCommandList* list, ID3D12Resource* resource,
+                D3D12_RESOURCE_STATES before, D3D12_RESOURCE_STATES after) {
+  D3D12_RESOURCE_BARRIER b{};
+  b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  b.Transition = {resource, D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES, before, after};
+  list->ResourceBarrier(1, &b);
+}
+bool Resource(ID3D12Device* device, const D3D12_RESOURCE_DESC& desc, bool readback,
+              D3D12_RESOURCE_STATES state, ComPtr<ID3D12Resource>& result) {
+  D3D12_HEAP_PROPERTIES heap{};
+  heap.Type = readback ? D3D12_HEAP_TYPE_READBACK : D3D12_HEAP_TYPE_DEFAULT;
+  return SUCCEEDED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc, state,
+                                                   nullptr, IID_PPV_ARGS(&result)));
+}
+}  // namespace
+
+bool SsxCameraMotion::Initialize(const D3D12Provider& provider) {
+  if (pipeline_)
+    return true;
+  if (unavailable_)
+    return false;
+  unavailable_ = true;
+  D3D12_DESCRIPTOR_RANGE ranges[2]{};
+  ranges[0] = {D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 1, 0, 0, 0};
+  ranges[1] = {D3D12_DESCRIPTOR_RANGE_TYPE_UAV, 3, 0, 0, 1};
+  D3D12_ROOT_PARAMETER params[2]{};
+  params[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+  params[0].Constants = {0, 0, sizeof(SsxMotionConstants) / 4};
+  params[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+  params[1].DescriptorTable = {2, ranges};
+  D3D12_ROOT_SIGNATURE_DESC desc{};
+  desc.NumParameters = 2;
+  desc.pParameters = params;
+  root_.Attach(util::CreateRootSignature(provider, desc));
+  if (!root_)
+    return false;
+  pipeline_.Attach(util::CreateComputePipeline(provider.GetDevice(), ssx_camera_motion_cs,
+                                               sizeof(ssx_camera_motion_cs), root_.Get()));
+  if (!pipeline_)
+    return false;
+  pipeline_->SetName(L"SSX camera-only motion (not DLSS-ready)");
+  unavailable_ = false;
+  return true;
+}
+
+bool SsxCameraMotion::Prepare(const D3D12Provider& provider, Slot& slot, uint32_t width,
+                              uint32_t height) {
+  if (slot.vectors && slot.width == width && slot.height == height)
+    return true;
+  Slot replacement;  // Commit only after all allocations succeeded.
+  auto* device = provider.GetDevice();
+  D3D12_RESOURCE_DESC d{};
+  d.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+  d.Width = width;
+  d.Height = height;
+  d.DepthOrArraySize = d.MipLevels = d.SampleDesc.Count = 1;
+  d.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+  d.Format = DXGI_FORMAT_R32G32_FLOAT;
+  if (!Resource(device, d, false, GuestInputTexture::kReadState, replacement.vectors))
+    return false;
+  d.Format = DXGI_FORMAT_R8_UINT;
+  if (!Resource(device, d, false, GuestInputTexture::kReadState, replacement.validity))
+    return false;
+  replacement.sample_count = ((width + 31) / 32) * ((height + 31) / 32);
+  d.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+  d.Width = uint64_t(replacement.sample_count) * 16;
+  d.Height = 1;
+  d.Format = DXGI_FORMAT_UNKNOWN;
+  d.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+  if (!Resource(device, d, false, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, replacement.samples))
+    return false;
+  d.Flags = D3D12_RESOURCE_FLAG_NONE;
+  if (!Resource(device, d, true, D3D12_RESOURCE_STATE_COPY_DEST, replacement.readback))
+    return false;
+  D3D12_DESCRIPTOR_HEAP_DESC heap{};
+  heap.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+  heap.NumDescriptors = 4;
+  heap.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+  if (FAILED(device->CreateDescriptorHeap(&heap, IID_PPV_ARGS(&replacement.heap))))
+    return false;
+  replacement.width = width;
+  replacement.height = height;
+  replacement.vectors->SetName(L"SSX camera-only motion XY pixels");
+  replacement.validity->SetName(L"SSX camera-only reprojection validity (not object coverage)");
+  replacement.samples->SetName(L"SSX motion diagnostic samples");
+  slot = std::move(replacement);
+  return true;
+}
+
+void SsxCameraMotion::ReadDiagnostics(Slot& slot) {
+  if (!slot.readback_pending)
+    return;
+  slot.readback_pending = false;
+  float* values = nullptr;
+  D3D12_RANGE range{0, size_t(slot.sample_count) * 16};
+  if (FAILED(slot.readback->Map(0, &range, reinterpret_cast<void**>(&values))))
+    return;
+  uint32_t valid = 0, moving = 0, nonfinite = 0;
+  float max_motion = 0, min_depth = 1, max_depth = 0;
+  for (uint32_t i = 0; i < slot.sample_count; ++i) {
+    const float* p = values + i * 4;
+    if (!std::isfinite(p[0]) || !std::isfinite(p[1]))
+      ++nonfinite;
+    if (p[3] == 0)
+      continue;
+    ++valid;
+    const float magnitude = std::hypot(p[0], p[1]);
+    if (magnitude > 0.01f)
+      ++moving;
+    max_motion = std::max(max_motion, magnitude);
+    min_depth = std::min(min_depth, p[2]);
+    max_depth = std::max(max_depth, p[2]);
+  }
+  D3D12_RANGE empty{0, 0};
+  slot.readback->Unmap(0, &empty);
+  REXGPU_INFO(
+      "SSX_MOTION_GPU frame={} sampled={} valid={} moving={} nonfinite={} max_pixels={} "
+      "depth_min={} depth_max={} coverage=camera_only dlss_ready=false",
+      slot.diagnostic_frame, slot.sample_count, valid, moving, nonfinite, max_motion, min_depth,
+      max_depth);
+}
+
+SsxCameraMotion::Result SsxCameraMotion::Record(const D3D12Provider& provider,
+                                                ID3D12GraphicsCommandList* list,
+                                                const std::shared_ptr<const SsxFrameInputs>& frame,
+                                                uint64_t submission, uint64_t completed,
+                                                double seconds) {
+  Result result;
+  for (auto& slot : slots_)
+    if (slot.last_submission <= completed) {
+      ReadDiagnostics(slot);
+      slot.input.reset();
+    }
+  if (!frame) {
+    Reset(SsxMotionReset::kMissingInputs);
+    result.plan.reason = SsxMotionReset::kMissingInputs;
+    return result;
+  }
+  const auto& depth = frame->textures[size_t(SsxInput::kResolvedDepth)];
+  const auto& f = frame->metadata;
+  // Raw resolved 20e4 depth expands to R32_FLOAT in the texture cache. Reject
+  // other views; the compute pass does not implement guest fetch conversions.
+  if (!depth.resource || depth.view_format != DXGI_FORMAT_R32_FLOAT ||
+      depth.width != uint64_t(f.scene_width) * f.scale_x ||
+      depth.height != uint64_t(f.scene_height) * f.scale_y || depth.source_mip ||
+      depth.host_swizzle || depth.swizzled_signs || (depth.guest_fetch[3] & (63u << 13))) {
+    Reset(SsxMotionReset::kMissingInputs);
+    result.plan.reason = SsxMotionReset::kMissingInputs;
+    return result;
+  }
+  result.plan = history_.Advance(f, seconds);
+  if (!result.plan.usable) {
+    last_slot_ = -1;
+    return result;
+  }
+  if (result.plan.repeated && last_slot_ >= 0) {
+    auto& slot = slots_[last_slot_];
+    slot.last_submission = submission;
+    result.vectors = slot.vectors.Get();
+    result.validity = slot.validity.Get();
+    return result;
+  }
+  if (!Initialize(provider)) {
+    Reset(SsxMotionReset::kUnavailable);
+    result.plan.usable = false;
+    result.plan.reason = SsxMotionReset::kUnavailable;
+    return result;
+  }
+  int chosen = -1;
+  for (int i = 0; i < int(slots_.size()); ++i)
+    if (slots_[i].last_submission <= completed) {
+      chosen = i;
+      break;
+    }
+  if (chosen < 0) {
+    Reset(SsxMotionReset::kBusy);
+    result.plan.usable = false;
+    result.plan.reason = SsxMotionReset::kBusy;
+    return result;
+  }
+  auto& slot = slots_[chosen];
+  if (!Prepare(provider, slot, depth.width, depth.height)) {
+    Reset(SsxMotionReset::kUnavailable);
+    result.plan.usable = false;
+    result.plan.reason = SsxMotionReset::kUnavailable;
+    return result;
+  }
+  auto* device = provider.GetDevice();
+  auto handle = slot.heap->GetCPUDescriptorHandleForHeapStart();
+  const auto increment =
+      device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+  D3D12_SHADER_RESOURCE_VIEW_DESC srv{};
+  srv.Format = DXGI_FORMAT_R32_FLOAT;
+  srv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+  srv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+  srv.Texture2D.MipLevels = 1;
+  device->CreateShaderResourceView(depth.resource.Get(), &srv, handle);
+  handle.ptr += increment;
+  D3D12_UNORDERED_ACCESS_VIEW_DESC uav{};
+  uav.Format = DXGI_FORMAT_R32G32_FLOAT;
+  uav.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+  device->CreateUnorderedAccessView(slot.vectors.Get(), nullptr, &uav, handle);
+  handle.ptr += increment;
+  uav.Format = DXGI_FORMAT_R8_UINT;
+  device->CreateUnorderedAccessView(slot.validity.Get(), nullptr, &uav, handle);
+  handle.ptr += increment;
+  uav = {};
+  uav.ViewDimension = D3D12_UAV_DIMENSION_BUFFER;
+  uav.Buffer.NumElements = slot.sample_count;
+  uav.Buffer.StructureByteStride = 16;
+  device->CreateUnorderedAccessView(slot.samples.Get(), nullptr, &uav, handle);
+  Transition(list, slot.vectors.Get(), GuestInputTexture::kReadState,
+             D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  Transition(list, slot.validity.Get(), GuestInputTexture::kReadState,
+             D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  // Serialize writes on reuse, including frames where diagnostics weren't copied.
+  D3D12_RESOURCE_BARRIER samples_barrier{};
+  samples_barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_UAV;
+  samples_barrier.UAV.pResource = slot.samples.Get();
+  list->ResourceBarrier(1, &samples_barrier);
+  ID3D12DescriptorHeap* heaps[] = {slot.heap.Get()};
+  list->SetDescriptorHeaps(1, heaps);
+  list->SetPipelineState(pipeline_.Get());
+  list->SetComputeRootSignature(root_.Get());
+  list->SetComputeRoot32BitConstants(0, sizeof(SsxMotionConstants) / 4, &result.plan.constants, 0);
+  list->SetComputeRootDescriptorTable(1, slot.heap->GetGPUDescriptorHandleForHeapStart());
+  list->Dispatch((depth.width + 7) / 8, (depth.height + 7) / 8, 1);
+  Transition(list, slot.vectors.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+             GuestInputTexture::kReadState);
+  Transition(list, slot.validity.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+             GuestInputTexture::kReadState);
+  if (!last_diagnostic_frame_ || f.guest_frame < last_diagnostic_frame_ ||
+      f.guest_frame - last_diagnostic_frame_ >= 120) {
+    Transition(list, slot.samples.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+               D3D12_RESOURCE_STATE_COPY_SOURCE);
+    list->CopyResource(slot.readback.Get(), slot.samples.Get());
+    Transition(list, slot.samples.Get(), D3D12_RESOURCE_STATE_COPY_SOURCE,
+               D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    slot.readback_pending = true;
+    last_diagnostic_frame_ = slot.diagnostic_frame = f.guest_frame;
+  }
+  slot.last_submission = submission;
+  slot.input = frame;
+  last_slot_ = chosen;
+  result.vectors = slot.vectors.Get();
+  result.validity = slot.validity.Get();
+  result.dispatched = true;
+  return result;
+}
+}  // namespace rex::ui::d3d12
