diff --git a/src/ui/shaders/ssx_camera_motion.cs.hlsl b/src/ui/shaders/ssx_camera_motion.cs.hlsl
new file mode 100644
index 0000000..529c022
--- /dev/null
+++ b/src/ui/shaders/ssx_camera_motion.cs.hlsl
@@ -0,0 +1,41 @@
+// Camera-only motion, in scene pixels. No jitter is injected by this checkpoint.
+cbuffer Motion : register(b0) {
+  row_major float4x4 clip_to_previous;
+  float4 pixel_to_clip;
+  float4 previous_clip_to_pixel;
+  float4 depth_to_clip;
+  uint2 extent;
+  uint reset_history;
+  uint reserved;
+};
+Texture2D<float> scene_depth : register(t0);
+RWTexture2D<float2> vectors : register(u0);
+RWTexture2D<uint> validity : register(u1);
+RWStructuredBuffer<float4> diagnostic_samples : register(u2);
+
+[numthreads(8, 8, 1)]
+void main(uint3 id : SV_DispatchThreadID) {
+  if (any(id.xy >= extent)) return;
+  float2 pixel = float2(id.xy) + 0.5;
+  float depth = scene_depth.Load(int3(id.xy, 0));
+  float2 motion = 0;
+  uint valid = 0;
+  if (!reset_history && isfinite(depth) && depth > 0 && depth <= 1) {
+    float4 clip = float4(pixel * pixel_to_clip.xy + pixel_to_clip.zw,
+                        depth * depth_to_clip.x + depth_to_clip.y, 1);
+    float4 previous = mul(clip, clip_to_previous);
+    if (all(isfinite(previous)) && previous.w > 1e-6) {
+      motion = (previous.xy / previous.w) * previous_clip_to_pixel.xy +
+               previous_clip_to_pixel.zw - pixel;
+      valid = all(isfinite(motion));
+      if (!valid) motion = 0;
+    }
+  }
+  vectors[id.xy] = motion;
+  validity[id.xy] = valid;
+  // Sparse diagnostics, no global atomics and no per-frame CPU readback stall.
+  if (((id.x | id.y) & 31) == 0) {
+    uint index = (id.y / 32) * ((extent.x + 31) / 32) + id.x / 32;
+    diagnostic_samples[index] = float4(motion, depth, float(valid));
+  }
+}
