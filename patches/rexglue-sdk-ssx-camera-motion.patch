new file mode 100644
index 0000000..7ed2e73
--- /dev/null
+++ b/src/ui/d3d12/ssx_motion_history.cpp
@@ -0,0 +1,173 @@
+#include <rex/ui/d3d12/ssx_camera_motion.h>
+
+#include <algorithm>
+
+namespace rex::ui::d3d12 {
+namespace {
+using Matrix = std::array<double, 16>;
+bool Inverse(const std::array<float, 16>& source, Matrix& inverse) {
+  double a[4][8]{};
+  for (size_t r = 0; r < 4; ++r) {
+    for (size_t c = 0; c < 4; ++c) {
+      if (!std::isfinite(source[r * 4 + c]))
+        return false;
+      a[r][c] = source[r * 4 + c];
+    }
+    a[r][r + 4] = 1;
+  }
+  for (size_t c = 0; c < 4; ++c) {
+    size_t pivot = c;
+    for (size_t r = c + 1; r < 4; ++r)
+      if (std::abs(a[r][c]) > std::abs(a[pivot][c]))
+        pivot = r;
+    if (std::abs(a[pivot][c]) < 1e-12)
+      return false;
+    for (size_t i = 0; i < 8; ++i)
+      std::swap(a[pivot][i], a[c][i]);
+    const double divisor = a[c][c];
+    for (double& value : a[c])
+      value /= divisor;
+    for (size_t r = 0; r < 4; ++r) {
+      if (r == c)
+        continue;
+      const double factor = a[r][c];
+      for (size_t i = 0; i < 8; ++i)
+        a[r][i] -= factor * a[c][i];
+    }
+  }
+  for (size_t r = 0; r < 4; ++r)
+    for (size_t c = 0; c < 4; ++c) {
+      inverse[r * 4 + c] = a[r][c + 4];
+      if (!std::isfinite(inverse[r * 4 + c]))
+        return false;
+    }
+  return true;
+}
+bool ValidCamera(const SsxFrameMetadata& f, Matrix& inverse) {
+  if (!f.camera_samples || f.camera_conflict || !f.camera_viewport_valid || !f.scene_width ||
+      !f.scene_height || !f.scale_x || !f.scale_y ||
+      uint64_t(f.scene_width) * f.scale_x > D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+      uint64_t(f.scene_height) * f.scale_y > D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION)
+    return false;
+  for (float v : f.guest_viewport_xy)
+    if (!std::isfinite(v))
+      return false;
+  for (float v : f.guest_viewport_z)
+    if (!std::isfinite(v))
+      return false;
+  if (f.guest_viewport_xy[0] == 0 || f.guest_viewport_xy[1] == 0 || f.guest_viewport_z[0] != -1 ||
+      f.guest_viewport_z[1] != 1)
+    return false;  // Only the observed SSX reversed [0,1] depth path is supported.
+  return Inverse(f.world_to_clip_candidate, inverse);
+}
+// Conservative guard, not an SSX camera-cut event hook. Probe distant geometry,
+// not the near plane (near-plane parallax can be very large during normal play).
+bool Discontinuity(const std::array<float, 16>& m) {
+  for (double x : {-0.75, 0.0, 0.75})
+    for (double y : {-0.75, 0.0, 0.75}) {
+      double p[4]{x, y, 0.99, 1}, q[4]{};
+      for (size_t c = 0; c < 4; ++c)
+        for (size_t r = 0; r < 4; ++r)
+          q[c] += p[r] * m[r * 4 + c];
+      if (q[3] <= 1e-6 || std::abs(q[0] / q[3] - x) > 1.5 || std::abs(q[1] / q[3] - y) > 1.5)
+        return true;
+    }
+  return false;
+}
+}  // namespace
+
+const char* SsxMotionResetName(SsxMotionReset reason) {
+  switch (reason) {
+    case SsxMotionReset::kNone:
+      return "none";
+    case SsxMotionReset::kFirstFrame:
+      return "first_frame";
+    case SsxMotionReset::kMissingInputs:
+      return "missing_inputs";
+    case SsxMotionReset::kInvalidCamera:
+      return "invalid_camera";
+    case SsxMotionReset::kResize:
+      return "resize";
+    case SsxMotionReset::kFrameGap:
+      return "frame_gap";
+    case SsxMotionReset::kDiscontinuity:
+      return "camera_discontinuity";
+    case SsxMotionReset::kExplicit:
+      return "explicit";
+    case SsxMotionReset::kBusy:
+      return "pool_busy";
+    case SsxMotionReset::kUnavailable:
+      return "unavailable";
+  }
+  return "unknown";
+}
+void SsxMotionHistory::Reset(SsxMotionReset reason) {
+  have_previous_ = false;
+  pending_reset_ = reason;
+}
+SsxMotionPlan SsxMotionHistory::Advance(const SsxFrameMetadata& f, double seconds) {
+  SsxMotionPlan plan;
+  plan.frame = f.guest_frame;
+  if ((f.captured_mask & 3) != 3 || ((f.failed_mask | f.duplicate_mask) & 3)) {
+    Reset(SsxMotionReset::kMissingInputs);
+    plan.reason = pending_reset_;
+    return plan;
+  }
+  Matrix inverse;
+  if (!std::isfinite(seconds) || !ValidCamera(f, inverse)) {
+    Reset(SsxMotionReset::kInvalidCamera);
+    plan.reason = pending_reset_;
+    return plan;
+  }
+  if (have_previous_ && f.guest_frame == previous_.guest_frame) {
+    plan = last_;
+    plan.repeated = true;
+    return plan;  // UI repaint does not replace the last real frame's velocity.
+  }
+  plan.usable = true;
+  auto& k = plan.constants;
+  k.width = f.scene_width * f.scale_x;
+  k.height = f.scene_height * f.scale_y;
+  k.pixel_to_clip = {1 / (f.scale_x * f.guest_viewport_xy[0]),
+                     1 / (f.scale_y * f.guest_viewport_xy[1]),
+                     -f.guest_viewport_xy[2] / f.guest_viewport_xy[0],
+                     -f.guest_viewport_xy[3] / f.guest_viewport_xy[1]};
+  k.depth_to_clip = {1 / f.guest_viewport_z[0], -f.guest_viewport_z[1] / f.guest_viewport_z[0], 0,
+                     0};
+  plan.reason = have_previous_ ? SsxMotionReset::kNone : pending_reset_;
+  if (have_previous_) {
+    const auto& p = previous_;
+    plan.previous_frame = p.guest_frame;
+    if (p.scene_width != f.scene_width || p.scene_height != f.scene_height ||
+        p.scale_x != f.scale_x || p.scale_y != f.scale_y || p.output_width != f.output_width ||
+        p.output_height != f.output_height)
+      plan.reason = SsxMotionReset::kResize;
+    else if (f.guest_frame < p.guest_frame || f.guest_frame - p.guest_frame > 8 ||
+             seconds < previous_seconds_ || seconds - previous_seconds_ > 0.25)
+      plan.reason = SsxMotionReset::kFrameGap;
+    k.previous_clip_to_pixel = {
+        p.guest_viewport_xy[0] * p.scale_x, p.guest_viewport_xy[1] * p.scale_y,
+        p.guest_viewport_xy[2] * p.scale_x, p.guest_viewport_xy[3] * p.scale_y};
+    for (size_t r = 0; r < 4; ++r)
+      for (size_t c = 0; c < 4; ++c) {
+        double value = 0;
+        for (size_t i = 0; i < 4; ++i)
+          value += inverse[r * 4 + i] * p.world_to_clip_candidate[i * 4 + c];
+        // Identical cameras produce exact identity, including large world offsets.
+        k.clip_to_previous[r * 4 + c] =
+            f.world_to_clip_candidate == p.world_to_clip_candidate ? float(r == c) : float(value);
+        if (!std::isfinite(value))
+          plan.reason = SsxMotionReset::kInvalidCamera;
+      }
+    if (plan.reason == SsxMotionReset::kNone && Discontinuity(k.clip_to_previous))
+      plan.reason = SsxMotionReset::kDiscontinuity;
+  }
+  k.reset = plan.reason != SsxMotionReset::kNone;
+  previous_ = f;
+  previous_seconds_ = seconds;
+  have_previous_ = true;
+  pending_reset_ = SsxMotionReset::kNone;
+  last_ = plan;
+  return plan;
+}
+}  // namespace rex::ui::d3d12
