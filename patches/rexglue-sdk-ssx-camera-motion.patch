@@ -0,0 +1,92 @@
+// Experimental camera reprojection. This is not dense object/animation motion.
+#pragma once
+
+#include <rex/ui/d3d12/guest_frame_inputs.h>
+
+namespace rex::ui::d3d12 {
+class D3D12Provider;
+
+enum class SsxMotionReset {
+  kNone,
+  kFirstFrame,
+  kMissingInputs,
+  kInvalidCamera,
+  kResize,
+  kFrameGap,
+  kDiscontinuity,
+  kExplicit,
+  kBusy,
+  kUnavailable
+};
+const char* SsxMotionResetName(SsxMotionReset reason);
+
+// Matches ssx_camera_motion.cs.hlsl. Row vectors, row-major matrices. Output is
+// previous pixel minus current pixel (+right, +down), at the scene resolution.
+struct SsxMotionConstants {
+  std::array<float, 16> clip_to_previous{};
+  std::array<float, 4> pixel_to_clip{};  // xy scale, xy offset
+  std::array<float, 4> previous_clip_to_pixel{};
+  std::array<float, 4> depth_to_clip{};
+  uint32_t width = 0, height = 0, reset = 1, reserved = 0;
+};
+static_assert(sizeof(SsxMotionConstants) == 128);
+
+struct SsxMotionPlan {
+  SsxMotionConstants constants;
+  uint64_t frame = 0, previous_frame = 0;
+  SsxMotionReset reason = SsxMotionReset::kFirstFrame;
+  bool usable = false, repeated = false;
+};
+
+class SsxMotionHistory {
+ public:
+  SsxMotionPlan Advance(const SsxFrameMetadata& frame, double seconds);
+  void Reset(SsxMotionReset reason = SsxMotionReset::kExplicit);
+
+ private:
+  SsxFrameMetadata previous_{};
+  SsxMotionPlan last_{};
+  double previous_seconds_ = 0;
+  bool have_previous_ = false;
+  SsxMotionReset pending_reset_ = SsxMotionReset::kFirstFrame;
+};
+
+// Single paint-thread owner, using the provider's direct queue. Caller submits
+// every recorded list and drains it before destruction. No waits or game writes.
+class SsxCameraMotion {
+ public:
+  struct Result {
+    ID3D12Resource* vectors = nullptr;   // R32G32_FLOAT, kReadState
+    ID3D12Resource* validity = nullptr;  // R8_UINT: 1 = camera reprojection exists
+    SsxMotionPlan plan;
+    bool dispatched = false;
+  };
+  Result Record(const D3D12Provider& provider, ID3D12GraphicsCommandList* list,
+                const std::shared_ptr<const SsxFrameInputs>& frame, uint64_t submission,
+                uint64_t completed, double seconds);
+  void Reset(SsxMotionReset reason = SsxMotionReset::kExplicit) {
+    history_.Reset(reason);
+    last_slot_ = -1;
+  }
+
+ private:
+  struct Slot {
+    Microsoft::WRL::ComPtr<ID3D12Resource> vectors, validity, samples, readback;
+    Microsoft::WRL::ComPtr<ID3D12DescriptorHeap> heap;
+    std::shared_ptr<const SsxFrameInputs> input;
+    uint64_t last_submission = 0, diagnostic_frame = 0;
+    uint32_t width = 0, height = 0, sample_count = 0;
+    bool readback_pending = false;
+  };
+  bool Initialize(const D3D12Provider& provider);
+  bool Prepare(const D3D12Provider& provider, Slot& slot, uint32_t width, uint32_t height);
+  void ReadDiagnostics(Slot& slot);
+  std::array<Slot, 3> slots_;
+  Microsoft::WRL::ComPtr<ID3D12RootSignature> root_;
+  Microsoft::WRL::ComPtr<ID3D12PipelineState> pipeline_;
+  SsxMotionHistory history_;
+  int last_slot_ = -1;
+  bool unavailable_ = false;
+  uint64_t last_diagnostic_frame_ = 0;
+};
+}  // namespace rex::ui::d3d12
