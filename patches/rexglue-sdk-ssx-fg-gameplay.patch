+TEST_CASE("cvar explicit empty strings preserve later plugin options", "[cvar][ssx-launch]") {
+  rex::cvar::testing::ResetAllForTesting();
+  char argv0[] = "cvar_test";
+  char empty[] = "--test_string_flag=";
+  char plugin[] = "--test_fg_inputs=true";
+  char known[] = "--test_int32_flag=777";
+  char* argv[] = {argv0, empty, plugin, known};
+  const auto positional = rex::cvar::Init(4, argv);
+  CHECK(positional.empty());
+  CHECK(REXCVAR_GET(test_string_flag).empty());
+  CHECK(REXCVAR_GET(test_int32_flag) == 777);
+  std::string value = "false";
+  {
+    rex::cvar::FlagRegistrar registrar({
+        .name = "test_fg_inputs",
+        .type = rex::cvar::FlagType::Boolean,
+        .category = "Test",
+        .description = "Late FG input flag",
+        .setter =
+            [&value](std::string_view input) {
+              value = input;
+              return true;
+            },
+        .getter = [&value]() { return value; },
+        .default_value = "false",
+    });
+    CHECK(value == "true");
+  }
+  rex::cvar::testing::ResetAllForTesting();
+}
