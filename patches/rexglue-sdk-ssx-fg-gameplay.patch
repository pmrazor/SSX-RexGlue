+TEST_CASE("SSX FG scene decisions never leak across renders", "[ssx-timing]") {
+  GuestFrameTiming trace;
+  CHECK_FALSE(trace.FrameGenerationScene(0));
+  CHECK_FALSE(trace.FrameGenerationScene(17));
+  trace.SetFrameGenerationScene(17, true);
+  CHECK(trace.FrameGenerationScene(17));
+  CHECK_FALSE(trace.FrameGenerationScene(18));
+  trace.SetFrameGenerationScene(18, false);
+  CHECK_FALSE(trace.FrameGenerationScene(18));
+  trace.SetFrameGenerationScene(17, false);
+  CHECK_FALSE(trace.FrameGenerationScene(17));
+  trace.SetFrameGenerationScene(17, true);
+  trace.SetFrameGenerationScene(81, true);
+  CHECK_FALSE(trace.FrameGenerationScene(17));
+  CHECK(trace.FrameGenerationScene(81));
+}
