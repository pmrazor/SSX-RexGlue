+void GuestFrameTiming::SetFrameGenerationScene(uint64_t render, bool allowed) {
+  if (!render)
+    return;
+  std::lock_guard lock(mutex_);
+  fg_scenes_[render % fg_scenes_.size()] = {render, allowed};
+}
+bool GuestFrameTiming::FrameGenerationScene(uint64_t render) {
+  std::lock_guard lock(mutex_);
+  const auto& entry = fg_scenes_[render % fg_scenes_.size()];
+  return render && entry.first == render && entry.second;
+}
