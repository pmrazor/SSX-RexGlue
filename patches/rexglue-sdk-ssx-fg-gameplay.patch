@@ -110,6 +110,24 @@ struct SsxFGColor::Impl {
 };
 SsxFGColor::SsxFGColor() : impl_(std::make_unique<Impl>()) {}
 SsxFGColor::~SsxFGColor() = default;
+void SsxFGColor::Collect(uint64_t completed) {
+  for (auto& slot : impl_->slots) {
+    auto& out = slot.output;
+    if (out.use_count() == 1 && !out->consumption_unknown && out->submission <= completed &&
+        (!out->fg_fence || out->fg_fence->GetCompletedValue() >= out->fg_fence_value)) {
+      out->input.reset();
+      out->fg_fence.Reset();
+      out->fg_fence_value = 0;
+    }
+  }
+}
+void SsxFGColor::EnqueueConsumptionWaits(ID3D12CommandQueue* queue) {
+  for (auto& slot : impl_->slots) {
+    const auto& out = slot.output;
+    if (out->fg_fence && out->fg_fence_value)
+      queue->Wait(out->fg_fence.Get(), out->fg_fence_value);
+  }
+}
