diff --git a/include/rex/ui/d3d12/ssx_hdr.h b/include/rex/ui/d3d12/ssx_hdr.h
new file mode 100644
index 0000000..c3b9b51
--- /dev/null
+++ b/include/rex/ui/d3d12/ssx_hdr.h
@@ -0,0 +1,69 @@
+#pragma once
+#include <rex/ui/d3d12/ssx_scene_color.h>
+#include <array>
+#include <algorithm>
+#include <cmath>
+
+namespace rex::ui::d3d12 {
+// Experimental native-scene preview, not the complete SSX post/HUD pipeline.
+// Nits are absolute display luminance. The user's TV may exceed this PC's EDID
+// peak; never silently cap a requested target to the attached monitor's peak.
+struct SsxHDRSettings {
+  float peak_nits = 1000, paper_white_nits = 200, ui_nits = 200, exposure_ev = 0;
+  float highlight_boost = 1;
+  bool Valid() const {
+    return std::isfinite(peak_nits) && peak_nits >= 400 && peak_nits <= 3000 &&
+           std::isfinite(paper_white_nits) && paper_white_nits >= 80 && paper_white_nits <= 500 &&
+           paper_white_nits < peak_nits && std::isfinite(ui_nits) && ui_nits >= 80 &&
+           ui_nits <= 500 && ui_nits <= peak_nits && std::isfinite(exposure_ev) &&
+           exposure_ev >= -5 && exposure_ev <= 5 && std::isfinite(highlight_boost) &&
+           highlight_boost >= 1 && highlight_boost <= 4;
+  }
+};
+// ST.2084 reference for GPU readback tests and calibration values, 0..10000 nits.
+inline double SsxPQEncode(double nits) {
+  if (nits <= 0)
+    return 0;
+  const double y = std::pow(std::clamp(nits / 10000.0, 0.0, 1.0), 2610.0 / 16384.0);
+  return std::pow((3424.0 / 4096.0 + 2413.0 / 128.0 * y) / (1 + 2392.0 / 128.0 * y), 2523.0 / 32.0);
+}
+inline double SsxPQDecode(double code) {
+  const double p = std::pow(std::clamp(code, 0.0, 1.0), 32.0 / 2523.0);
+  return 10000 *
+         std::pow(std::max(p - 3424.0 / 4096.0, 0.0) / (2413.0 / 128.0 - 2392.0 / 128.0 * p),
+                  16384.0 / 2610.0);
+}
+struct SsxHDRConstants {
+  uint32_t width = 0, height = 0, native_scene = 0, exposure_enabled = 0;
+  float peak_nits = 1000, paper_white_nits = 200, ui_nits = 200, exposure_ev = 0;
+  float exposure_scale = 1, exposure_key = 1, log_scale = 0;
+  uint32_t exposure_linear = 0;
+  uint32_t calibration = 0, hdr_output = 1;
+  float highlight_boost = 1;
+  float shadow_slope = 1;
+};
+static_assert(sizeof(SsxHDRConstants) == 64);
+// Validates exact scene identity/format, exposure fetch and sampler contract.
+bool PlanSsxHDR(const SsxFrameInputs& input, SsxHDRConstants& constants);
+SsxHDRSettings GetSsxHDRSettings();
+
+class SsxHDR {
+ public:
+  SsxHDR();
+  ~SsxHDR();
+  // Creates the output before any command recording. Failure must leave the
+  // caller in its regular SDR path; never present SDR codes in a PQ swap chain.
+  bool Prepare(const D3D12Provider& provider, uint32_t slot, uint32_t width, uint32_t height);
+  // output stays COPY_SOURCE. Inputs are restored to their original states.
+  // overlay is a premultiplied SDR UI layer in native mode, or the complete SDR
+  // image in frontend mode. The caller owns/fences the three slot resources.
+  ID3D12Resource* Record(const D3D12Provider& provider, ID3D12GraphicsCommandList* list,
+                         uint32_t slot, ID3D12Resource* overlay,
+                         const std::shared_ptr<const SsxFrameInputs>& frame,
+                         const SsxHDRConstants& constants);
+
+ private:
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+};
+}  // namespace rex::ui::d3d12
