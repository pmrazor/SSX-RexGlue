+namespace rex::ui::d3d12 {
+namespace {
+#include "ui/shaders/bytecode/d3d12_5_1/ssx_hdr_cs.h"
+void Transition(ID3D12GraphicsCommandList* list, ID3D12Resource* r, D3D12_RESOURCE_STATES before,
+                D3D12_RESOURCE_STATES after) {
+  D3D12_RESOURCE_BARRIER b{};
+  b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  b.Transition = {r, D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES, before, after};
+  list->ResourceBarrier(1, &b);
+}
+}  // namespace
+SsxHDRSettings GetSsxHDRSettings() {
+  return {float(REXCVAR_GET(ssx_hdr_peak_nits)), float(REXCVAR_GET(ssx_hdr_paper_white_nits)),
+          float(REXCVAR_GET(ssx_hdr_ui_nits)), float(REXCVAR_GET(ssx_hdr_exposure_ev)),
+          float(REXCVAR_GET(ssx_hdr_highlight_boost))};
+}
+bool PlanSsxHDR(const SsxFrameInputs& input, SsxHDRConstants& k) {
+  k.native_scene = 0;
+  SsxColorConstants decode;
+  const auto& retained = input.fg_temporal;
+  if (!retained || !retained->hdr_valid || retained->guest_frame != input.metadata.guest_frame ||
+      !retained->hdr_color.resource ||
+      !IsKnownSsxScene(input.metadata.scene_width, input.metadata.scene_height) ||
+      input.metadata.scale_x != 3 || input.metadata.scale_y != 3 ||
+      !PlanSsxSceneColor(input, decode) || decode.exposure_enabled == 2)
+    return false;
+  const auto desc = retained->hdr_color.resource->GetDesc();
+  if (desc.Format != DXGI_FORMAT_R16G16B16A16_FLOAT || desc.Width != decode.width ||
+      desc.Height != decode.height || desc.DepthOrArraySize != 1 || desc.MipLevels != 1 ||
+      desc.SampleDesc.Count != 1 || desc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D)
+    return false;
+  if (decode.exposure_enabled) {
+    // The native preview bypasses the guest filmic curve. Preserve its slope
+    // at black, then smoothly join the HDR linear midtones at 0.25 scene units.
+    // f(x)=scale*((a*x*x+b*x+c)/(a*x*x+d*x+e)-offset).
+    const auto& curve = input.metadata.tone_map_constants;
+    const double b = curve[16], c = curve[20], d = curve[12], e = curve[24], scale = curve[32];
+    if (!std::isfinite(b) || !std::isfinite(c) || !std::isfinite(d) || !std::isfinite(e) ||
+        !std::isfinite(scale) || e <= 0 || scale <= 0)
+      return false;
+    const double slope = scale * (b * e - c * d) / (e * e);
+    if (!std::isfinite(slope) || slope <= 0)
+      return false;
+    k.shadow_slope = float(std::min(slope, 1.0));
+    const auto& fetch = input.textures[size_t(SsxInput::kLogExposure)].guest_fetch;
+    const uint32_t mag = (fetch[3] >> 19) & 3, min = (fetch[3] >> 21) & 3;
+    // The tone-map instruction inherits fetch filtering. Support point or
+    // linear clamp only, never silently replace an unknown guest sampler.
+    if (((fetch[0] >> 10) & 7) != 2 || ((fetch[0] >> 13) & 7) != 2 || min != mag || min > 1 ||
+        ((fetch[3] >> 25) & 7))
+      return false;
+    k.exposure_linear = min;
+  } else
+    k.shadow_slope = 1;
+  k.exposure_enabled = decode.exposure_enabled;
+  k.exposure_scale = decode.exposure_scale;
+  k.exposure_key = decode.exposure_key;
+  k.log_scale = decode.log_scale;
+  k.native_scene = 1;
+  return true;
+}
+struct SsxHDR::Impl {
+  using ComResource = Microsoft::WRL::ComPtr<ID3D12Resource>;
+  struct Slot {
+    ComResource output;
+    Microsoft::WRL::ComPtr<ID3D12DescriptorHeap> heap;
+  };
+  std::array<Slot, 3> slots;
+  Microsoft::WRL::ComPtr<ID3D12RootSignature> root;
+  Microsoft::WRL::ComPtr<ID3D12PipelineState> pipeline;
+};
+SsxHDR::SsxHDR() : impl_(std::make_unique<Impl>()) {}
+SsxHDR::~SsxHDR() = default;
+bool SsxHDR::Prepare(const D3D12Provider& provider, uint32_t index, uint32_t width,
+                     uint32_t height) {
+  if (index >= impl_->slots.size() || !width || !height || width > 16384 || height > 16384)
+    return false;
+  auto* device = provider.GetDevice();
+  if (!impl_->pipeline) {
+    D3D12_DESCRIPTOR_RANGE ranges[] = {{D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 3, 0, 0, 0},
+                                       {D3D12_DESCRIPTOR_RANGE_TYPE_UAV, 1, 0, 0, 3}};
+    D3D12_ROOT_PARAMETER parameters[2]{};
+    parameters[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    parameters[0].Constants = {0, 0, sizeof(SsxHDRConstants) / 4};
+    parameters[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    parameters[1].DescriptorTable = {2, ranges};
+    D3D12_STATIC_SAMPLER_DESC samplers[2]{};
+    for (uint32_t i = 0; i < 2; ++i) {
+      auto& sampler = samplers[i];
+      sampler.ShaderRegister = i;
+      sampler.Filter = i ? D3D12_FILTER_MIN_MAG_MIP_POINT : D3D12_FILTER_MIN_MAG_LINEAR_MIP_POINT;
+      sampler.AddressU = sampler.AddressV = sampler.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+      sampler.ComparisonFunc = D3D12_COMPARISON_FUNC_ALWAYS;
+      sampler.MaxLOD = D3D12_FLOAT32_MAX;
+    }
+    D3D12_ROOT_SIGNATURE_DESC desc{};
+    desc.NumParameters = 2;
+    desc.pParameters = parameters;
+    desc.NumStaticSamplers = 2;
+    desc.pStaticSamplers = samplers;
+    impl_->root.Attach(util::CreateRootSignature(provider, desc));
+    if (!impl_->root)
+      return false;
+    impl_->pipeline.Attach(
+        util::CreateComputePipeline(device, ssx_hdr_cs, sizeof(ssx_hdr_cs), impl_->root.Get()));
+    if (!impl_->pipeline)
+      return false;
+  }
+  auto& slot = impl_->slots[index];
+  if (!slot.heap) {
+    D3D12_DESCRIPTOR_HEAP_DESC desc{};
+    desc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+    desc.NumDescriptors = 4;
+    desc.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+    if (FAILED(device->CreateDescriptorHeap(&desc, IID_PPV_ARGS(&slot.heap))))
+      return false;
+  }
+  if (slot.output && slot.output->GetDesc().Width == width &&
+      slot.output->GetDesc().Height == height)
+    return true;
+  D3D12_RESOURCE_DESC desc{};
+  desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+  desc.Width = width;
+  desc.Height = height;
+  desc.DepthOrArraySize = desc.MipLevels = desc.SampleDesc.Count = 1;
+  desc.Format = DXGI_FORMAT_R10G10B10A2_UNORM;
+  desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+  Impl::ComResource output;
+  if (FAILED(device->CreateCommittedResource(&util::kHeapPropertiesDefault, D3D12_HEAP_FLAG_NONE,
+                                             &desc, D3D12_RESOURCE_STATE_COPY_SOURCE, nullptr,
+                                             IID_PPV_ARGS(&output))))
+    return false;
+  output->SetName(L"SSX native scene HDR10 preview (post/HUD integration pending)");
+  slot.output = std::move(output);
+  return true;
+}
+ID3D12Resource* SsxHDR::Record(const D3D12Provider& provider, ID3D12GraphicsCommandList* list,
+                               uint32_t index, ID3D12Resource* overlay,
+                               const std::shared_ptr<const SsxFrameInputs>& frame,
+                               const SsxHDRConstants& k) {
+  if (!list || !overlay || index >= impl_->slots.size() || !impl_->pipeline)
+    return nullptr;
+  const SsxHDRSettings settings{k.peak_nits, k.paper_white_nits, k.ui_nits, k.exposure_ev,
+                                k.highlight_boost};
+  if (!settings.Valid())
+    return nullptr;
+  auto& slot = impl_->slots[index];
+  if (!slot.output || k.width != slot.output->GetDesc().Width ||
+      k.height != slot.output->GetDesc().Height || overlay->GetDesc().Width != k.width ||
+      overlay->GetDesc().Height != k.height ||
+      overlay->GetDesc().Format != DXGI_FORMAT_B8G8R8A8_UNORM)
+    return nullptr;
+  ID3D12Resource* scene = nullptr;
+  ID3D12Resource* exposure = nullptr;
+  if (k.native_scene) {
+    SsxHDRConstants checked = k;
+    if (!frame || !PlanSsxHDR(*frame, checked) || checked.exposure_enabled != k.exposure_enabled ||
+        checked.exposure_scale != k.exposure_scale || checked.exposure_key != k.exposure_key ||
+        checked.log_scale != k.log_scale || checked.exposure_linear != k.exposure_linear ||
+        checked.shadow_slope != k.shadow_slope)
+      return nullptr;
+    scene = frame->fg_temporal->hdr_color.resource.Get();
+    if (k.exposure_enabled)
+      exposure = frame->textures[size_t(SsxInput::kLogExposure)].resource.Get();
+  }
+  auto* device = provider.GetDevice();
+  auto handle = slot.heap->GetCPUDescriptorHandleForHeapStart();
+  auto srv = [&](ID3D12Resource* texture, DXGI_FORMAT format) {
+    D3D12_SHADER_RESOURCE_VIEW_DESC desc{};
+    desc.Format = format;
+    desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    desc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    desc.Texture2D.MipLevels = 1;
+    device->CreateShaderResourceView(texture, &desc, handle);
+    handle.ptr += provider.GetViewDescriptorSize();
+  };
+  srv(scene, DXGI_FORMAT_R16G16B16A16_FLOAT);
+  srv(exposure, DXGI_FORMAT_R16_UNORM);
+  srv(overlay, DXGI_FORMAT_B8G8R8A8_UNORM);
+  D3D12_UNORDERED_ACCESS_VIEW_DESC uav{};
+  uav.Format = DXGI_FORMAT_R10G10B10A2_UNORM;
+  uav.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+  device->CreateUnorderedAccessView(slot.output.Get(), nullptr, &uav, handle);
+  Transition(list, overlay, D3D12_RESOURCE_STATE_RENDER_TARGET,
+             D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  Transition(list, slot.output.Get(), D3D12_RESOURCE_STATE_COPY_SOURCE,
+             D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  auto* heap = slot.heap.Get();
+  list->SetDescriptorHeaps(1, &heap);
+  list->SetComputeRootSignature(impl_->root.Get());
+  list->SetPipelineState(impl_->pipeline.Get());
+  list->SetComputeRoot32BitConstants(0, sizeof(k) / 4, &k, 0);
+  list->SetComputeRootDescriptorTable(1, heap->GetGPUDescriptorHandleForHeapStart());
+  list->Dispatch((k.width + 7) / 8, (k.height + 7) / 8, 1);
+  Transition(list, slot.output.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+             D3D12_RESOURCE_STATE_COPY_SOURCE);
+  Transition(list, overlay, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+             D3D12_RESOURCE_STATE_RENDER_TARGET);
+  return slot.output.Get();
+}
+}  // namespace rex::ui::d3d12
