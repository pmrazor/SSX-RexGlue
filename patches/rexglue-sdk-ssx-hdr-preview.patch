@@ -0,0 +1,44 @@
+#include <catch2/catch_test_macros.hpp>
+#include <rex/ui/d3d12/ssx_hdr.h>
+#include <limits>
+using namespace rex::ui::d3d12;
+TEST_CASE("SSX HDR PQ uses absolute nits, including 3000 nit TV target", "[SSX][HDR]") {
+  CHECK(SsxPQEncode(0) == 0);
+  CHECK(SsxPQDecode(0) == 0);
+  CHECK(std::abs(SsxPQEncode(100) - .5080784215) < 1e-9);
+  CHECK(std::abs(SsxPQEncode(1000) - .7518270962) < 1e-9);
+  CHECK(std::abs(SsxPQEncode(3000) - .8714864444) < 1e-9);
+  CHECK(std::abs(SsxPQEncode(10000) - 1) < 1e-12);
+  for (double nits : {.001, .1, 1., 80., 200., 1000., 3000., 10000.})
+    CHECK(std::abs(SsxPQDecode(SsxPQEncode(nits)) - nits) < 1e-7);
+}
+TEST_CASE("SSX HDR calibration rejects nonfinite and contradictory settings", "[SSX][HDR]") {
+  SsxHDRSettings s;
+  CHECK(s.Valid());
+  s.peak_nits = 3000;
+  CHECK(s.Valid());
+  s.peak_nits = 3001;
+  CHECK_FALSE(s.Valid());
+  s.peak_nits = 400;
+  s.paper_white_nits = 400;
+  CHECK_FALSE(s.Valid());
+  s.paper_white_nits = 200;
+  s.ui_nits = 401;
+  CHECK_FALSE(s.Valid());
+  s.ui_nits = 200;
+  s.exposure_ev = std::numeric_limits<float>::quiet_NaN();
+  CHECK_FALSE(s.Valid());
+}
+TEST_CASE("SSX retained HDR color must be marked anew on pool reuse", "[SSX][HDR]") {
+  SsxFGTemporalPool pool;
+  auto frame = pool.Acquire(1, 0);
+  frame->hdr_valid = true;
+  frame->submission = 2;
+  auto second = pool.Acquire(2, 1);
+  CHECK(second != frame);
+  frame.reset();
+  second.reset();
+  auto reused = pool.Acquire(3, 2);
+  CHECK_FALSE(reused->hdr_valid);
+  CHECK(reused->guest_frame == 3);
+}
