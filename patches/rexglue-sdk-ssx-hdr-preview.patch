+bool D3D12Presenter::UpdateHDRSurface() {
+  auto& pc = paint_context_;
+  if (!REXCVAR_GET(d3d12_ssx_hdr_preview)) return true;
+  Microsoft::WRL::ComPtr<IDXGIOutput> output;
+  Microsoft::WRL::ComPtr<IDXGIOutput6> output6;
+  DXGI_OUTPUT_DESC1 desc{};
+  UINT support = 0;
+  const bool available = SUCCEEDED(pc.swap_chain->GetContainingOutput(&output)) &&
+      SUCCEEDED(output.As(&output6)) && SUCCEEDED(output6->GetDesc1(&desc)) &&
+      desc.ColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020 &&
+      SUCCEEDED(pc.swap_chain->CheckColorSpaceSupport(DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020, &support)) &&
+      (support & DXGI_SWAP_CHAIN_COLOR_SPACE_SUPPORT_FLAG_PRESENT);
+  if (pc.hdr_color_space_set && available == pc.hdr_active && desc.Monitor == pc.hdr_monitor)
+    return true;
+  pc.AwaitSwapChainUsageCompletion();
+  const auto space = available ? DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020 : DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709;
+  if (FAILED(pc.swap_chain->SetColorSpace1(space))) return false;
+  pc.hdr_active = available;
+  pc.hdr_monitor = desc.Monitor;
+  pc.hdr_color_space_set = true;
+  Microsoft::WRL::ComPtr<IDXGISwapChain4> chain4;
+  HRESULT metadata_result = E_NOINTERFACE;
+  const auto settings = GetSsxHDRSettings();
+  if (SUCCEEDED(pc.swap_chain.As(&chain4))) {
+    if (available) {
+      // Rec.2020/D65 mastering target. MaxFALL is unknown, not an invented average.
+      DXGI_HDR_METADATA_HDR10 metadata{};
+      metadata.RedPrimary[0] = 35400; metadata.RedPrimary[1] = 14600;
+      metadata.GreenPrimary[0] = 8500; metadata.GreenPrimary[1] = 39850;
+      metadata.BluePrimary[0] = 6550; metadata.BluePrimary[1] = 2300;
+      metadata.WhitePoint[0] = 15635; metadata.WhitePoint[1] = 16450;
+      metadata.MaxMasteringLuminance = UINT(settings.peak_nits);
+      metadata.MaxContentLightLevel = UINT16(settings.peak_nits);
+      metadata_result = chain4->SetHDRMetaData(DXGI_HDR_METADATA_TYPE_HDR10, sizeof(metadata), &metadata);
+    } else metadata_result = chain4->SetHDRMetaData(DXGI_HDR_METADATA_TYPE_NONE, 0, nullptr);
+  }
+  REXLOG_INFO("SSX_HDR transport={} target_nits={} paper_white={} ui_nits={} reported_peak={} metadata_hr={:08X} mode=native_scene_preview post_hud_complete=false fg=false",
+      available ? "HDR10_PQ_2020" : "SDR_fallback_enable_Windows_HDR",
+      settings.peak_nits, settings.paper_white_nits, settings.ui_nits, desc.MaxLuminance, uint32_t(metadata_result));
+  return true;
+}
