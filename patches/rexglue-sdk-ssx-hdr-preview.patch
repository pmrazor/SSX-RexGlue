diff --git a/src/ui/shaders/ssx_hdr.cs.hlsl b/src/ui/shaders/ssx_hdr.cs.hlsl
new file mode 100644
index 0000000..22934f6
--- /dev/null
+++ b/src/ui/shaders/ssx_hdr.cs.hlsl
@@ -0,0 +1,91 @@
+// Native FP16 scene -> spatial guest exposure -> HDR shoulder -> Rec.2020/PQ.
+// This scene preview intentionally precedes the game's SDR post-effects/HUD.
+cbuffer Constants : register(b0) {
+  uint2 output_size;
+  uint native_scene, exposure_enabled;
+  float peak_nits, paper_white_nits, ui_nits, exposure_ev;
+  float exposure_scale, exposure_key, log_scale;
+  uint exposure_linear;
+  uint calibration;
+  uint hdr_output;
+  float highlight_boost;
+  float shadow_slope;
+};
+Texture2D<float4> scene : register(t0);
+Texture2D<float> log_exposure : register(t1);
+Texture2D<float4> overlay : register(t2);
+SamplerState linear_clamp : register(s0);
+SamplerState point_clamp : register(s1);
+RWTexture2D<unorm float4> output_pq : register(u0);
+float3 LinearSRGB(float3 v) {
+  v = saturate(v);
+  return float3(v.r <= .04045 ? v.r / 12.92 : pow((v.r + .055) / 1.055, 2.4),
+                v.g <= .04045 ? v.g / 12.92 : pow((v.g + .055) / 1.055, 2.4),
+                v.b <= .04045 ? v.b / 12.92 : pow((v.b + .055) / 1.055, 2.4));
+}
+float3 PQ(float3 nits) {
+  float3 p = pow(saturate(nits / 10000), 2610.0 / 16384.0);
+  float3 code = pow((3424.0 / 4096.0 + (2413.0 / 128.0) * p) /
+                    (1 + (2392.0 / 128.0) * p), 2523.0 / 32.0);
+  return float3(nits.r <= 0 ? 0 : code.r, nits.g <= 0 ? 0 : code.g, nits.b <= 0 ? 0 : code.b);
+}
+[numthreads(8, 8, 1)]
+void main(uint3 id : SV_DispatchThreadID) {
+  if (any(id.xy >= output_size)) return;
+  if (!hdr_output) {
+    output_pq[id.xy] = float4(overlay.Load(int3(id.xy, 0)).rgb, 1);
+    return;
+  }
+  float2 uv = (float2(id.xy) + .5) / output_size;
+  float3 nits = 0;
+  if (native_scene) {
+    float3 rgb = scene.SampleLevel(linear_clamp, uv, 0).rgb;
+    rgb = all(isfinite(rgb)) ? max(rgb, 0) : 0;
+    float exposure = 1;
+    if (exposure_enabled) {
+      float raw = exposure_linear ? log_exposure.SampleLevel(linear_clamp, uv, 0) :
+                                    log_exposure.SampleLevel(point_clamp, uv, 0);
+      exposure = exposure_key * exp2(-log_scale * raw * exposure_scale);
+    }
+    rgb *= exposure * exp2(exposure_ev);
+    float shadow = max(rgb.r, max(rgb.g, rgb.b));
+    if (shadow < .25) {
+      // Monotonic cubic toe, matching the guest's derivative at zero and the
+      // HDR curve's value/derivative at .25. No black pedestal or hard cutoff.
+      float t = saturate(shadow / .25);
+      rgb *= 1 - (1-shadow_slope)*(1-t)*(1-t);
+    }
+    nits = rgb * paper_white_nits;
+    nits = all(isfinite(nits)) ? nits : 0;
+    // Preserve diffuse values and hue. Smoothly compress values above paper
+    // white, keeping different scene highlights distinct up to the display peak.
+    float brightest = max(nits.r, max(nits.g, nits.b));
+    if (brightest > paper_white_nits) {
+      float span = peak_nits - paper_white_nits;
+      float t = (brightest - paper_white_nits) / span;
+      // C1-continuous at paper white; boost never changes diffuse whites or peak.
+      t += (highlight_boost - 1) * t * t / (1 + t);
+      float mapped = paper_white_nits + span * (1 - exp(-t));
+      nits *= mapped / brightest;
+    }
+    float4 ui = overlay.Load(int3(id.xy, 0));
+    // UI was blended in the original SDR code space on transparent black.
+    float3 ui_linear = LinearSRGB(saturate(ui.rgb / max(ui.a, 1e-6)));
+    nits = nits * (1-ui.a) + ui_linear * ui_nits * ui.a;
+  } else {
+    nits = LinearSRGB(overlay.Load(int3(id.xy, 0)).rgb) * ui_nits;
+  }
+  if (calibration) {
+    // Small-area clipping pattern: selected peak versus 90% peak on dark gray.
+    // No large white flash. Middle bar is paper white; lower bar is UI white.
+    nits = 0;
+    if (all(abs(uv - float2(.5,.35)) < float2(.1,.05)))
+      nits = (uv.x < .5 ? .9 : 1) * peak_nits;
+    if (all(abs(uv - float2(.5,.5)) < float2(.1,.025))) nits = paper_white_nits;
+    if (all(abs(uv - float2(.5,.6)) < float2(.1,.025))) nits = ui_nits;
+  }
+  float3 rec2020 = mul(float3x3(.62740390,.32928304,.04331307,
+                               .06909729,.91954040,.01136232,
+                               .01639144,.08801331,.89559525), nits);
+  output_pq[id.xy] = float4(PQ(rec2020), 1);
+}
