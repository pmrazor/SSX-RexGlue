diff --git a/src/graphics/d3d12/ssx_geometry.cpp b/src/graphics/d3d12/ssx_geometry.cpp
new file mode 100644
index 0000000..017a069
--- /dev/null
+++ b/src/graphics/d3d12/ssx_geometry.cpp
@@ -0,0 +1,105 @@
+#include <rex/cvar.h>
+#include <rex/graphics/d3d12/command_processor.h>
+#include <rex/graphics/flags.h>
+#include <rex/logging.h>
+
+#include <cstring>
+
+REXCVAR_DECLARE(bool, d3d12_ssx_native_motion);
+
+namespace rex::graphics::d3d12 {
+void D3D12CommandProcessor::CollectSsxGeometry(
+    uint64_t vs, uint64_t ps,
+    const PrimitiveProcessor::ProcessingResult& primitive, bool memexport) {
+  using namespace ui::d3d12;
+  if (!REXCVAR_GET(d3d12_ssx_native_motion) || ssx_title_id_ != 0x4541096D ||
+      !IsSsxDeformedDraw(vs, ps) || !ssx_inputs_ ||
+      ssx_inputs_->metadata.guest_frame != frame_current_)
+    return;
+  auto& geometry = ssx_inputs_->geometry;
+  const auto& regs = *register_file_;
+  const auto fetch =
+      regs.GetVertexFetch(95);  // Disassembly vf0 is physical fetch 95.
+  const uint32_t vb_size = fetch.size * 4, vb_address = fetch.address * 4;
+  const uint32_t ib_size = primitive.host_draw_vertex_count * 2;
+  const uint32_t ib_copy_size = (ib_size + 3) & ~3u;
+  const auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+  const auto clip = regs.Get<reg::PA_CL_CLIP_CNTL>();
+  if (memexport || primitive.IsTessellated() ||
+      primitive.index_buffer_type !=
+          PrimitiveProcessor::ProcessedIndexBufferType::kGuestDMA ||
+      primitive.host_primitive_type != xenos::PrimitiveType::kTriangleList ||
+      primitive.host_index_format != xenos::IndexFormat::kInt16 ||
+      primitive.host_shader_index_endian != xenos::Endian::k8in16 ||
+      primitive.host_primitive_reset_enabled || !ib_size ||
+      primitive.host_draw_vertex_count % 3 ||
+      (primitive.guest_index_base & 3) ||
+      fetch.type != xenos::FetchConstantType::kVertex ||
+      fetch.endian != xenos::Endian::k8in32 || !vb_size || vb_size % 32 ||
+      vb_size > 2 * 1024 * 1024 ||
+      uint64_t(vb_address) + vb_size > SharedMemory::kBufferSize ||
+      uint64_t(primitive.guest_index_base) + ib_copy_size >
+          SharedMemory::kBufferSize ||
+      regs[XE_GPU_REG_VGT_INDX_OFFSET] != 0 ||
+      regs[XE_GPU_REG_VGT_MIN_VTX_INDX] != 0 ||
+      regs[XE_GPU_REG_VGT_MAX_VTX_INDX] < vb_size / 32 - 1 ||
+      (vte.value & 0x73F) != 0x43F || clip.clip_disable ||
+      !clip.dx_clip_space_def ||
+      regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_ZSCALE) != -1 ||
+      regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_ZOFFSET) != 1 ||
+      geometry.count == SsxGeometry::kMaxDraws ||
+      uint64_t(geometry.bytes) + vb_size + ib_copy_size >
+          SsxGeometry::kCapacity) {
+    ++geometry.rejected;
+    return;
+  }
+  if (!geometry.Prepare(GetD3D12Provider().GetDevice()) ||
+      !shared_memory_->RequestRange(primitive.guest_index_base, ib_copy_size)) {
+    ++geometry.rejected;
+    return;
+  }
+  SsxGeometryDraw draw;
+  draw.shader = vs;
+  draw.vertex_address = vb_address;
+  draw.index_address = primitive.guest_index_base;
+  draw.vertex_offset = geometry.bytes;
+  draw.index_offset = draw.vertex_offset + vb_size;
+  draw.vertex_count = vb_size / 32;
+  draw.index_count = primitive.host_draw_vertex_count;
+  draw.vertex_endian = uint32_t(fetch.endian);
+  draw.index_endian = uint32_t(primitive.host_shader_index_endian);
+  std::memcpy(draw.world_to_clip.data(),
+              &regs[XE_GPU_REG_SHADER_CONSTANT_000_X + 192 * 4], 64);
+  draw.viewport = {regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE),
+                   regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE),
+                   regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET),
+                   regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET)};
+  if (regs.Get<reg::PA_SU_SC_MODE_CNTL>().vtx_window_offset_enable) {
+    const auto offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+    draw.viewport[2] += float(offset.window_x_offset);
+    draw.viewport[3] += float(offset.window_y_offset);
+  }
+  if (REXCVAR_GET(half_pixel_offset) &&
+      regs.Get<reg::PA_SU_VTX_CNTL>().pix_center ==
+          xenos::PixelCenter::kD3DZero) {
+    draw.viewport[2] += 0.5f;
+    draw.viewport[3] += 0.5f;
+  }
+  shared_memory_->UseAsCopySource();
+  PushTransitionBarrier(geometry.buffer.Get(), GuestInputTexture::kReadState,
+                        D3D12_RESOURCE_STATE_COPY_DEST);
+  SubmitBarriers();
+  deferred_command_list_.D3DCopyBufferRegion(
+      geometry.buffer.Get(), draw.vertex_offset, shared_memory_->GetBuffer(),
+      vb_address, vb_size);
+  deferred_command_list_.D3DCopyBufferRegion(
+      geometry.buffer.Get(), draw.index_offset, shared_memory_->GetBuffer(),
+      draw.index_address, ib_copy_size);
+  PushTransitionBarrier(geometry.buffer.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+                        GuestInputTexture::kReadState);
+  // IssueDraw restores shared memory to its tracked reading/writing state.
+  geometry.draws[geometry.count++] = draw;
+  geometry.bytes += vb_size + ib_copy_size;
+  ssx_inputs_->last_copy_submission = submission_current_;
+}
+}  // namespace rex::graphics::d3d12
