index 0000000..c33460e
--- /dev/null
+++ b/src/ui/shaders/ssx_native_motion.hlsl
@@ -0,0 +1,93 @@
+// Only the observed 32-byte, predeformed SSX rider vertex format is supported.
+// History is geometry-derived, never image motion estimation. Prototype only:
+// mesh keys are not yet authoritative SSX object IDs.
+cbuffer Constants : register(b0) {
+  row_major float4x4 current_camera;
+  row_major float4x4 previous_camera;
+  float4 current_viewport;  // Guest viewport converted to host NDC.
+  float4 previous_viewport; // Guest viewport converted to host pixels.
+  uint4 offsets;           // Current VB, previous VB, current IB, previous IB.
+  uint4 counts;            // Vertex count, index count, reserved, reserved.
+  uint4 size;              // Width, height, reserved, reserved.
+};
+ByteAddressBuffer current_geometry : register(t0);
+ByteAddressBuffer previous_geometry : register(t1);
+Texture2D<float> scene_depth : register(t2);
+RWByteAddressBuffer statistics : register(u2);
+
+uint3 Swap32(uint3 v) {
+  v = ((v & 0x00FF00FF) << 8) | ((v >> 8) & 0x00FF00FF);
+  return (v << 16) | (v >> 16);
+}
+uint Index(ByteAddressBuffer buffer, uint base, uint id) {
+  uint v = buffer.Load(base + ((id * 2) & ~3u));
+  v = (v >> ((id & 1) * 16)) & 65535;
+  return ((v & 255) << 8) | (v >> 8); // Xenos 8-in-16.
+}
+float4 Project(float3 p, float4x4 camera) {
+  // Xenos MAD rounds multiply and add separately. ReXGlue's guest translator
+  // emits MUL then ADD, deliberately avoiding FMA (dxbc_translator_alu.cpp).
+  // Fused math loses depth agreement at large world coordinates, leaving holes
+  // across whole rider triangles. Precise prevents contraction/reassociation.
+  precise float4 clip = p.z * camera[2] + camera[3];
+  clip = p.y * camera[1] + clip;
+  clip = p.x * camera[0] + clip;
+  return clip;
+}
+struct Varying {
+  float4 position : SV_Position;
+  float4 previous : TEXCOORD0;
+  float3 world_delta : TEXCOORD1;
+};
+Varying vs_main(uint id : SV_VertexID) {
+  Varying o = (Varying)0;
+  o.position = float4(0, 0, -1, 1); // Reject entire triangle if any correspondence fails.
+  uint first = (id / 3) * 3;
+  bool valid = first + 2 < counts.y;
+  [unroll] for (uint k = 0; k < 3; ++k) {
+    uint ci = Index(current_geometry, offsets.z, first + k);
+    uint pi = Index(previous_geometry, offsets.w, first + k);
+    if (ci != pi || ci >= counts.x) { valid = false; continue; }
+    // Normals change under skinning. UVs identify the vertex's mesh membership.
+    valid = valid && all(current_geometry.Load2(offsets.x + ci * 32 + 24) ==
+                         previous_geometry.Load2(offsets.y + pi * 32 + 24));
+    float3 a = asfloat(Swap32(current_geometry.Load3(offsets.x + ci * 32)));
+    float3 b = asfloat(Swap32(previous_geometry.Load3(offsets.y + pi * 32)));
+    float4 ca = Project(a, current_camera), cb = Project(b, previous_camera);
+    valid = valid && all(isfinite(ca)) && all(isfinite(cb)) &&
+            ca.w > 1e-5 && cb.w > 1e-5 && all(abs(a - b) < 256);
+  }
+  if (!valid) return o;
+  uint index = Index(current_geometry, offsets.z, id);
+  float3 current = asfloat(Swap32(current_geometry.Load3(offsets.x + index * 32)));
+  float3 previous = asfloat(Swap32(previous_geometry.Load3(offsets.y + index * 32)));
+  float4 clip = Project(current, current_camera);
+  o.position.xy = clip.xy * current_viewport.xy + clip.ww * current_viewport.zw;
+  o.position.zw = float2(clip.w - clip.z, clip.w); // Observed reversed depth.
+  o.previous = Project(previous, previous_camera);
+  o.world_delta = previous - current;
+  return o;
+}
+struct Targets { float2 motion : SV_Target0; uint validity : SV_Target1; };
+Targets ps_main(Varying input) {
+  uint2 pixel = uint2(input.position.xy);
+  if (any(pixel >= size.xy)) discard;
+  float depth = scene_depth.Load(int3(pixel, 0));
+  // Conservative prototype depth gate. Quantization and multi-sample edges
+  // require capture validation; this is not an occlusion confidence guarantee.
+  if (!(depth > 0 && depth <= 1) ||
+      abs(depth - input.position.z) > max(2e-6, depth * 1e-4)) discard;
+  float2 previous_pixel = input.previous.xy / input.previous.w *
+                          previous_viewport.xy + previous_viewport.zw;
+  float2 motion = previous_pixel - input.position.xy;
+  if (!all(isfinite(motion))) discard;
+  uint ignored;
+  statistics.InterlockedAdd(0, 1, ignored);
+  if (length(motion) > .01) statistics.InterlockedAdd(4, 1, ignored);
+  statistics.InterlockedMax(8, asuint(length(motion)), ignored);
+  statistics.InterlockedMax(12, asuint(length(input.world_delta)), ignored);
+  Targets result;
+  result.motion = motion;
+  result.validity = 2; // Native geometry correspondence; still experimental.
+  return result;
+}
