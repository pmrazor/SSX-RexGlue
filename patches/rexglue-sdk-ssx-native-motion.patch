diff --git a/include/rex/ui/d3d12/ssx_geometry.h b/include/rex/ui/d3d12/ssx_geometry.h
new file mode 100644
index 0000000..1d7e9c0
--- /dev/null
+++ b/include/rex/ui/d3d12/ssx_geometry.h
@@ -0,0 +1,49 @@
+// Experimental native geometry history for the observed SSX rider shaders.
+#pragma once
+#include <rex/ui/d3d12/d3d12_api.h>
+
+#include <array>
+#include <cstdint>
+
+namespace rex::ui::d3d12 {
+inline bool IsSsxDeformedDraw(uint64_t vs, uint64_t ps) {
+  return (vs == 0x9897AE6BB3FD8C0Bull && ps == 0x78C15EF5A4F22B90ull) ||
+         (vs == 0x1DF106D9BBC3DAB5ull && ps == 0x9B85AFC510BDB8ECull) ||
+         (vs == 0x0F20F851EA9BECB1ull && ps == 0x5EDF9E6FD35933CCull) ||
+         (vs == 0x6E147097CF5A252Aull && ps == 0x5A65EA089B5672CFull);
+}
+struct SsxGeometryDraw {
+  uint64_t shader = 0;
+  uint32_t vertex_address = 0, index_address = 0;
+  uint32_t vertex_offset = 0, index_offset = 0;
+  uint32_t vertex_count = 0, index_count = 0;
+  uint32_t vertex_endian = 0, index_endian = 0;
+  std::array<float, 16> world_to_clip{};
+  std::array<float, 4> viewport{};
+  // This is a candidate identity, not a game object ID. GPU shaders
+  // additionally compare each triangle's indices and UVs. Duplicate keys are
+  // rejected.
+  bool SameKey(const SsxGeometryDraw& b) const {
+    return shader == b.shader && index_address == b.index_address &&
+           vertex_count == b.vertex_count && index_count == b.index_count &&
+           vertex_endian == b.vertex_endian && index_endian == b.index_endian;
+  }
+};
+struct SsxGeometry {
+  static constexpr uint32_t kMaxDraws = 32, kCapacity = 8 * 1024 * 1024;
+  Microsoft::WRL::ComPtr<ID3D12Resource> buffer;
+  std::array<SsxGeometryDraw, kMaxDraws> draws{};
+  uint32_t count = 0, bytes = 0, rejected = 0;
+  bool Prepare(ID3D12Device* device);
+  void Reset() { count = bytes = rejected = 0; }
+  int UniqueMatch(const SsxGeometryDraw& key) const {
+    int result = -1;
+    for (uint32_t i = 0; i < count; ++i) {
+      if (!draws[i].SameKey(key)) continue;
+      if (result >= 0) return -1;
+      result = int(i);
+    }
+    return result;
+  }
+};
+}  // namespace rex::ui::d3d12
diff --git a/include/rex/ui/d3d12/ssx_native_motion.h b/include/rex/ui/d3d12/ssx_native_motion.h
new file mode 100644
index 0000000..cd76451
--- /dev/null
+++ b/include/rex/ui/d3d12/ssx_native_motion.h
@@ -0,0 +1,63 @@
+#pragma once
+#include <rex/ui/d3d12/ssx_camera_motion.h>
+
+#include <filesystem>
+#include <vector>
+
+namespace rex::ui::d3d12 {
+// Single paint-thread owner. Inputs and GPU descriptors remain alive until the
+// caller's submission fence completes. Caller drains the queue before
+// destruction.
+class SsxNativeMotion {
+ public:
+  struct Result {
+    uint32_t captured = 0, rejected = 0, matched = 0;
+    bool drawn = false;
+  };
+  Result Record(const D3D12Provider& provider, ID3D12GraphicsCommandList* list,
+                const std::shared_ptr<const SsxFrameInputs>& frame,
+                const SsxCameraMotion::Result& camera, uint64_t submission,
+                uint64_t completed);
+  void Reset() { previous_.reset(); }
+  // Diagnostic only: capture the next drawn native pass into a NEW directory.
+  // GPU copies are asynchronous; Record writes files only after its fence.
+  bool RequestCapture(const std::filesystem::path& directory);
+
+ private:
+  struct Slot {
+    Microsoft::WRL::ComPtr<ID3D12DescriptorHeap> depth_heap, rtv_heap;
+    Microsoft::WRL::ComPtr<ID3D12Resource> counters, readback;
+    std::shared_ptr<const SsxFrameInputs> current, previous;
+    uint64_t submission = 0, frame = 0;
+    bool pending = false;
+  };
+  bool Initialize(const D3D12Provider& provider);
+  bool Prepare(const D3D12Provider& provider, Slot& slot);
+  void ReadDiagnostics(Slot& slot);
+  struct CapturePart {
+    const char* name;
+    uint64_t offset, row_bytes;
+    uint32_t rows, pitch;
+  };
+  struct Capture {
+    std::filesystem::path directory;
+    Microsoft::WRL::ComPtr<ID3D12Resource> readback;
+    std::shared_ptr<const SsxFrameInputs> current, previous;
+    std::vector<CapturePart> parts;
+    uint64_t submission = 0, bytes = 0;
+    uint32_t width = 0, height = 0;
+  } capture_;
+  void RecordCapture(ID3D12Device* device, ID3D12GraphicsCommandList* list,
+                     const SsxCameraMotion::Result& camera, const Slot& slot);
+  void ReadCapture(uint64_t completed);
+  double capture_poll_seconds_ = 0;
+  bool capture_triggered_ = false;
+  std::array<Slot, 3> slots_;
+  std::shared_ptr<const SsxFrameInputs> previous_;
+  Microsoft::WRL::ComPtr<ID3D12RootSignature> root_;
+  Microsoft::WRL::ComPtr<ID3D12PipelineState> pipeline_;
+  Microsoft::WRL::ComPtr<ID3D12Resource> zero_;
+  bool unavailable_ = false;
+  uint64_t last_readback_ = 0;
+};
+}  // namespace rex::ui::d3d12
