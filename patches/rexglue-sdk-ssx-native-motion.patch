diff --git a/src/ui/d3d12/ssx_native_motion.cpp b/src/ui/d3d12/ssx_native_motion.cpp
new file mode 100644
index 0000000..5e31c5e
--- /dev/null
+++ b/src/ui/d3d12/ssx_native_motion.cpp
@@ -0,0 +1,508 @@
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/ui/d3d12/d3d12_provider.h>
+#include <rex/ui/d3d12/d3d12_util.h>
+#include <rex/ui/d3d12/ssx_native_motion.h>
+
+#include <chrono>
+#include <cstring>
+#include <fstream>
+#include <iomanip>
+
+REXCVAR_DEFINE_STRING(d3d12_ssx_native_capture_path, "", "UI/D3D12",
+                      "Diagnostic output root. Create capture.request inside "
+                      "it to read back one native motion frame.")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+
+namespace rex::ui::d3d12 {
+namespace {
+#include "ui/shaders/bytecode/d3d12_5_1/ssx_native_motion_ps.h"
+#include "ui/shaders/bytecode/d3d12_5_1/ssx_native_motion_vs.h"
+using Microsoft::WRL::ComPtr;
+struct Constants {
+  std::array<float, 16> current_camera, previous_camera;
+  std::array<float, 4> current_viewport, previous_viewport;
+  std::array<uint32_t, 4> offsets, counts, size;
+};
+static_assert(sizeof(Constants) == 208);
+void Transition(ID3D12GraphicsCommandList* list, ID3D12Resource* resource,
+                D3D12_RESOURCE_STATES before, D3D12_RESOURCE_STATES after) {
+  D3D12_RESOURCE_BARRIER b{};
+  b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  b.Transition = {resource, D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES, before,
+                  after};
+  list->ResourceBarrier(1, &b);
+}
+bool Buffer(ID3D12Device* device, uint64_t bytes, D3D12_HEAP_TYPE type,
+            D3D12_RESOURCE_STATES state, ComPtr<ID3D12Resource>& result,
+            bool uav = false) {
+  D3D12_RESOURCE_DESC d{};
+  d.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+  d.Width = bytes;
+  d.Height = d.DepthOrArraySize = d.MipLevels = d.SampleDesc.Count = 1;
+  d.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+  d.Flags = uav ? D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS
+                : D3D12_RESOURCE_FLAG_NONE;
+  D3D12_HEAP_PROPERTIES h{};
+  h.Type = type;
+  return SUCCEEDED(device->CreateCommittedResource(
+      &h, D3D12_HEAP_FLAG_NONE, &d, state, nullptr, IID_PPV_ARGS(&result)));
+}
+bool CameraMatches(const SsxGeometryDraw& draw, const SsxFrameMetadata& f) {
+  return draw.world_to_clip == f.world_to_clip_candidate &&
+         draw.viewport == f.guest_viewport_xy && draw.vertex_endian == 2 &&
+         draw.index_endian == 1;
+}
+}  // namespace
+
+bool SsxGeometry::Prepare(ID3D12Device* device) {
+  if (buffer) return true;
+  if (!Buffer(device, kCapacity, D3D12_HEAP_TYPE_DEFAULT,
+              GuestInputTexture::kReadState, buffer))
+    return false;
+  buffer->SetName(L"SSX captured deformed rider geometry");
+  return true;
+}
+
+bool SsxNativeMotion::Initialize(const D3D12Provider& provider) {
+  if (pipeline_) return true;
+  if (unavailable_) return false;
+  unavailable_ = true;
+  D3D12_DESCRIPTOR_RANGE range{D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 1, 2, 0, 0};
+  D3D12_ROOT_PARAMETER params[5]{};
+  params[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+  params[0].Constants = {0, 0, sizeof(Constants) / 4};
+  params[1].ParameterType = params[2].ParameterType =
+      D3D12_ROOT_PARAMETER_TYPE_SRV;
+  params[1].Descriptor.ShaderRegister = 0;
+  params[2].Descriptor.ShaderRegister = 1;
+  params[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+  params[3].DescriptorTable = {1, &range};
+  params[4].ParameterType = D3D12_ROOT_PARAMETER_TYPE_UAV;
+  params[4].Descriptor.ShaderRegister = 2;
+  D3D12_ROOT_SIGNATURE_DESC root_desc{};
+  root_desc.NumParameters = 5;
+  root_desc.pParameters = params;
+  root_.Attach(util::CreateRootSignature(provider, root_desc));
+  if (!root_) return false;
+  D3D12_GRAPHICS_PIPELINE_STATE_DESC d{};
+  d.pRootSignature = root_.Get();
+  d.VS = {ssx_native_motion_vs, sizeof(ssx_native_motion_vs)};
+  d.PS = {ssx_native_motion_ps, sizeof(ssx_native_motion_ps)};
+  d.SampleMask = UINT_MAX;
+  d.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+  d.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+  d.RasterizerState.DepthClipEnable = TRUE;
+  d.BlendState.IndependentBlendEnable = TRUE;
+  for (auto& rt : d.BlendState.RenderTarget)
+    rt.RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+  d.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+  d.NumRenderTargets = 2;
+  d.RTVFormats[0] = DXGI_FORMAT_R32G32_FLOAT;
+  d.RTVFormats[1] = DXGI_FORMAT_R8_UINT;
+  d.SampleDesc.Count = 1;
+  auto* device = provider.GetDevice();
+  if (FAILED(device->CreateGraphicsPipelineState(&d, IID_PPV_ARGS(&pipeline_))))
+    return false;
+  if (!Buffer(device, 32, D3D12_HEAP_TYPE_UPLOAD,
+              D3D12_RESOURCE_STATE_GENERIC_READ, zero_)) {
+    pipeline_.Reset();
+    return false;
+  }
+  void* data;
+  D3D12_RANGE empty{0, 0};
+  if (FAILED(zero_->Map(0, &empty, &data))) {
+    pipeline_.Reset();
+    return false;
+  }
+  std::memset(data, 0, 32);
+  zero_->Unmap(0, nullptr);
+  pipeline_->SetName(L"SSX experimental native rider motion");
+  unavailable_ = false;
+  return true;
+}
+
+bool SsxNativeMotion::Prepare(const D3D12Provider& provider, Slot& slot) {
+  if (slot.depth_heap) return true;
+  Slot replacement;
+  auto* device = provider.GetDevice();
+  D3D12_DESCRIPTOR_HEAP_DESC h{};
+  h.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+  h.NumDescriptors = 1;
+  h.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+  if (FAILED(device->CreateDescriptorHeap(
+          &h, IID_PPV_ARGS(&replacement.depth_heap))))
+    return false;
+  h.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV;
+  h.NumDescriptors = 2;
+  h.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_NONE;
+  if (FAILED(device->CreateDescriptorHeap(
+          &h, IID_PPV_ARGS(&replacement.rtv_heap))) ||
+      !Buffer(device, 32, D3D12_HEAP_TYPE_DEFAULT,
+              D3D12_RESOURCE_STATE_COPY_DEST, replacement.counters, true) ||
+      !Buffer(device, 32, D3D12_HEAP_TYPE_READBACK,
+              D3D12_RESOURCE_STATE_COPY_DEST, replacement.readback))
+    return false;
+  slot = std::move(replacement);
+  return true;
+}
+void SsxNativeMotion::ReadDiagnostics(Slot& slot) {
+  if (!slot.pending) return;
+  slot.pending = false;
+  const uint32_t* values;
+  D3D12_RANGE range{0, 16};
+  if (FAILED(slot.readback->Map(
+          0, &range,
+          reinterpret_cast<void**>(const_cast<uint32_t**>(&values)))))
+    return;
+  float motion, displacement;
+  std::memcpy(&motion, values + 2, 4);
+  std::memcpy(&displacement, values + 3, 4);
+  REXGPU_INFO(
+      "SSX_NATIVE_GPU frame={} fragments={} moving={} max_pixels={} "
+      "max_world_delta={} coverage=observed_rider_prototype dlss_ready=false",
+      slot.frame, values[0], values[1], motion, displacement);
+  D3D12_RANGE empty{0, 0};
+  slot.readback->Unmap(0, &empty);
+}
+
+bool SsxNativeMotion::RequestCapture(const std::filesystem::path& directory) {
+  if (directory.empty() || !capture_.directory.empty()) return false;
+  std::error_code error;
+  if (std::filesystem::exists(directory, error) || error) return false;
+  capture_.directory = directory;
+  return true;
+}
+
+void SsxNativeMotion::RecordCapture(ID3D12Device* device,
+                                    ID3D12GraphicsCommandList* list,
+                                    const SsxCameraMotion::Result& camera,
+                                    const Slot& slot) {
+  if (capture_.directory.empty() || capture_.readback) return;
+  struct TextureCopy {
+    ID3D12Resource* resource;
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint;
+  };
+  std::vector<TextureCopy> copies;
+  capture_.parts.clear();
+  capture_.bytes = 0;
+  ID3D12Resource* resources[] = {
+      camera.vectors, camera.validity,
+      slot.current->textures[size_t(SsxInput::kResolvedDepth)].resource.Get(),
+      slot.current->textures[size_t(SsxInput::kEncodedColor)].resource.Get()};
+  const char* names[] = {"motion.bin", "validity.bin", "depth.bin",
+                         "color.bin"};
+  for (size_t i = 0; i < 4; ++i) {
+    if (!resources[i]) continue;
+    const auto desc = resources[i]->GetDesc();
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp{};
+    UINT rows;
+    UINT64 row_bytes, total;
+    const auto offset = (capture_.bytes + 511) & ~uint64_t(511);
+    device->GetCopyableFootprints(&desc, 0, 1, offset, &fp, &rows, &row_bytes,
+                                  &total);
+    // Compute the end from the returned footprint, independent of whether the
+    // API total includes base alignment. Padding never reaches the output
+    // files.
+    capture_.bytes = fp.Offset + uint64_t(fp.Footprint.RowPitch) * rows;
+    capture_.parts.push_back(
+        {names[i], fp.Offset, row_bytes, rows, fp.Footprint.RowPitch});
+    copies.push_back({resources[i], fp});
+  }
+  const SsxGeometry* geometry[] = {&slot.current->geometry,
+                                   &slot.previous->geometry};
+  for (size_t i = 0; i < 2; ++i) {
+    capture_.bytes = (capture_.bytes + 511) & ~uint64_t(511);
+    capture_.parts.push_back(
+        {i ? "previous-geometry.bin" : "current-geometry.bin", capture_.bytes,
+         geometry[i]->bytes, 1, geometry[i]->bytes});
+    capture_.bytes += geometry[i]->bytes;
+  }
+  if (!Buffer(device, capture_.bytes, D3D12_HEAP_TYPE_READBACK,
+              D3D12_RESOURCE_STATE_COPY_DEST, capture_.readback)) {
+    REXGPU_WARN("SSX_NATIVE_CAPTURE failed to allocate readback");
+    capture_ = {};
+    return;
+  }
+  for (const auto& copy : copies) {
+    D3D12_TEXTURE_COPY_LOCATION source{}, destination{};
+    source.pResource = copy.resource;
+    source.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    destination.pResource = capture_.readback.Get();
+    destination.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    destination.PlacedFootprint = copy.footprint;
+    Transition(list, copy.resource, GuestInputTexture::kReadState,
+               D3D12_RESOURCE_STATE_COPY_SOURCE);
+    list->CopyTextureRegion(&destination, 0, 0, 0, &source, nullptr);
+    Transition(list, copy.resource, D3D12_RESOURCE_STATE_COPY_SOURCE,
+               GuestInputTexture::kReadState);
+  }
+  for (size_t i = 0; i < 2; ++i) {
+    auto* resource = geometry[i]->buffer.Get();
+    Transition(list, resource, GuestInputTexture::kReadState,
+               D3D12_RESOURCE_STATE_COPY_SOURCE);
+    list->CopyBufferRegion(capture_.readback.Get(),
+                           capture_.parts[copies.size() + i].offset, resource,
+                           0, geometry[i]->bytes);
+    Transition(list, resource, D3D12_RESOURCE_STATE_COPY_SOURCE,
+               GuestInputTexture::kReadState);
+  }
+  capture_.current = slot.current;
+  capture_.previous = slot.previous;
+  capture_.submission = slot.submission;
+  capture_.width = camera.plan.constants.width;
+  capture_.height = camera.plan.constants.height;
+  REXGPU_INFO("SSX_NATIVE_CAPTURE queued frame={} previous={} bytes={}",
+              capture_.current->metadata.guest_frame,
+              capture_.previous->metadata.guest_frame, capture_.bytes);
+}
+
+void SsxNativeMotion::ReadCapture(uint64_t completed) {
+  if (!capture_.readback || capture_.submission > completed) return;
+  auto captured = std::move(capture_);
+  capture_ = {};
+  void* data;
+  D3D12_RANGE range{0, size_t(captured.bytes)};
+  if (FAILED(captured.readback->Map(0, &range, &data))) {
+    REXGPU_WARN("SSX_NATIVE_CAPTURE readback map failed");
+    return;
+  }
+  try {
+    // Never replace an earlier capture. metadata.json is the completion marker.
+    if (!std::filesystem::create_directories(captured.directory))
+      throw std::runtime_error("capture directory already exists");
+    for (const auto& part : captured.parts) {
+      std::ofstream file;
+      file.exceptions(std::ios::badbit | std::ios::failbit);
+      file.open(captured.directory / part.name, std::ios::binary);
+      for (uint32_t row = 0; row < part.rows; ++row)
+        file.write(static_cast<const char*>(data) + part.offset +
+                       uint64_t(row) * part.pitch,
+                   std::streamsize(part.row_bytes));
+      file.close();
+    }
+    std::ofstream json;
+    json.exceptions(std::ios::badbit | std::ios::failbit);
+    json.open(captured.directory / "metadata.partial");
+    json << std::setprecision(9);
+    const auto array = [&json](const auto& values) {
+      json << '[';
+      for (size_t i = 0; i < values.size(); ++i)
+        json << (i ? "," : "") << values[i];
+      json << ']';
+    };
+    const auto frame = [&](const SsxFrameInputs& input) {
+      const auto& m = input.metadata;
+      json << "{\"frame\":" << m.guest_frame
+           << ",\"scene_width\":" << m.scene_width
+           << ",\"scene_height\":" << m.scene_height
+           << ",\"scale_x\":" << m.scale_x << ",\"scale_y\":" << m.scale_y
+           << ",\"camera\":";
+      array(m.world_to_clip_candidate);
+      json << ",\"viewport\":";
+      array(m.guest_viewport_xy);
+      json << ",\"draws\":[";
+      for (uint32_t i = 0; i < input.geometry.count; ++i) {
+        const auto& d = input.geometry.draws[i];
+        json << (i ? "," : "") << "{\"shader\":\"" << std::hex << d.shader
+             << std::dec << "\",\"vertex_address\":" << d.vertex_address
+             << ",\"index_address\":" << d.index_address
+             << ",\"vertex_offset\":" << d.vertex_offset
+             << ",\"index_offset\":" << d.index_offset
+             << ",\"vertex_count\":" << d.vertex_count
+             << ",\"index_count\":" << d.index_count
+             << ",\"vertex_endian\":" << d.vertex_endian
+             << ",\"index_endian\":" << d.index_endian << ",\"camera\":";
+        array(d.world_to_clip);
+        json << ",\"viewport\":";
+        array(d.viewport);
+        json << '}';
+      }
+      json << "]}";
+    };
+    json << "{\"version\":1,\"width\":" << captured.width
+         << ",\"height\":" << captured.height
+         << ",\"motion_format\":\"R32G32_FLOAT\",\"validity_format\":\"R8_"
+            "UINT\","
+            "\"depth_format\":\"R32_FLOAT\",\"color_format\":"
+         << unsigned(captured.current->textures[size_t(SsxInput::kEncodedColor)]
+                         .view_format)
+         << ",\"current\":";
+    frame(*captured.current);
+    json << ",\"previous\":";
+    frame(*captured.previous);
+    json << ",\"files\":[";
+    for (size_t i = 0; i < captured.parts.size(); ++i) {
+      const auto& part = captured.parts[i];
+      json << (i ? "," : "") << "{\"name\":\"" << part.name
+           << "\",\"row_bytes\":" << part.row_bytes << ",\"rows\":" << part.rows
+           << '}';
+    }
+    json << "]}";
+    json.close();
+    std::filesystem::rename(captured.directory / "metadata.partial",
+                            captured.directory / "metadata.json");
+    REXGPU_INFO("SSX_NATIVE_CAPTURE complete frame={} directory={}",
+                captured.current->metadata.guest_frame,
+                captured.directory.string());
+  } catch (const std::exception& error) {
+    REXGPU_WARN("SSX_NATIVE_CAPTURE write failed: {}", error.what());
+  }
+  D3D12_RANGE empty{0, 0};
+  captured.readback->Unmap(0, &empty);
+}
+
+SsxNativeMotion::Result SsxNativeMotion::Record(
+    const D3D12Provider& provider, ID3D12GraphicsCommandList* list,
+    const std::shared_ptr<const SsxFrameInputs>& frame,
+    const SsxCameraMotion::Result& camera, uint64_t submission,
+    uint64_t completed) {
+  Result result;
+  ReadCapture(completed);
+  for (auto& slot : slots_)
+    if (slot.submission <= completed) {
+      ReadDiagnostics(slot);
+      slot.current.reset();
+      slot.previous.reset();
+    }
+  if (!frame || !camera.plan.usable || !camera.vectors || !camera.validity) {
+    Reset();
+    return result;
+  }
+  result.captured = frame->geometry.count;
+  result.rejected = frame->geometry.rejected;
+  if (camera.plan.repeated) return result;
+  auto previous = previous_;
+  previous_ = frame;
+  if (camera.plan.constants.reset || !previous ||
+      previous->metadata.guest_frame != camera.plan.previous_frame ||
+      !frame->geometry.buffer || !previous->geometry.buffer)
+    return result;
+  const auto& current_geometry = frame->geometry;
+  const auto& previous_geometry = previous->geometry;
+  std::array<std::pair<uint32_t, uint32_t>, SsxGeometry::kMaxDraws> pairs{};
+  for (uint32_t i = 0; i < current_geometry.count; ++i) {
+    const auto& draw = current_geometry.draws[i];
+    const int match = previous_geometry.UniqueMatch(draw);
+    if (current_geometry.UniqueMatch(draw) != int(i) || match < 0 ||
+        !CameraMatches(draw, frame->metadata) ||
+        !CameraMatches(previous_geometry.draws[match], previous->metadata)) {
+      ++result.rejected;
+      continue;
+    }
+    pairs[result.matched++] = {i, uint32_t(match)};
+  }
+  if (!result.matched || !Initialize(provider)) return result;
+  Slot* chosen = nullptr;
+  for (auto& slot : slots_)
+    if (slot.submission <= completed) {
+      chosen = &slot;
+      break;
+    }
+  if (!chosen || !Prepare(provider, *chosen)) return result;
+  auto& slot = *chosen;
+  auto* device = provider.GetDevice();
+  auto depth = frame->textures[size_t(SsxInput::kResolvedDepth)].resource.Get();
+  D3D12_SHADER_RESOURCE_VIEW_DESC srv{};
+  srv.Format = DXGI_FORMAT_R32_FLOAT;
+  srv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+  srv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+  srv.Texture2D.MipLevels = 1;
+  device->CreateShaderResourceView(
+      depth, &srv, slot.depth_heap->GetCPUDescriptorHandleForHeapStart());
+  std::array<D3D12_CPU_DESCRIPTOR_HANDLE, 2> rtvs{};
+  rtvs[0] = slot.rtv_heap->GetCPUDescriptorHandleForHeapStart();
+  rtvs[1].ptr = rtvs[0].ptr + device->GetDescriptorHandleIncrementSize(
+                                  D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+  device->CreateRenderTargetView(camera.vectors, nullptr, rtvs[0]);
+  device->CreateRenderTargetView(camera.validity, nullptr, rtvs[1]);
+  Transition(list, camera.vectors, GuestInputTexture::kReadState,
+             D3D12_RESOURCE_STATE_RENDER_TARGET);
+  Transition(list, camera.validity, GuestInputTexture::kReadState,
+             D3D12_RESOURCE_STATE_RENDER_TARGET);
+  list->CopyBufferRegion(slot.counters.Get(), 0, zero_.Get(), 0, 32);
+  Transition(list, slot.counters.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+             D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  ID3D12DescriptorHeap* heaps[] = {slot.depth_heap.Get()};
+  list->SetDescriptorHeaps(1, heaps);
+  list->SetGraphicsRootSignature(root_.Get());
+  list->SetPipelineState(pipeline_.Get());
+  list->SetGraphicsRootShaderResourceView(
+      1, current_geometry.buffer->GetGPUVirtualAddress());
+  list->SetGraphicsRootShaderResourceView(
+      2, previous_geometry.buffer->GetGPUVirtualAddress());
+  list->SetGraphicsRootDescriptorTable(
+      3, slot.depth_heap->GetGPUDescriptorHandleForHeapStart());
+  list->SetGraphicsRootUnorderedAccessView(
+      4, slot.counters->GetGPUVirtualAddress());
+  list->OMSetRenderTargets(2, rtvs.data(), FALSE, nullptr);
+  const auto& f = frame->metadata;
+  const auto& p = previous->metadata;
+  const uint32_t width = camera.plan.constants.width,
+                 height = camera.plan.constants.height;
+  const D3D12_VIEWPORT vp{0, 0, float(width), float(height), 0, 1};
+  const D3D12_RECT scissor{0, 0, LONG(width), LONG(height)};
+  list->RSSetViewports(1, &vp);
+  list->RSSetScissorRects(1, &scissor);
+  list->IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+  for (uint32_t i = 0; i < result.matched; ++i) {
+    const auto& current_draw = current_geometry.draws[pairs[i].first];
+    const auto& previous_draw = previous_geometry.draws[pairs[i].second];
+    Constants c{};
+    c.current_camera = current_draw.world_to_clip;
+    c.previous_camera = previous_draw.world_to_clip;
+    const auto& v = current_draw.viewport;
+    const auto& pv = previous_draw.viewport;
+    c.current_viewport = {2 * v[0] / f.scene_width, -2 * v[1] / f.scene_height,
+                          2 * v[2] / f.scene_width - 1,
+                          1 - 2 * v[3] / f.scene_height};
+    c.previous_viewport = {pv[0] * p.scale_x, pv[1] * p.scale_y,
+                           pv[2] * p.scale_x, pv[3] * p.scale_y};
+    c.offsets = {current_draw.vertex_offset, previous_draw.vertex_offset,
+                 current_draw.index_offset, previous_draw.index_offset};
+    c.counts = {current_draw.vertex_count, current_draw.index_count, 0, 0};
+    c.size = {width, height, 0, 0};
+    list->SetGraphicsRoot32BitConstants(0, sizeof(c) / 4, &c, 0);
+    list->DrawInstanced(current_draw.index_count, 1, 0, 0);
+  }
+  list->OMSetRenderTargets(0, nullptr, FALSE, nullptr);
+  Transition(list, camera.vectors, D3D12_RESOURCE_STATE_RENDER_TARGET,
+             GuestInputTexture::kReadState);
+  Transition(list, camera.validity, D3D12_RESOURCE_STATE_RENDER_TARGET,
+             GuestInputTexture::kReadState);
+  Transition(list, slot.counters.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+             D3D12_RESOURCE_STATE_COPY_SOURCE);
+  if (!last_readback_ || camera.plan.frame - last_readback_ >= 120) {
+    list->CopyBufferRegion(slot.readback.Get(), 0, slot.counters.Get(), 0, 32);
+    slot.pending = true;
+    slot.frame = camera.plan.frame;
+    last_readback_ = camera.plan.frame;
+  }
+  Transition(list, slot.counters.Get(), D3D12_RESOURCE_STATE_COPY_SOURCE,
+             D3D12_RESOURCE_STATE_COPY_DEST);
+  slot.current = frame;
+  slot.previous = previous;
+  slot.submission = submission;
+  if (!capture_triggered_) {
+    const double seconds =
+        std::chrono::duration<double>(
+            std::chrono::steady_clock::now().time_since_epoch())
+            .count();
+    const auto& directory = REXCVAR_GET(d3d12_ssx_native_capture_path);
+    if (!directory.empty() && seconds >= capture_poll_seconds_) {
+      capture_poll_seconds_ = seconds + .25;
+      const auto root = std::filesystem::u8path(directory);
+      std::error_code error;
+      if (std::filesystem::is_regular_file(root / "capture.request", error)) {
+        capture_triggered_ = true;
+        if (!RequestCapture(root /
+                            ("frame-" + std::to_string(camera.plan.frame))))
+          REXGPU_WARN("SSX_NATIVE_CAPTURE request rejected");
+      }
+    }
+  }
+  RecordCapture(device, list, camera, slot);
+  result.drawn = true;
+  return result;
+}
+}  // namespace rex::ui::d3d12
