+std::shared_ptr<Streamline::Frame> Streamline::AcquireRenderToken(uint64_t render_id) {
+  std::lock_guard lock(api_mutex_);
+#if REX_HAS_STREAMLINE
+  if (!impl_->attached || !render_id || impl_->fg_active || impl_->reflex_mode != ReflexMode::kOff)
+    return nullptr;
+  for (auto& weak : impl_->full_tokens)
+    if (auto pending = weak.lock(); pending && pending->phase != 6)
+      return nullptr;
+  auto& slot = impl_->render_tokens[impl_->render_token_slot];
+  RetireRenderToken(slot);
+  slot.reset();
+  auto frame = std::make_shared<Frame>();
+  if (!Check(impl_->frame_token(frame->token, nullptr), "SSX ordered render token") ||
+      !frame->token)
+    return nullptr;
+  frame->owner = this;
+  frame->token_id = uint32_t(*frame->token);
+  frame->phase = 3;
+  frame->render_only = true;
+  frame->render_id = render_id;
+  slot = frame;
+  impl_->render_token_slot = (impl_->render_token_slot + 1) % impl_->render_tokens.size();
+  GuestFrameTiming::Get().Add(GuestFrameTiming::Event::kNvidiaTokenCreated, render_id,
+                              frame->token_id);
+  return frame;
+#else
+  (void)render_id;
+  return nullptr;
+#endif
+}
+
+void Streamline::RetireRenderToken(const std::shared_ptr<Frame>& frame) {
+  std::lock_guard lock(api_mutex_);
+#if REX_HAS_STREAMLINE
+  if (!frame || frame->owner != this || !frame->render_only || frame->phase == 6)
+    return;
+  frame->phase = 6;
+  GuestFrameTiming::Get().Add(GuestFrameTiming::Event::kNvidiaTokenDropped, frame->render_id,
+                              frame->token_id);
+#else
+  (void)frame;
+#endif
+}
