+Streamline::TokenPresentation Streamline::PresentRenderToken(
+    const std::shared_ptr<Frame>& frame, const std::function<HRESULT()>& present) {
+  std::lock_guard lock(api_mutex_);
+  TokenPresentation result;
+  if (!present)
+    return result;
+#if REX_HAS_STREAMLINE
+  const bool owned = impl_->attached && frame && frame->owner == this && frame->render_only;
+  if (owned) {
+    result.render_id = frame->render_id;
+    result.token_id = frame->token_id;  // cached; never dereference a retired SL slot
+    result.matched = frame->phase == 3 && frame->sr_evaluated && frame->token &&
+                     uint32_t(*frame->token) == frame->token_id;
+    if (!result.matched && frame->phase != 6)
+      RetireRenderToken(frame);
+  }
+  // Keep options, evaluation, token allocation and the actual Present serialized.
+  // No fabricated PCL simulation/render markers are issued by this adapter.
+  result.result = present();
+  if (result.matched) {
