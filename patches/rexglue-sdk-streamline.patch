@@ -0,0 +1,64 @@
+// Optional NVIDIA Streamline connection. No NVIDIA headers in the public ABI.
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <string>
+
+#include <rex/ui/d3d12/d3d12_api.h>
+
+namespace rex::ui::d3d12 {
+
+// This checkpoint connects the real SDK and presentation hooks, but deliberately
+// does not enable SR or FG without a game-specific temporal resource producer.
+class Streamline {
+ public:
+  enum class Quality { kQuality, kBalanced, kPerformance, kUltraPerformance, kDLAA };
+
+  struct Support {
+    bool sr = false;
+    bool fg = false;
+    bool reflex = false;
+    bool pcl = false;
+    bool low_latency_available = false;
+    uint32_t max_generated_frames = 0;
+    std::string sr_result;
+    std::string fg_result;
+    std::string reflex_result;
+    std::string pcl_result;
+  };
+
+  struct OptimalSettings {
+    uint32_t width = 0, height = 0;
+    uint32_t min_width = 0, min_height = 0;
+    uint32_t max_width = 0, max_height = 0;
+  };
+
+  // The directory must contain the signed production DLLs of Streamline 2.14.1.
+  // Failure is optional: the caller continues with the normal D3D12 renderer.
+  static std::unique_ptr<Streamline> Create(const std::filesystem::path& binary_directory);
+  ~Streamline();
+  Streamline(const Streamline&) = delete;
+  Streamline& operator=(const Streamline&) = delete;
+
+  // Before any command queues or swap chains are created. Upgrades both COM
+  // references transactionally; on failure the original interfaces are restored.
+  bool Attach(ID3D12Device*& device, IDXGIFactory2*& factory);
+  const Support& support() const { return support_; }
+  bool GetOptimalSettings(Quality quality, uint32_t output_width, uint32_t output_height,
+                          OptimalSettings& settings);
+
+  // Caller must first drain GPU work. Shut down before releasing the device and
+  // factory; destroy this object only AFTER releasing every Streamline COM proxy.
+  void Shutdown();
+
+ private:
+  struct Impl;
+  Streamline();
+  bool Initialize(const std::filesystem::path& binary_directory);
+  std::unique_ptr<Impl> impl_;
+  Support support_;
+};
+
+}  // namespace rex::ui::d3d12
