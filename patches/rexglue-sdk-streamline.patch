diff --git a/src/ui/d3d12/streamline.cpp b/src/ui/d3d12/streamline.cpp
new file mode 100644
index 0000000..9c7a1a0
--- /dev/null
+++ b/src/ui/d3d12/streamline.cpp
@@ -0,0 +1,288 @@
+#include <rex/ui/d3d12/streamline.h>
+
+#include <bit>
+#include <utility>
+
+#include <rex/logging.h>
+
+#if REX_HAS_STREAMLINE
+#include <sl.h>
+#include <sl_dlss.h>
+#include <sl_dlss_g.h>
+#include <sl_helpers.h>
+#include <sl_pcl.h>
+#include <sl_reflex.h>
+#include <sl_security.h>
+
+static_assert(SL_VERSION_MAJOR == 2 && SL_VERSION_MINOR == 14 && SL_VERSION_PATCH == 1,
+              "This integration is pinned to Streamline 2.14.1");
+#endif
+
+namespace rex::ui::d3d12 {
+
+#if REX_HAS_STREAMLINE
+namespace {
+void LogStreamline(sl::LogType type, const char* message) {
+  if (type == sl::LogType::eError) {
+    REXGPU_ERROR("Streamline: {}", message);
+  } else if (type == sl::LogType::eWarn) {
+    REXGPU_WARN("Streamline: {}", message);
+  } else {
+    REXGPU_INFO("Streamline: {}", message);
+  }
+}
+
+bool Check(sl::Result result, const char* operation) {
+  if (result == sl::Result::eOk)
+    return true;
+  REXGPU_WARN("Streamline {} failed: {}", operation, sl::getResultAsStr(result));
+  return false;
+}
+}  // namespace
+
+struct Streamline::Impl {
+  HMODULE module = nullptr;
+  bool init_called = false;
+  bool attached = false;
+  PFun_slInit* init = nullptr;
+  PFun_slShutdown* shutdown = nullptr;
+  PFun_slSetD3DDevice* set_device = nullptr;
+  PFun_slUpgradeInterface* upgrade = nullptr;
+  PFun_slIsFeatureSupported* is_supported = nullptr;
+  PFun_slGetFeatureFunction* get_function = nullptr;
+  PFun_slDLSSGetOptimalSettings* optimal = nullptr;
+  PFun_slDLSSGGetState* fg_state = nullptr;
+  PFun_slDLSSGSetOptions* fg_options = nullptr;
+  PFun_slReflexGetState* reflex_state = nullptr;
+  PFun_slReflexSetOptions* reflex_options = nullptr;
+
+  // The provider releases its COM proxies before destroying this Impl.
+  ~Impl() {
+    if (module)
+      FreeLibrary(module);
+  }
+
+  template <typename T>
+  bool Import(T*& function, const char* name) {
+    function = std::bit_cast<T*>(GetProcAddress(module, name));
+    if (!function)
+      REXGPU_WARN("Streamline export missing: {}", name);
+    return function != nullptr;
+  }
+
+  template <typename T>
+  bool ImportFeature(T*& function, sl::Feature feature, const char* name) {
+    void* address = nullptr;
+    if (!Check(get_function(feature, name, address), name))
+      return false;
+    function = reinterpret_cast<T*>(address);
+    return function != nullptr;
+  }
+};
+#else
+struct Streamline::Impl {};
+#endif
+
+Streamline::Streamline() : impl_(std::make_unique<Impl>()) {}
+Streamline::~Streamline() {
+  Shutdown();
+}
+
+std::unique_ptr<Streamline> Streamline::Create(const std::filesystem::path& directory) {
+  std::unique_ptr<Streamline> result(new Streamline);
+  if (!result->Initialize(directory))
+    return nullptr;
+  return result;
+}
+
+bool Streamline::Initialize(const std::filesystem::path& directory) {
+#if REX_HAS_STREAMLINE
+  std::error_code error;
+  const auto absolute_directory = std::filesystem::absolute(directory, error);
+  if (error || directory.empty()) {
+    REXGPU_WARN("Streamline requires an explicit DLL directory");
+    return false;
+  }
+  const auto interposer = absolute_directory / L"sl.interposer.dll";
+  if (!std::filesystem::is_regular_file(interposer, error)) {
+    REXGPU_WARN("Streamline interposer not found: {}", interposer.string());
+    return false;
+  }
+  if (!sl::security::verifyEmbeddedSignature(interposer.c_str())) {
+    REXGPU_WARN("Streamline NVIDIA signature verification failed: {}", interposer.string());
+    return false;
+  }
+  impl_->module = LoadLibraryExW(interposer.c_str(), nullptr,
+                                 LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_SYSTEM32);
+  if (!impl_->module) {
+    REXGPU_WARN("Streamline load failed: Windows error {}", GetLastError());
+    return false;
+  }
+  if (!impl_->Import(impl_->init, "slInit") || !impl_->Import(impl_->shutdown, "slShutdown") ||
+      !impl_->Import(impl_->set_device, "slSetD3DDevice") ||
+      !impl_->Import(impl_->upgrade, "slUpgradeInterface") ||
+      !impl_->Import(impl_->is_supported, "slIsFeatureSupported") ||
+      !impl_->Import(impl_->get_function, "slGetFeatureFunction"))
+    return false;
+
+  const wchar_t* plugin_paths[] = {absolute_directory.c_str()};
+  const sl::Feature features[] = {sl::kFeatureDLSS, sl::kFeatureDLSS_G, sl::kFeatureReflex,
+                                  sl::kFeaturePCL};
+  sl::Preferences preferences{};
+  preferences.pathsToPlugins = plugin_paths;
+  preferences.numPathsToPlugins = 1;
+  preferences.featuresToLoad = features;
+  preferences.numFeaturesToLoad = uint32_t(std::size(features));
+  preferences.renderAPI = sl::RenderAPI::eD3D12;
+  preferences.engine = sl::EngineType::eCustom;
+  preferences.engineVersion = "ReXGlue-0.10.0-SSX";
+  // Development project identity, not an NVIDIA-issued application ID.
+  preferences.projectId = "850f4edf-03bc-4a15-96e2-ea9dc09a812f";
+  preferences.flags = sl::PreferenceFlags::eDisableCLStateTracking |
+                      sl::PreferenceFlags::eUseManualHooking |
+                      sl::PreferenceFlags::eUseDXGIFactoryProxy |
+                      sl::PreferenceFlags::eUseFrameBasedResourceTagging;
+  preferences.logMessageCallback = LogStreamline;
+  // No OTA/downloaded plugins: keep binaries consistent with the pinned headers.
+  impl_->init_called = true;
+  return Check(impl_->init(preferences, sl::kSDKVersion), "slInit");
+#else
+  (void)directory;
+  REXGPU_WARN("Streamline requested, but this SDK was built without REXGLUE_ENABLE_STREAMLINE");
+  return false;
+#endif
+}
+
+bool Streamline::Attach(ID3D12Device*& device, IDXGIFactory2*& factory) {
+#if REX_HAS_STREAMLINE
+  if (!impl_->init_called || impl_->attached || !device || !factory)
+    return false;
+  if (!Check(impl_->set_device(device), "slSetD3DDevice"))
+    return false;
+  LUID luid = device->GetAdapterLuid();
+  sl::AdapterInfo adapter{};
+  adapter.deviceLUID = reinterpret_cast<uint8_t*>(&luid);
+  adapter.deviceLUIDSizeInBytes = sizeof(luid);
+  auto query = [&](sl::Feature feature, std::string& description) {
+    auto result = impl_->is_supported(feature, adapter);
+    description = sl::getResultAsStr(result);
+    return result == sl::Result::eOk;
+  };
+  support_.sr = query(sl::kFeatureDLSS, support_.sr_result);
+  support_.fg = query(sl::kFeatureDLSS_G, support_.fg_result);
+  support_.reflex = query(sl::kFeatureReflex, support_.reflex_result);
+  support_.pcl = query(sl::kFeaturePCL, support_.pcl_result);
+  REXGPU_INFO("Streamline support: SR={}, FG={}, Reflex={}, PCL={}", support_.sr_result,
+              support_.fg_result, support_.reflex_result, support_.pcl_result);
+  if (!support_.sr && !support_.fg) {
+    REXGPU_WARN("Streamline has no supported DLSS feature on the selected adapter");
+    return false;
+  }
+
+  if (support_.sr &&
+      !impl_->ImportFeature(impl_->optimal, sl::kFeatureDLSS, "slDLSSGetOptimalSettings"))
+    return false;
+  if (support_.fg) {
+    if (!impl_->ImportFeature(impl_->fg_options, sl::kFeatureDLSS_G, "slDLSSGSetOptions") ||
+        !impl_->ImportFeature(impl_->fg_state, sl::kFeatureDLSS_G, "slDLSSGGetState"))
+      return false;
+    const sl::DLSSGOptions options{};  // Off until valid SSX frame inputs exist.
+    if (!Check(impl_->fg_options(sl::ViewportHandle(0), options), "FG off"))
+      return false;
+    sl::DLSSGState state{};
+    if (Check(impl_->fg_state(sl::ViewportHandle(0), state, nullptr), "FG capabilities")) {
+      support_.max_generated_frames = state.numFramesToGenerateMax;
+    }
+  }
+  if (support_.reflex) {
+    if (!impl_->ImportFeature(impl_->reflex_options, sl::kFeatureReflex, "slReflexSetOptions") ||
+        !impl_->ImportFeature(impl_->reflex_state, sl::kFeatureReflex, "slReflexGetState")) {
+      return false;
+    }
+    const sl::ReflexOptions options{};  // Must initialize even while disabled.
+    if (!Check(impl_->reflex_options(options), "Reflex off"))
+      return false;
+    sl::ReflexState state{};
+    if (Check(impl_->reflex_state(state), "Reflex capabilities")) {
+      support_.low_latency_available = state.lowLatencyAvailable;
+    }
+  }
+  // Retain originals so a partially failed upgrade can restore both references.
+  Microsoft::WRL::ComPtr<ID3D12Device> original_device(device);
+  Microsoft::WRL::ComPtr<IDXGIFactory2> original_factory(factory);
+  void* upgraded_device = device;
+  void* upgraded_factory = factory;
+  const bool upgraded = Check(impl_->upgrade(&upgraded_device), "device proxy") &&
+                        Check(impl_->upgrade(&upgraded_factory), "factory proxy");
+  device = static_cast<ID3D12Device*>(upgraded_device);
+  factory = static_cast<IDXGIFactory2*>(upgraded_factory);
+  if (!upgraded) {
+    device->Release();
+    factory->Release();
+    device = original_device.Detach();
+    factory = original_factory.Detach();
+    return false;
+  }
+  impl_->attached = true;
+  REXGPU_INFO("Streamline 2.14.1 presentation connected; SR/FG/Reflex remain off");
+  return true;
+#else
+  (void)device;
+  (void)factory;
+  return false;
+#endif
+}
+
+bool Streamline::GetOptimalSettings(Quality quality, uint32_t width, uint32_t height,
+                                    OptimalSettings& settings) {
+  settings = {};
+#if REX_HAS_STREAMLINE
+  if (!impl_->attached || !support_.sr || !impl_->optimal || !width || !height)
+    return false;
+  sl::DLSSOptions options{};
+  switch (quality) {
+    case Quality::kQuality:
+      options.mode = sl::DLSSMode::eMaxQuality;
+      break;
+    case Quality::kBalanced:
+      options.mode = sl::DLSSMode::eBalanced;
+      break;
+    case Quality::kPerformance:
+      options.mode = sl::DLSSMode::eMaxPerformance;
+      break;
+    case Quality::kUltraPerformance:
+      options.mode = sl::DLSSMode::eUltraPerformance;
+      break;
+    case Quality::kDLAA:
+      options.mode = sl::DLSSMode::eDLAA;
+      break;
+    default:
+      return false;
+  }
+  options.outputWidth = width;
+  options.outputHeight = height;
+  sl::DLSSOptimalSettings optimal{};
+  if (!Check(impl_->optimal(options, optimal), "DLSS optimal settings"))
+    return false;
+  settings = {optimal.optimalRenderWidth, optimal.optimalRenderHeight, optimal.renderWidthMin,
+              optimal.renderHeightMin,    optimal.renderWidthMax,      optimal.renderHeightMax};
+  return settings.width != 0 && settings.height != 0;
+#else
+  (void)quality;
+  (void)width;
+  (void)height;
+  return false;
+#endif
+}
+
+void Streamline::Shutdown() {
+#if REX_HAS_STREAMLINE
+  if (impl_->init_called) {
+    Check(impl_->shutdown(), "slShutdown");
+    impl_->init_called = false;
+    impl_->attached = false;
+  }
+#endif
+}
+
+}  // namespace rex::ui::d3d12
