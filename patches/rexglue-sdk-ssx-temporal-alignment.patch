+        if (mask & (1u << c))
+          ++interpolator_writes_[out.storage_index][c];
+      if (!position_writes_)
+        before_position_[out.storage_index] = true;
+    } else {
+      invalid_ = true;
+      return;
+    }
+    for (uint32_t c = 0; c < 4; ++c)
+      if (mask & (1u << c)) {
+        auto source = uint32_t(out.components[c]);
+        (*dest)[c] = source < 4 ? values[source] : Fresh();
