diff --git a/include/rex/ui/d3d12/ssx_temporal_alignment.h b/include/rex/ui/d3d12/ssx_temporal_alignment.h
new file mode 100644
index 0000000..bec8123
--- /dev/null
+++ b/include/rex/ui/d3d12/ssx_temporal_alignment.h
@@ -0,0 +1,79 @@
+#pragma once
+#include <rex/ui/d3d12/guest_frame_inputs.h>
+
+namespace rex::ui::d3d12 {
+enum class SsxAlignmentStatus {
+  kCompatible,
+  kMissing,
+  kCamera,
+  kPassOrder,
+  kExtent,
+  kDepthView,
+  kJitterCoverage
+};
+inline const char* SsxAlignmentName(SsxAlignmentStatus status) {
+  switch (status) {
+    case SsxAlignmentStatus::kCompatible:
+      return "compatible_metadata";
+    case SsxAlignmentStatus::kMissing:
+      return "missing_or_ambiguous";
+    case SsxAlignmentStatus::kCamera:
+      return "camera_or_origin";
+    case SsxAlignmentStatus::kPassOrder:
+      return "depth_not_before_lighting";
+    case SsxAlignmentStatus::kExtent:
+      return "extent_or_subresource";
+    case SsxAlignmentStatus::kDepthView:
+      return "unsupported_depth_view";
+    case SsxAlignmentStatus::kJitterCoverage:
+      return "unknown_scene_draws";
+  }
+  return "unknown";
+}
+// Structural gate, deliberately not a proof of pixelwise alignment or all-game
+// coverage. Exact copies have origin (0,0), and the consumer must use Load at
+// the same integer texel in color/depth/motion; no output-size resampling here.
+inline SsxAlignmentStatus CheckSsxTemporalAlignment(const SsxFrameInputs& frame) {
+  const auto& f = frame.metadata;
+  const auto& c = frame.textures[size_t(SsxInput::kEncodedColor)];
+  const auto& d = frame.textures[size_t(SsxInput::kResolvedDepth)];
+  if ((f.captured_mask & 3) != 3 || ((f.failed_mask | f.duplicate_mask) & 3) || !c.resource ||
+      !d.resource)
+    return SsxAlignmentStatus::kMissing;
+  if (!f.camera_samples || f.camera_conflict || !f.camera_viewport_valid ||
+      !IsKnownSsxScene(f.scene_width, f.scene_height) ||
+      f.guest_viewport_xy[0] != .5f * f.scene_width ||
+      f.guest_viewport_xy[1] != -.5f * f.scene_height ||
+      f.guest_viewport_xy[2] != .5f * f.scene_width ||
+      f.guest_viewport_xy[3] != .5f * f.scene_height ||
+      f.guest_viewport_z != std::array<float, 2>{-1, 1})
+    return SsxAlignmentStatus::kCamera;
+  if (!f.depth_before_lighting || !f.depth_draw || f.depth_draw >= f.color_draw)
+    return SsxAlignmentStatus::kPassOrder;
+  if (!f.scale_x || !f.scale_y || c.source_mip || d.source_mip ||
+      c.width != uint64_t(f.scene_width) * f.scale_x ||
+      c.height != uint64_t(f.scene_height) * f.scale_y || c.width != d.width ||
+      c.height != d.height)
+    return SsxAlignmentStatus::kExtent;
+  if (d.view_format != DXGI_FORMAT_R32_FLOAT || d.host_swizzle || d.swizzled_signs ||
+      (d.guest_fetch[3] & (63u << 13)))
+    return SsxAlignmentStatus::kDepthView;
+  if (f.jitter_enabled && (!f.jittered_draws || f.jitter_unknown_before_color))
+    return SsxAlignmentStatus::kJitterCoverage;
+  for (float v : f.jitter_pixels)
+    if (!std::isfinite(v) || std::abs(v) > .5f || (!f.jitter_enabled && v != 0))
+      return SsxAlignmentStatus::kJitterCoverage;
+  return SsxAlignmentStatus::kCompatible;
+}
+
+// Decoded color is submitted in its native linear units, before this host path
+// applies any exposure. DLSS meters that input itself; SSX's spatial exposure
+// is retained for SSX tone mapping, never advertised as a 1x1 DLSS texture.
+struct SsxReconstructionColorPolicy {
+  static constexpr bool hdr_linear = true;
+  static constexpr bool automatic_exposure = true;
+  static constexpr float pre_exposure = 1.0f;
+  static constexpr float exposure_scale = 1.0f;
+  static ID3D12Resource* ExposureTag() { return nullptr; }
+};
+}  // namespace rex::ui::d3d12
