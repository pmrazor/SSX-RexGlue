+  bool invalid_ = false;
+  std::array<std::array<Value, 4>, 64> registers_{};
+  std::array<Value, 4> position_{};
+  std::array<std::array<Value, 4>, 16> interpolators_{};
+  std::array<std::array<uint32_t, 2>, 16> interpolator_writes_{};
+  std::array<bool, 16> before_position_{};
+};
