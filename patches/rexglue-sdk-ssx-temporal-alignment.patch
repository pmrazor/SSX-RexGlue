+#include <rex/graphics/pipeline/shader/ssx_analysis.h>
+#include <rex/graphics/pipeline/shader/shader.h>
+
+#include <array>
+#include <vector>
+
+namespace rex::graphics {
+namespace {
+// Symbolic identities track copies and overwrites, including component swizzles.
+// Projection terms only combine three input coordinates with distinct rows of
+// one audited matrix register family. Arbitrary math gets a fresh identity.
+struct Value {
+  uint32_t id = 0;
+  uint16_t constant = 0, base = 0;
+  uint8_t column = 0, rows = 0;
+  bool is_constant = false, clip_xy = false;
+  std::array<uint32_t, 3> coordinates{};
+};
+class Analyzer {
+ public:
+  SsxShaderAnalysis Run(std::span<const uint32_t> words) {
+    using namespace ucode;
+    if (words.size() < 3 || words.size() > 65536)
+      return {};
+    uint32_t bound = uint32_t(words.size() / 3);
+    for (uint32_t i = 0; i < bound; ++i) {
+      ControlFlowInstruction cf[2];
+      UnpackControlFlowInstructions(words.data() + i * 3, cf);
+      for (const auto& op : cf)
+        if (IsControlFlowOpcodeExec(op.opcode()))
+          bound = std::min(bound, op.exec.address());
+    }
+    for (auto& reg : registers_)
+      for (auto& v : reg)
+        v = Fresh();
+    VertexFetchInstruction previous{};
+    bool ended = false;
+    for (uint32_t i = 0; i < bound && !ended; ++i) {
+      ControlFlowInstruction pair[2];
+      UnpackControlFlowInstructions(words.data() + i * 3, pair);
+      for (auto& cf : pair) {
+        switch (cf.opcode()) {
+          case ControlFlowOpcode::kNop:
+          case ControlFlowOpcode::kAlloc:
+          case ControlFlowOpcode::kMarkVsFetchDone:
+            continue;
+          case ControlFlowOpcode::kExec:
+          case ControlFlowOpcode::kExecEnd:
+            break;
+          default:
+            return {};  // No guesses across branches, loops or calls.
+        }
+        ParsedExecInstruction exec;
+        ParseControlFlowExec(cf.exec, i * 2, exec);
+        if (uint64_t(exec.instruction_address + exec.instruction_count) * 3 > words.size())
+          return {};
+        auto sequence = exec.sequence;
+        for (uint32_t n = 0; n < exec.instruction_count; ++n, sequence >>= 2) {
+          auto* raw = words.data() + (exec.instruction_address + n) * 3;
+          if (sequence & 1) {
+            auto& fetch = *reinterpret_cast<const FetchInstruction*>(raw);
+            if (fetch.opcode() != FetchOpcode::kVertexFetch)
+              return {};
+            ParsedVertexFetchInstruction parsed;
+            if (ParseVertexFetchInstruction(fetch.vertex_fetch(), previous, parsed))
+              previous = fetch.vertex_fetch();
+            if (parsed.is_predicated)
+              return {};
+            std::array<Value, 4> values;
+            for (auto& v : values)
+              v = Fresh();
+            Store(parsed.result, values);
+          } else {
+            ParsedAluInstruction parsed;
+            ParseAluInstruction(*reinterpret_cast<const AluInstruction*>(raw),
+                                xenos::ShaderType::kVertex, parsed);
+            if (parsed.is_predicated)
+              return {};
+            std::array<Value, 4> vector, scalar;
+            bool any_clip = false;
+            for (uint32_t a = 0; a < parsed.vector_operand_count; ++a)
+              for (uint32_t c = 0; c < 4; ++c)
+                any_clip |= Read(parsed.vector_operands[a], c).clip_xy;
+            for (uint32_t c = 0; c < 4; ++c) {
+              const auto a = Read(parsed.vector_operands[0], c);
+              const auto b = Read(parsed.vector_operands[1], c);
+              const auto d = Read(parsed.vector_operands[2], c);
+              switch (parsed.vector_opcode) {
+                case AluVectorOpcode::kMax:
+                  vector[c] = a.id == b.id ? a : Fresh(any_clip);
+                  break;
+                case AluVectorOpcode::kMul:
+                  vector[c] = Multiply(a, b);
+                  break;
+                case AluVectorOpcode::kAdd:
+                  vector[c] = Add(a, b);
+                  break;
+                case AluVectorOpcode::kMad:
+                  vector[c] = Add(Multiply(a, b), d);
+                  break;
+                default:
+                  vector[c] = Fresh(any_clip);
+                  break;
+              }
+            }
+            bool scalar_clip = false;
+            for (uint32_t a = 0; a < parsed.scalar_operand_count; ++a)
+              for (uint32_t c = 0; c < parsed.scalar_operands[a].component_count; ++c)
+                scalar_clip |= Read(parsed.scalar_operands[a], c).clip_xy;
+            const auto scalar_value = Fresh(scalar_clip);
+            scalar.fill(scalar_value);
