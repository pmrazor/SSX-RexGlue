+TEST_CASE("SSX inverse jitter restores view rays and preserves depth", "[ssx-inputs]") {
+  // Deliberately asymmetric projective inverse, not an identity-only test.
+  const std::array<float,16> inv{2,.1f,0,.02f, -.2f,3,.1f,0, .1f,0,4,.3f, 5,6,7,1};
+  for (auto size : {std::array<uint32_t,2>{3360,1752}, {3840,2160}}) {
+    for (uint64_t phase=0;phase<16;++phase) {
+      const auto j = SsxJitterNdc(SsxJitterPixels(phase),size[0],size[1]);
+      auto patched=inv;
+      auto row=SsxJitterInverseRow(inv.data(),inv.data()+4,inv.data()+12,j);
+      std::copy(row.begin(),row.end(),patched.begin()+12);
+      for(float x : {-.9f,0.f,.8f}) for(float y : {-.7f,0.f,.6f})
+        for(float z : {0.f,.3f,1.f}) for(int c=0;c<4;++c) {
+          double expected=x*double(inv[c])+y*double(inv[4+c])+z*double(inv[8+c])+inv[12+c];
+          double actual=(x+double(j[0]))*patched[c]+(y+double(j[1]))*patched[4+c]+z*double(patched[8+c])+patched[12+c];
+          CHECK(std::abs(actual-expected)<1e-6);
+        }
+    }
+  }
+}
