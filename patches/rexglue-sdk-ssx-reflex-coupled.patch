+bool Streamline::EnableSsxReflex() {
+#if REX_HAS_STREAMLINE
+  const auto mode = GuestReflex::RequestedMode();
+  if (mode == "disabled")
+    return true;
+  if (mode != "off" && mode != "on" && mode != "boost")
+    return false;
+  if (!ConfigureReflex(mode == "on"      ? ReflexMode::kOn
+                       : mode == "boost" ? ReflexMode::kOnWithBoost
+                                         : ReflexMode::kOff))
+    return false;
+  {
+    std::lock_guard lock(api_mutex_);
+    impl_->ssx_sync_enabled = true;
+  }
+  GuestReflex::Backend backend;
+  backend.begin = [this](uint64_t worker) {
+    std::lock_guard lock(api_mutex_);
+    impl_->ssx_sync_frame = BeginFrame(worker);
+    return bool(impl_->ssx_sync_frame);
+  };
+  backend.end = [this](uint64_t worker) {
+    std::lock_guard lock(api_mutex_);
+    const auto& frame = impl_->ssx_sync_frame;
+    return frame && frame->ssx_worker_id == worker && MarkFrame(frame, Marker::kSimulationEnd);
+  };
+  backend.bind = [this](uint64_t worker, uint64_t render) {
+    std::lock_guard lock(api_mutex_);
+    const auto& frame = impl_->ssx_sync_frame;
+    if (!frame || frame->ssx_worker_id != worker || frame->phase != 2 || frame->render_id)
+      return false;
+    frame->render_id = render;
+    GuestFrameTiming::Get().Add(GuestFrameTiming::Event::kReflexBind, worker, frame->token_id,
+                                render);
+    return true;
+  };
+  backend.input = [this](uint64_t worker, bool ping, bool flash) {
+    std::lock_guard lock(api_mutex_);
+    const auto& frame = impl_->ssx_sync_frame;
+    if (!frame || frame->ssx_worker_id != worker || frame->phase != 1)
+      return;
+    if (ping)
+      MarkFrame(frame, Marker::kLatencyPing);
+    if (flash)
+      MarkFrame(frame, Marker::kInputFlash);
+    GuestFrameTiming::Get().Add(GuestFrameTiming::Event::kReflexInput, worker, frame->token_id,
+                                ping);
+  };
+  backend.cancel = [this](uint64_t worker) {
+    std::lock_guard lock(api_mutex_);
+    auto& frame = impl_->ssx_sync_frame;
+    if (!frame || frame->ssx_worker_id != worker)
+      return;
+    GuestFrameTiming::Get().Add(GuestFrameTiming::Event::kReflexAbort, worker, frame->token_id,
+                                frame->phase);
+    frame->phase = 6;  // Retire; do not invent missing PCL markers.
+    frame.reset();
+  };
+  backend.complete = [this](uint64_t worker) {
+    std::lock_guard lock(api_mutex_);
+    if (impl_->ssx_sync_frame && impl_->ssx_sync_frame->ssx_worker_id == worker)
+      impl_->ssx_sync_frame.reset();
+  };
+  GuestReflex::Get().Attach(this, std::move(backend));
+  GuestReflex::Get().SetPingMessage(LatencyPingMessage());
+  REXGPU_INFO("SSX_REFLEX coupled=true mode={} physics_hz=30 fg=false", mode);
+  return true;
+#else
+  return GuestReflex::RequestedMode() == "disabled";
+#endif
+}
+
+bool Streamline::CanPaintSsxFrame(const std::shared_ptr<Frame>& frame) {
+  std::lock_guard lock(api_mutex_);
+#if REX_HAS_STREAMLINE
+  if (frame && frame->ssx_worker_id && frame->phase == 6)
+    return false;
+  if (impl_->ssx_sync_enabled && impl_->ssx_sync_frame) {
+    const auto& current = impl_->ssx_sync_frame;
+    return frame == current && current->phase == 3;
+  }
+#else
+  (void)frame;
+#endif
+  return true;
+}
