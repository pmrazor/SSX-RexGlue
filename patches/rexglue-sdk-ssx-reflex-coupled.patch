@@ -0,0 +1,56 @@
+// Opt-in SSX coupling: one actual input/simulation update per rendered frame.
+#pragma once
+#include <array>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <string>
+
+namespace rex::ui {
+class GuestReflex {
+ public:
+  struct Backend {
+    std::function<bool(uint64_t)> begin, end;
+    std::function<bool(uint64_t, uint64_t)> bind;
+    std::function<void(uint64_t)> cancel, complete;
+    std::function<void(uint64_t, bool, bool)> input;
+  };
+  struct Sample {
+    uint64_t key = 0, generation = 0, timestamp = 0;
+  };
+  static GuestReflex& Get();
+  static std::string RequestedMode();
+  void Attach(const void* owner, Backend backend);
+  void Detach(const void* owner);
+  bool enabled();
+  // Called outside guest locks, before original worker code / controller reads.
+  bool BeginWorker(uint64_t worker);
+  void Input(uint64_t worker);
+  void Published(uint64_t worker, Sample sample);
+  void EndWorker(uint64_t worker);
+  // Called before normal render job takes renderer/device locks.
+  bool WaitForRender(uint64_t render);
+  bool Selection(uint64_t render, uint32_t channel, Sample& sample);
+  void Complete(uint64_t render);
+  void Abort(uint64_t render);
+  // UI enqueues pings; backend consumes them at actual worker input sampling.
+  void QueuePing();
+  void QueueFlash();
+  void SetPingMessage(uint32_t message);
+  uint32_t PingMessage();
+
+ private:
+  void CancelLocked();
+  std::mutex mutex_;
+  std::condition_variable changed_;
+  const void* owner_ = nullptr;
+  Backend backend_;
+  uint64_t wanted_ = 0, worker_ = 0, render_ = 0;
+  bool finished_ = false, input_ = false, ping_ = false, flash_ = false;
+  uint32_t ping_message_ = 0;
+  std::array<Sample, 2> samples_{};
+  static constexpr auto kWait = std::chrono::milliseconds(500);
+};
+}  // namespace rex::ui
