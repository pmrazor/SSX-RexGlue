diff --git a/src/ui/guest_reflex.cpp b/src/ui/guest_reflex.cpp
new file mode 100644
index 0000000..df4bb6a
--- /dev/null
+++ b/src/ui/guest_reflex.cpp
@@ -0,0 +1,168 @@
+#include <rex/ui/guest_reflex.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <utility>
+
+REXCVAR_DEFINE_STRING(
+    ssx_reflex_sync, "disabled", "SSX",
+    "Experimental coupled 30 Hz input/simulation/render Reflex: disabled, off, on, boost. "
+    "Changes scheduling and removes interpolated extra frames; FG remains off.")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+
+namespace rex::ui {
+GuestReflex& GuestReflex::Get() {
+  static GuestReflex value;
+  return value;
+}
+std::string GuestReflex::RequestedMode() {
+  return REXCVAR_GET(ssx_reflex_sync);
+}
+void GuestReflex::Attach(const void* owner, Backend backend) {
+  std::lock_guard lock(mutex_);
+  CancelLocked();
+  owner_ = owner;
+  backend_ = std::move(backend);
+  ping_ = flash_ = false;
+}
+void GuestReflex::Detach(const void* owner) {
+  std::lock_guard lock(mutex_);
+  if (owner != owner_)
+    return;
+  CancelLocked();
+  backend_ = {};
+  owner_ = nullptr;
+  ping_message_ = 0;
+  changed_.notify_all();
+}
+bool GuestReflex::enabled() {
+  std::lock_guard lock(mutex_);
+  return owner_ != nullptr;
+}
+void GuestReflex::CancelLocked() {
+  if (worker_ && backend_.cancel)
+    backend_.cancel(worker_);
+  wanted_ = worker_ = render_ = 0;
+  finished_ = input_ = false;
+  samples_ = {};
+  changed_.notify_all();
+}
+bool GuestReflex::BeginWorker(uint64_t worker) {
+  std::unique_lock lock(mutex_);
+  if (!owner_)
+    return false;
+  // Do not overwrite the exact samples promised to an in-flight rendered frame.
+  // Waiting is outside the original worker function and all its guest locks.
+  if (!changed_.wait_for(lock, kWait, [&] { return !owner_ || !worker_; })) {
+    REXLOG_WARN("SSX_REFLEX abort=present_timeout worker={}", worker_);
+    CancelLocked();
+    return false;
+  }
+  if (!owner_ || !wanted_ || !worker)
+    return false;
+  if (!backend_.begin(worker)) {
+    CancelLocked();
+    return false;
+  }
+  worker_ = worker;
+  input_ = finished_ = false;
+  samples_ = {};
+  return true;
+}
+void GuestReflex::Input(uint64_t worker) {
+  std::lock_guard lock(mutex_);
+  if (worker_ == worker && worker) {
+    input_ = true;
+    if (backend_.input)
+      backend_.input(worker, std::exchange(ping_, false), std::exchange(flash_, false));
+  }
+}
+void GuestReflex::Published(uint64_t worker, Sample sample) {
+  std::lock_guard lock(mutex_);
+  if (!worker || worker_ != worker || !sample.key || !sample.generation)
+    return;
+  for (auto& slot : samples_) {
+    if (!slot.key || uint32_t(slot.key >> 32) == uint32_t(sample.key >> 32)) {
+      slot = sample;
+      return;
+    }
+  }
+  REXLOG_WARN("SSX_REFLEX abort=unexpected_sample_channel worker={}", worker);
+  CancelLocked();
+}
+void GuestReflex::EndWorker(uint64_t worker) {
+  std::lock_guard lock(mutex_);
+  if (!worker || worker_ != worker)
+    return;
+  if (!input_ || !samples_[0].key || !samples_[1].key || !backend_.end(worker)) {
+    CancelLocked();
+    return;
+  }
+  finished_ = true;
+  changed_.notify_all();
+}
+bool GuestReflex::WaitForRender(uint64_t render) {
+  std::unique_lock lock(mutex_);
+  if (!owner_ || !render)
+    return false;
+  wanted_ = render;
+  changed_.notify_all();
+  if (!changed_.wait_for(lock, kWait,
+                         [&] { return !owner_ || !wanted_ || (finished_ && !render_); })) {
+    REXLOG_WARN("SSX_REFLEX abort=worker_timeout render={}", render);
+    CancelLocked();
+    return false;
+  }
+  if (!owner_ || !worker_ || !backend_.bind(worker_, render)) {
+    CancelLocked();
+    return false;
+  }
+  render_ = render;
+  wanted_ = 0;
+  return true;
+}
+bool GuestReflex::Selection(uint64_t render, uint32_t channel, Sample& sample) {
+  std::lock_guard lock(mutex_);
+  if (!render || render != render_ || !finished_)
+    return false;
+  for (const auto& slot : samples_) {
+    if (uint32_t(slot.key >> 32) == channel) {
+      sample = slot;
+      return true;
+    }
+  }
+  return false;
+}
+void GuestReflex::Complete(uint64_t render) {
+  std::lock_guard lock(mutex_);
+  if (!render || render != render_)
+    return;
+  if (backend_.complete)
+    backend_.complete(worker_);
+  worker_ = render_ = 0;
+  finished_ = input_ = false;
+  samples_ = {};
+  // Preserve the next renderer's outstanding request.
+  changed_.notify_all();
+}
+void GuestReflex::Abort(uint64_t render) {
+  std::lock_guard lock(mutex_);
+  if (render && render == render_)
+    CancelLocked();
+}
+void GuestReflex::QueuePing() {
+  std::lock_guard lock(mutex_);
+  ping_ = true;
+}
+void GuestReflex::QueueFlash() {
+  std::lock_guard lock(mutex_);
+  flash_ = true;
+}
+void GuestReflex::SetPingMessage(uint32_t message) {
+  std::lock_guard lock(mutex_);
+  ping_message_ = message;
+}
+uint32_t GuestReflex::PingMessage() {
+  std::lock_guard lock(mutex_);
+  return ping_message_;
+}
+}  // namespace rex::ui
