diff --git a/tests/unit/graphics/guest_reflex_test.cpp b/tests/unit/graphics/guest_reflex_test.cpp
new file mode 100644
index 0000000..6c68ad9
--- /dev/null
+++ b/tests/unit/graphics/guest_reflex_test.cpp
@@ -0,0 +1,108 @@
+#include <catch2/catch_test_macros.hpp>
+#include <rex/ui/guest_reflex.h>
+#include <atomic>
+#include <thread>
+
+using rex::ui::GuestReflex;
+using namespace std::chrono_literals;
+
+TEST_CASE("SSX coupled Reflex binds actual input and both published channels", "[ssx-reflex]") {
+  GuestReflex scheduler;
+  std::atomic<unsigned> begins{0}, ends{0}, binds{0}, cancels{0};
+  std::atomic<unsigned> inputs{0};
+  std::atomic<bool> saw_ping{false}, saw_flash{false};
+  GuestReflex::Backend backend;
+  backend.begin = [&](uint64_t w) {
+    ++begins;
+    return w == 10;
+  };
+  backend.end = [&](uint64_t w) {
+    ++ends;
+    return w == 10;
+  };
+  backend.bind = [&](uint64_t w, uint64_t r) {
+    ++binds;
+    return w == 10 && r == 20;
+  };
+  backend.cancel = [&](uint64_t) { ++cancels; };
+  backend.input = [&](uint64_t w, bool ping, bool flash) {
+    if (w == 10)
+      ++inputs;
+    saw_ping = ping;
+    saw_flash = flash;
+  };
+  scheduler.Attach(&scheduler, backend);
+  scheduler.QueuePing();
+  scheduler.QueueFlash();
+  std::atomic<bool> rendered{false};
+  std::thread render([&] { rendered = scheduler.WaitForRender(20); });
+  bool begun = false;
+  for (unsigned i = 0; i < 100 && !begun; ++i) {
+    begun = scheduler.BeginWorker(10);
+    if (!begun)
+      std::this_thread::sleep_for(1ms);
+  }
+  if (begun) {
+    scheduler.Input(10);
+    scheduler.Published(10, {uint64_t(1) << 32 | 100, 7, 123});
+    scheduler.Published(10, {uint64_t(2) << 32 | 200, 8, 123});
+    scheduler.EndWorker(10);
+  }
+  render.join();
+  REQUIRE(begun);
+  REQUIRE(rendered.load());
+  GuestReflex::Sample sample;
+  REQUIRE(scheduler.Selection(20, 1, sample));
+  CHECK(sample.generation == 7);
+  CHECK_FALSE(scheduler.Selection(21, 1, sample));
+  scheduler.Complete(19);  // Wrong frame cannot release the worker.
+  CHECK(scheduler.Selection(20, 2, sample));
+  scheduler.Complete(20);
+  CHECK_FALSE(scheduler.Selection(20, 1, sample));
+  CHECK_FALSE(scheduler.BeginWorker(11));  // No render request, normal worker runs unchanged.
+  CHECK(begins == 1);
+  CHECK(ends == 1);
+  CHECK(binds == 1);
+  CHECK(cancels == 0);
+  CHECK(inputs == 1);
+  CHECK(saw_ping);
+  CHECK(saw_flash);
+  scheduler.Detach(&scheduler);
+}
+
+TEST_CASE("SSX coupled Reflex rejects absent input and wakes waiting render on detach",
+          "[ssx-reflex]") {
+  GuestReflex scheduler;
+  std::atomic<unsigned> cancelled{0}, ended{0};
+  GuestReflex::Backend backend;
+  backend.begin = [](uint64_t) { return true; };
+  backend.end = [&](uint64_t) {
+    ++ended;
+    return true;
+  };
+  backend.bind = [](uint64_t, uint64_t) { return true; };
+  backend.cancel = [&](uint64_t) { ++cancelled; };
+  scheduler.Attach(&scheduler, backend);
+  std::atomic<bool> rendered{true};
+  std::thread render([&] { rendered = scheduler.WaitForRender(20); });
+  bool begun = false;
+  for (unsigned i = 0; i < 100 && !begun; ++i) {
+    begun = scheduler.BeginWorker(10);
+    if (!begun)
+      std::this_thread::sleep_for(1ms);
+  }
+  if (begun)
+    scheduler.EndWorker(10);
+  else
+    scheduler.Detach(&scheduler);
+  render.join();
+  REQUIRE(begun);
+  CHECK_FALSE(rendered.load());
+  CHECK(cancelled == 1);
+  CHECK(ended == 0);
+  std::thread waiting([&] { rendered = scheduler.WaitForRender(30); });
+  scheduler.Detach(&scheduler);
+  waiting.join();
+  CHECK_FALSE(rendered.load());
+  CHECK_FALSE(scheduler.enabled());
+}
