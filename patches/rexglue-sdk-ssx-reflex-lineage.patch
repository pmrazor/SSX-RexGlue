+// Diagnostic NOP payload. Ordinary guest NOPs are unaffected. Carry this before
+// the frame's draws, not at Swap (DLAA may already have run by then).
+constexpr uint32_t kGuestRenderMarkerSignature = 0x52465442;  // RFTB
+constexpr uint32_t kGuestRenderMarkerVersion = 1;
+inline uint64_t DecodeGuestRenderMarker(uint32_t signature, uint32_t version, uint32_t lo,
+                                        uint32_t hi) {
+  return signature == kGuestRenderMarkerSignature && version == kGuestRenderMarkerVersion
+             ? uint64_t(lo) | (uint64_t(hi) << 32)
+             : 0;
+}
+class GuestRenderMarker {
+ public:
+  bool Begin(uint64_t id) {
+    if (!id || id_ || conflict_) {
+      id_ = 0;
+      conflict_ = true;
+      return false;
+    }
+    id_ = id;
+    return true;
+  }
+  uint64_t id() const { return id_; }
+  void Reset() {
+    id_ = 0;
+    conflict_ = false;
+  }
+
+ private:
+  uint64_t id_ = 0;
+  bool conflict_ = false;
+};
+
+// Bounded diagnostic slot-generation table. The guest owns a slot exclusively
+// while writing and pins selected slots until render release. Never identify a
+// generation by timestamp alone: timestamps and slot addresses may repeat.
+class GuestSampleLineage {
+ public:
+  static constexpr size_t kCapacity = 128;
+  bool BeginWrite(uint64_t key, uint64_t timestamp, uint64_t generation) {
+    if (!key || !generation)
+      return false;
+    std::lock_guard lock(mutex_);
+    for (auto& entry : entries_) {
+      if (!entry.key || entry.key == key) {
+        entry = {key, timestamp, generation, false};
+        return true;
+      }
+    }
+    return false;
+  }
+  uint64_t Publish(uint64_t key, uint64_t timestamp) {
+    std::lock_guard lock(mutex_);
+    for (auto& entry : entries_) {
+      if (entry.key == key && entry.timestamp == timestamp) {
+        entry.published = true;
+        return entry.generation;
+      }
+    }
+    return 0;
+  }
+  uint64_t Selected(uint64_t key, uint64_t timestamp) {
+    std::lock_guard lock(mutex_);
+    for (const auto& entry : entries_) {
+      if (entry.key == key && entry.timestamp == timestamp && entry.published)
+        return entry.generation;
+    }
+    return 0;
+  }
+
+ private:
+  struct Entry {
+    uint64_t key = 0, timestamp = 0, generation = 0;
+    bool published = false;
+  };
+  std::mutex mutex_;
+  std::array<Entry, kCapacity> entries_{};
+};
+
 }  // namespace rex::ui
