 using rex::ui::GuestFrameTiming;
 using Event = GuestFrameTiming::Event;
 
+TEST_CASE("SSX sample lineage rejects unpublished, reused and overflowing slots", "[ssx-timing]") {
+  rex::ui::GuestSampleLineage samples;
+  CHECK(samples.BeginWrite(1, 100, 20));
+  CHECK(samples.Selected(1, 100) == 0);
+  CHECK(samples.Publish(1, 101) == 0);
+  CHECK(samples.Publish(1, 100) == 20);
+  CHECK(samples.Selected(1, 100) == 20);
+  CHECK(samples.Selected(2, 100) == 0);
+  // Reuse with even the same timestamp must not inherit the old publication.
+  CHECK(samples.BeginWrite(1, 100, 21));
+  CHECK(samples.Selected(1, 100) == 0);
+  CHECK(samples.Publish(1, 100) == 21);
+  CHECK(samples.Selected(1, 100) == 21);
+  CHECK(samples.BeginWrite(1, 102, 22));
+  CHECK(samples.Selected(1, 100) == 0);
+  for (uint64_t i = 2; i <= samples.kCapacity; ++i)
+    REQUIRE(samples.BeginWrite(i, 100, i + 30));
+  CHECK_FALSE(samples.BeginWrite(samples.kCapacity + 1, 100, 1000));
+  CHECK(samples.Publish(samples.kCapacity + 1, 100) == 0);
+  CHECK(samples.Publish(1, 102) == 22);
+}
+
+TEST_CASE("SSX ordered render markers fail closed until the next swap", "[ssx-timing]") {
+  using namespace rex::ui;
+  CHECK(DecodeGuestRenderMarker(kGuestRenderMarkerSignature, 99, 1, 0) == 0);
+  CHECK(DecodeGuestRenderMarker(0, kGuestRenderMarkerVersion, 1, 0) == 0);
+  CHECK(DecodeGuestRenderMarker(kGuestRenderMarkerSignature, kGuestRenderMarkerVersion, 0x89ABCDEF,
+                                0x12345678) == 0x1234567889ABCDEFull);
+  GuestRenderMarker marker;
+  CHECK(marker.id() == 0);
+  CHECK(marker.Begin(12));
+  CHECK(marker.id() == 12);
+  CHECK_FALSE(marker.Begin(12));
+  CHECK(marker.id() == 0);
+  CHECK_FALSE(marker.Begin(13));
+  marker.Reset();
+  CHECK(marker.Begin(14));
+  marker.Reset();
+  CHECK(marker.id() == 0);
+}
