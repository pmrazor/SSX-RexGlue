+TEST_CASE("SSX HDR grading cannot leak across frames or missing passes", "[SSX][HDR]") {
+  SsxFrameInputPool pool;
+  auto first = pool.Acquire(1, 0);
+  first->metadata.grading_captured = true;
+  first->metadata.display_gamma_captured = true;
+  first->metadata.grading_draw = 300;
+  first->metadata.grading_constants[0] = .7f;
+  first->last_copy_submission = 2;
+  auto second = pool.Acquire(2, 1);
+  CHECK(first != second);
+  first.reset();
+  second.reset();
+  auto reused = pool.Acquire(3, 2);
+  CHECK_FALSE(reused->metadata.grading_captured);
+  CHECK_FALSE(reused->metadata.display_gamma_captured);
+  CHECK(reused->metadata.grading_draw == 0);
+  CHECK(reused->metadata.grading_constants[0] == 0);
+  SsxHDRConstants constants;
+  constants.grading_enabled = 1;
+  CHECK_FALSE(PlanSsxHDRGrading(*reused, constants));
+  CHECK(constants.grading_enabled == 0);
