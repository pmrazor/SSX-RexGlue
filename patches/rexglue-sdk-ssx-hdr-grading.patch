+bool GuestInputTexture::PrepareGradingLut(ID3D12Device* device, uint32_t edge,
+                                         bool& newly_created) {
+  newly_created = false;
+  if (!device || edge != 32) return false;
+  if (resource) {
+    const auto d = resource->GetDesc();
+    if (d.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE3D && d.Width == edge &&
+        d.Height == edge && d.DepthOrArraySize == edge && d.MipLevels == 1 &&
+        d.Format == DXGI_FORMAT_R8G8B8A8_TYPELESS) return true;
+  }
+  D3D12_RESOURCE_DESC d{};
+  d.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE3D;
+  d.Width = d.Height = edge;
+  d.DepthOrArraySize = uint16_t(edge);
+  d.MipLevels = d.SampleDesc.Count = 1;
+  d.Format = DXGI_FORMAT_R8G8B8A8_TYPELESS;
+  D3D12_HEAP_PROPERTIES heap{};
+  heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+  Microsoft::WRL::ComPtr<ID3D12Resource> replacement;
+  if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &d,
+      D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&replacement)))) return false;
+  resource = std::move(replacement);
+  width = height = edge;
+  view_format = DXGI_FORMAT_R8G8B8A8_UNORM;
+  newly_created = true;
+  return true;
