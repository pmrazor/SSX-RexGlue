+void D3D12CommandProcessor::PrepareSsxHDRLayerDraw(uint64_t vs, uint64_t ps,
+                                                   const draw_util::ViewportInfo& viewport,
+                                                   uint32_t color_mask) {
+  using namespace ui::d3d12;
+  uint32_t parameters[4]{};
+  [&] {
+    if (!REXCVAR_GET(d3d12_ssx_hdr_layers) || !REXCVAR_GET(d3d12_ssx_hdr_preview) ||
+        ssx_title_id_ != 0x4541096D || ssx_other_render_target_cache_ || !ssx_inputs_ ||
+        ssx_inputs_->metadata.guest_frame != frame_current_ ||
+        !render_target_cache_->SsxLayerBase(false))
+      return;
+    if (ssx_hdr_layer_frame_ != frame_current_) {
+      ssx_hdr_layer_frame_ = frame_current_;
+      ssx_hdr_layer_phase_ = 0;
+    }
+    auto& m = ssx_inputs_->metadata;
+    const uint32_t w = m.scene_width * 3, h = m.scene_height * 3;
+    if (vs == 0xE857B4AF9617DC29ull && ps == 0xA2CD8E82699B2C0Aull && !viewport.xy_offset[0] &&
+        !viewport.xy_offset[1] && viewport.xy_extent[0] == w && viewport.xy_extent[1] == h) {
+      if (ssx_hdr_layer_phase_ != 0)
+        m.hdr_layer_fail_reasons |= 1;
+      if (!render_target_cache_->ClearSsxLayer(false))
+        m.hdr_layer_fail_reasons |= 2;
+      m.hdr_layers_failed |= m.hdr_layer_fail_reasons != 0;
+      ssx_hdr_layer_phase_ = 1;
+      return;  // Start with the next draw, never capture the base tone-map copy.
+    }
+    if (ssx_hdr_layer_phase_ == 1 &&
+        ((vs == 0x5AE09EE0F0B7D2EDull && ps == 0x19A8B131C04F61F7ull) ||
+         (SsxHDRPostMode(ps) != UINT32_MAX))) {
+      m.hdr_world_captured = render_target_cache_->CopySsxLayer(
+          false, ssx_inputs_->hdr_world, ssx_inputs_->hdr_world_transmission, w, h);
+      m.hdr_layers_failed |= !m.hdr_world_captured;
+      if (!m.hdr_world_captured)
+        m.hdr_layer_fail_reasons |= 4;
+      ssx_inputs_->last_copy_submission = submission_current_;
+      ssx_hdr_layer_phase_ = 2;
+      return;
+    }
+    if (vs == 0xE930F82AAE4ACF59ull && ps == 0xE7D07D83F716C69Dull && !viewport.xy_offset[0] &&
+        !viewport.xy_offset[1] && viewport.xy_extent[0] == 3840 && viewport.xy_extent[1] == 2160) {
+      if (ssx_hdr_layer_phase_ != 2)
+        m.hdr_layer_fail_reasons |= 8;
+      if (!render_target_cache_->ClearSsxLayer(true))
+        m.hdr_layer_fail_reasons |= 16;
+      m.hdr_layers_failed |= m.hdr_layer_fail_reasons != 0;
+      ssx_hdr_layer_phase_ = 3;
+      return;
+    }
+    if (ssx_hdr_layer_phase_ != 1 && ssx_hdr_layer_phase_ != 3)
+      return;
+    const bool hud = ssx_hdr_layer_phase_ == 3;
+    if (!(color_mask & 7))
+      return;  // Depth-only and alpha-only masks are handled by the guest.
+    // Depth-only mode can keep a nonzero RB_COLOR_MASK while the effective ROV
+    // write mask disables every color bit. These 8192x8192 helper draws appear
+    // throughout the captured world/HUD sequence and must not invalidate it.
+    if (system_constants_.edram_rt_keep_mask[0][0] == UINT32_MAX &&
+        system_constants_.edram_rt_keep_mask[0][1] == UINT32_MAX)
+      return;
+    const auto& regs = *register_file_;
+    const auto rt = regs.Get<reg::RB_COLOR_INFO>();
+    const auto surface = regs.Get<reg::RB_SURFACE_INFO>();
+    // A viewport may be cropped, offset, or larger than the target (SSX clear
+    // helpers). SV_Position plus the guest scissor already supplies the exact
+    // destination pixels. Identify the surface by its EDRAM allocation/pitch,
+    // not by assuming every world/HUD draw uses a full-screen viewport.
+    if (rt.color_base || rt.color_base_bit_11 ||
+        surface.surface_pitch != (hud ? 1280u : m.scene_width))
+      return;  // Auxiliary effect surface.
+    const uint32_t blend = system_constants_.edram_rt_blend_factors_ops[0];
+    if ((color_mask & 7) != 7 || (color_mask & 0xFFF0) ||
+        rt.color_format != xenos::ColorRenderTargetFormat::k_8_8_8_8 ||
+        surface.msaa_samples != xenos::MsaaSamples::k1X || !SsxLayerBlendSupported(blend)) {
+      m.hdr_layers_failed = true;
+      m.hdr_layer_fail_reasons |= 32;
+      m.hdr_layer_unsupported_blend = blend;
+      if (frame_current_ - ssx_hdr_layer_fault_log_frame_ >= 120) {
+        ssx_hdr_layer_fault_log_frame_ = frame_current_;
+        REXGPU_WARN(
+            "SSX_HDR_LAYER_REJECT frame={} hud={} VS={:016X} PS={:016X} mask={:X} format={} "
+            "samples={} blend={:X}",
+            frame_current_, hud, vs, ps, color_mask, uint32_t(rt.color_format),
+            1u << uint32_t(surface.msaa_samples), blend);
+      }
+      return;
+    }
+    parameters[0] = render_target_cache_->SsxLayerBase(hud);
+    parameters[1] = hud ? 3840 : w;
+    parameters[2] = hud ? 2160 : h;
+    parameters[3] = blend;
+    if (hud)
+      ++m.hdr_hud_draws;
+    else
+      ++m.hdr_world_draws;
+  }();
+  if (std::memcmp(parameters, system_constants_.ssx_hdr_layer, sizeof(parameters))) {
+    std::memcpy(system_constants_.ssx_hdr_layer, parameters, sizeof(parameters));
+    cbuffer_binding_system_.up_to_date = false;
+  }
 }
 
