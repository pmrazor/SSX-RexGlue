+uint32_t D3D12RenderTargetCache::SsxLayerBase(bool hud) const {
+  if (!ssx_layers_allocated_)
+    return 0;
+  return (xenos::kEdramSizeBytes * 9 + (hud ? ui::d3d12::kSsxLayerBytes : 0)) / 4;
+}
+bool D3D12RenderTargetCache::ClearSsxLayer(bool hud) {
+  using namespace ui::d3d12;
+  if (!SsxLayerBase(hud))
+    return false;
+  const auto& provider = command_processor_.GetD3D12Provider();
+  if (!ssx_layer_clear_root_) {
+#include "../shaders/bytecode/d3d12_5_1/ssx_layer_clear_cs.h"
+    D3D12_DESCRIPTOR_RANGE range{D3D12_DESCRIPTOR_RANGE_TYPE_UAV, 1, 0, 0, 0};
+    D3D12_ROOT_PARAMETER parameters[2]{};
+    parameters[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    parameters[0].Constants = {0, 0, 2};
+    parameters[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    parameters[1].DescriptorTable = {1, &range};
+    D3D12_ROOT_SIGNATURE_DESC desc{};
+    desc.NumParameters = 2;
+    desc.pParameters = parameters;
+    ssx_layer_clear_root_.Attach(util::CreateRootSignature(provider, desc));
+    if (!ssx_layer_clear_root_)
+      return false;
+    ssx_layer_clear_pipeline_.Attach(
+        util::CreateComputePipeline(provider.GetDevice(), ssx_layer_clear_cs,
+                                    sizeof(ssx_layer_clear_cs), ssx_layer_clear_root_.Get()));
+  }
+  if (!ssx_layer_clear_pipeline_)
+    return false;
+  util::DescriptorCpuGpuHandlePair view;
+  if (!command_processor_.RequestOneUseSingleViewDescriptors(1, &view))
+    return false;
+  WriteEdramUintPow2UAVDescriptor(view.first, 2);
+  TransitionEdramBuffer(D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  CommitEdramBufferUAVWrites(EdramBufferModificationStatus::kAsUAV);
+  command_processor_.SubmitBarriers();
+  auto& list = command_processor_.GetDeferredCommandList();
+  list.D3DSetComputeRootSignature(ssx_layer_clear_root_.Get());
+  const uint32_t k[] = {SsxLayerBase(hud), kSsxLayerWidth * kSsxLayerHeight};
+  list.D3DSetComputeRoot32BitConstants(0, 2, k, 0);
+  list.D3DSetComputeRootDescriptorTable(1, view.second);
+  command_processor_.SetExternalPipeline(ssx_layer_clear_pipeline_.Get());
+  list.D3DDispatch((k[1] + 255) / 256, 1, 1);
+  MarkEdramBufferModified(EdramBufferModificationStatus::kAsUAV);
+  CommitEdramBufferUAVWrites(EdramBufferModificationStatus::kAsUAV);
+  command_processor_.SubmitBarriers();
+  return true;
+}
+bool D3D12RenderTargetCache::CopySsxLayer(bool hud, ui::d3d12::GuestInputTexture& contribution,
+                                          ui::d3d12::GuestInputTexture& transmission,
+                                          uint32_t width, uint32_t height) {
+  using namespace ui::d3d12;
+  if (!SsxLayerBase(hud) || !width || !height || width > kSsxLayerWidth || height > kSsxLayerHeight)
+    return false;
+  for (uint32_t plane = 0; plane < 2; ++plane) {
+    auto& output = plane ? transmission : contribution;
+    bool created = false;
+    if (!output.Prepare(command_processor_.GetD3D12Provider().GetDevice(),
+                        DXGI_FORMAT_R16G16B16A16_FLOAT, width, height, created))
+      return false;
+    output.view_format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+    output.resource->SetName(plane ? L"SSX RGB layer transmission" : L"SSX RGB layer contribution");
+    TransitionEdramBuffer(D3D12_RESOURCE_STATE_COPY_SOURCE);
+    if (!created)
+      command_processor_.PushTransitionBarrier(output.resource.Get(), GuestInputTexture::kReadState,
+                                               D3D12_RESOURCE_STATE_COPY_DEST);
+    command_processor_.SubmitBarriers();
+    D3D12_TEXTURE_COPY_LOCATION from{}, to{};
+    from.pResource = edram_buffer_;
+    from.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    from.PlacedFootprint.Offset = uint64_t(SsxLayerBase(hud)) * 4 + plane * kSsxLayerPlaneBytes;
+    from.PlacedFootprint.Footprint = {DXGI_FORMAT_R16G16B16A16_FLOAT, kSsxLayerWidth, height, 1,
+                                      kSsxLayerWidth * 8};
+    to.pResource = output.resource.Get();
+    to.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    D3D12_BOX box{0, 0, 0, width, height, 1};
+    command_processor_.GetDeferredCommandList().D3DCopyTextureRegion(&to, 0, 0, 0, &from, &box);
+    TransitionEdramBuffer(D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    command_processor_.PushTransitionBarrier(output.resource.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+                                             GuestInputTexture::kReadState);
+    command_processor_.SubmitBarriers();
+  }
+  return true;
+}
