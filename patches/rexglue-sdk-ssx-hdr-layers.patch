+TEST_CASE("SSX HDR layers recognize Xbox color versus alpha factors", "[SSX][HDR]") {
+  for (uint32_t b : {0x1010706u, 0x6010601u, 0x7000706u, 0x1000101u, 0x1060106u, 0x1010106u,
+                     0x7060706u, 0x80008u})
+    CHECK(SsxLayerBlendSupported(b));
+  CHECK_FALSE(SsxLayerBlendSupported(2));
+  CHECK(SsxLayerBlendSupported(4 << 8));
+  CHECK(SsxLayerBlendSupported(10));
+  CHECK(SsxLayerBlendSupported(11));
+  CHECK_FALSE(SsxLayerBlendSupported(8 << 8));
+  CHECK_FALSE(SsxLayerBlendSupported(9));
+  CHECK_FALSE(SsxLayerBlendSupported(0x706 | (1 << 5)));
+  CHECK_FALSE(SsxLayerBlendSupported(0x706 | (4 << 5)));
+}
+TEST_CASE("SSX HDR layer validity cannot survive frame packet reuse", "[SSX][HDR]") {
+  SsxFrameInputPool pool;
+  auto f = pool.Acquire(1, 0);
+  f->metadata.hdr_world_captured = f->metadata.hdr_hud_captured = f->metadata.hdr_bloom_captured =
+      true;
+  f->metadata.hdr_world_draws = 40;
+  f->metadata.hdr_layers_failed = true;
+  f->metadata.hdr_post_shader = 0x418794134AA3A6AFull;
+  f->metadata.hdr_post_textures_captured = 1;
+  f->metadata.hdr_post_constants[0] = 3;
+  f->metadata.hdr_layer_fail_reasons = 8;
+  f->last_copy_submission = 2;
+  f.reset();
+  f = pool.Acquire(3, 2);
+  CHECK_FALSE(f->metadata.hdr_world_captured);
+  CHECK_FALSE(f->metadata.hdr_hud_captured);
+  CHECK_FALSE(f->metadata.hdr_bloom_captured);
+  CHECK_FALSE(f->metadata.hdr_layers_failed);
+  CHECK(f->metadata.hdr_world_draws == 0);
+  CHECK(f->metadata.hdr_post_shader == 0);
+  CHECK(f->metadata.hdr_post_textures_captured == 0);
+  CHECK(f->metadata.hdr_post_constants[0] == 0);
+  CHECK(f->metadata.hdr_layer_fail_reasons == 0);
+}
