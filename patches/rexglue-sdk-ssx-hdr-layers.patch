+bool D3D12CommandProcessor::CopySsxBloom() {
+  D3D12TextureCache::ActiveTextureSnapshotSource source;
+  if (!texture_cache_->GetActiveTextureSnapshotSource(1, source))
+    return false;
+  const auto d = source.resource->GetDesc();
+  const auto& m = ssx_inputs_->metadata;
+  if (!source.scaled || d.Format != DXGI_FORMAT_R8G8B8A8_TYPELESS ||
+      d.Width != m.scene_width * 3 / 4 || d.Height != m.scene_height * 3 / 4)
+    return false;
+  return CopySsxPostTexture(1, ssx_inputs_->hdr_bloom);
+}
+
+bool D3D12CommandProcessor::CopySsxPostTexture(uint32_t fetch_index,
+                                               ui::d3d12::GuestInputTexture& snapshot) {
+  D3D12TextureCache::ActiveTextureSnapshotSource source;
+  if (!texture_cache_->GetActiveTextureSnapshotSource(fetch_index, source))
+    return false;
+  const auto d = source.resource->GetDesc();
+  if ((d.Format != DXGI_FORMAT_R8G8B8A8_TYPELESS && d.Format != DXGI_FORMAT_R16G16B16A16_FLOAT) ||
+      d.MipLevels != 1 || d.DepthOrArraySize != 1 || !d.Width || !d.Height || d.Width > 3840 ||
+      d.Height > 2160)
+    return false;
+  bool created = false;
+  if (!snapshot.Prepare(GetD3D12Provider().GetDevice(), d.Format, uint32_t(d.Width), d.Height,
+                        created))
+    return false;
+  snapshot.view_format = d.Format == DXGI_FORMAT_R8G8B8A8_TYPELESS ? DXGI_FORMAT_R8G8B8A8_UNORM
+                                                                   : DXGI_FORMAT_R16G16B16A16_FLOAT;
+  snapshot.host_swizzle = source.host_swizzle;
+  snapshot.swizzled_signs = source.swizzled_signs;
+  snapshot.guest_fetch = source.guest_fetch;
+  snapshot.source_mip = 0;
+  snapshot.resource->SetName(L"SSX original per-frame post-effect input");
+  PushTransitionBarrier(source.resource, source.state, D3D12_RESOURCE_STATE_COPY_SOURCE);
+  if (!created)
+    PushTransitionBarrier(snapshot.resource.Get(), GuestInputTexture::kReadState,
+                          D3D12_RESOURCE_STATE_COPY_DEST);
+  SubmitBarriers();
+  D3D12_TEXTURE_COPY_LOCATION from{}, to{};
+  from.pResource = source.resource;
+  from.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  to.pResource = snapshot.resource.Get();
+  to.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  deferred_command_list_.D3DCopyTextureRegion(&to, 0, 0, 0, &from, nullptr);
+  std::array<D3D12_RESOURCE_BARRIER, 3> restore;
+  const auto count = snapshot.GetCopyRestoreBarriers(source.resource, source.state, 0, restore);
+  deferred_command_list_.D3DResourceBarrier(count, restore.data());
+  ssx_inputs_->last_copy_submission = submission_current_;
+  return true;
+}
