--- /dev/null
+++ b/include/rex/ui/d3d12/ssx_hdr_layers.h
@@ -0,0 +1,48 @@
+#pragma once
+#include <cstdint>
+#include <rex/graphics/xenos.h>
+
+namespace rex::ui::d3d12 {
+// Raster-ordered affine layers: RGB output = contribution + destination * transmission.
+// Transmission is RGB as well: SSX HUD multiply draws use kDstColor, not kDstAlpha.
+inline constexpr uint32_t kSsxLayerWidth = 3840, kSsxLayerHeight = 2160;
+inline constexpr uint32_t kSsxLayerPlaneBytes = kSsxLayerWidth * kSsxLayerHeight * 8;
+inline constexpr uint32_t kSsxLayerBytes = 2 * kSsxLayerPlaneBytes;
+inline bool SsxLayerBlendSupported(uint32_t blend) {
+  using F = rex::graphics::xenos::BlendFactor;
+  const auto independent = [](uint32_t f) {
+    switch (F(f)) {
+      case F::kZero: case F::kOne: case F::kSrcColor: case F::kOneMinusSrcColor:
+      case F::kSrcAlpha: case F::kOneMinusSrcAlpha:
+      case F::kDstAlpha: case F::kOneMinusDstAlpha: return true;
+      default: return false;
+    }
+  };
+  const uint32_t fs=blend&31, fd=(blend>>8)&31;
+  // S*DstColor + D*fd = (S+fd)*D is affine. Destination-color as fd
+  // introduces D squared; inverse destination-color can require negative T.
+  return !(blend & (7u<<5)) && (independent(fs) || fs==uint32_t(F::kDstColor)) && independent(fd);
+}
+enum class SsxLayerPhase { kOff, kWorld, kPost, kHud };
+// Audited final-post microcode variants. Bits describe the actual operations,
+// not an assumed game state: 1=pre-LUT overlay, 2=vignette, 4=two post-LUT overlays.
+inline constexpr uint32_t SsxHDRPostMode(uint64_t ps) {
+  switch (ps) {
+    case 0x86455B1D2BA4A035ull:
+      return 0;
+    case 0x418794134AA3A6AFull:
+      return 1;
+    case 0x94262AE20BE5EC7Aull:
+      return 2;
+    case 0x88095FB3FE6C244Dull:
+      return 4;
+    case 0x48CD7B80EE1F1D67ull:
+      return 5;
+    default:
+      return UINT32_MAX;
+  }
+}
+inline constexpr uint32_t SsxHDRPostTextureMask(uint32_t mode) {
+  return (mode & 1) | ((mode & 4) ? 6 : 0);
+}
+}  // namespace rex::ui::d3d12
