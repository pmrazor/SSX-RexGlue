+using Microsoft::WRL::ComPtr;
+void Transition(ID3D12GraphicsCommandList* list, ID3D12Resource* resource,
+                D3D12_RESOURCE_STATES before, D3D12_RESOURCE_STATES after) {
+  D3D12_RESOURCE_BARRIER b{};
+  b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  b.Transition = {resource, D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES, before,
+                  after};
+  list->ResourceBarrier(1, &b);
+}
+bool Resource(ID3D12Device* device, const D3D12_RESOURCE_DESC& desc,
+              bool readback, D3D12_RESOURCE_STATES state,
+              ComPtr<ID3D12Resource>& result) {
+  D3D12_HEAP_PROPERTIES heap{};
+  heap.Type = readback ? D3D12_HEAP_TYPE_READBACK : D3D12_HEAP_TYPE_DEFAULT;
+  return SUCCEEDED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE,
+                                                   &desc, state, nullptr,
+                                                   IID_PPV_ARGS(&result)));
+}
+
+float FetchScale(uint32_t word) {
+  int e = int((word >> 13) & 63);
+  if (e & 32) e -= 64;
+  return std::ldexp(1.0f, e);
+}
+}  // namespace
+bool PlanSsxSceneColor(const SsxFrameInputs& frame, SsxColorConstants& k) {
+  k = {};
+  const auto& f = frame.metadata;
+  const auto& color = frame.textures[size_t(SsxInput::kEncodedColor)];
+  const auto& exposure = frame.textures[size_t(SsxInput::kLogExposure)];
+  const uint32_t needed = f.exposure_branch ? 5 : 1;
+  if ((f.captured_mask & needed) != needed ||
+      ((f.failed_mask | f.duplicate_mask) & needed) || !f.scale_x ||
+      !f.scale_y || !color.resource ||
+      color.view_format != DXGI_FORMAT_R16G16B16A16_FLOAT || color.source_mip ||
+      color.width != uint64_t(f.scene_width) * f.scale_x ||
+      color.height != uint64_t(f.scene_height) * f.scale_y || !color.width ||
+      !color.height || color.host_swizzle != 0x688 ||
+      color.swizzled_signs != 0x55)
+    return false;
+  k.width = color.width;
+  k.height = color.height;
+  k.color_scale = FetchScale(color.guest_fetch[3]);
+  k.exposure_enabled = f.exposure_branch;
+  if (!f.exposure_branch) return true;
+  const float lod = f.tone_map_constants[4];
+  // Only the observed scalar unsigned R16 view, no bias/gamma/sign conversion.
+  // Source mip must be the explicit integer LOD. Fractional LOD or fetch LOD
+  // bias would need both mips; reject instead of silently decoding the wrong
+  // one.
+  if (!exposure.resource || exposure.view_format != DXGI_FORMAT_R16_UNORM ||
+      exposure.host_swizzle != 0xA00 || exposure.swizzled_signs ||
+      !exposure.width || exposure.width > 8 || !exposure.height ||
+      exposure.height > 8 || !std::isfinite(lod) || lod < 0 || lod > 15 ||
+      std::floor(lod) != lod || exposure.source_mip != uint32_t(lod) ||
+      ((exposure.guest_fetch[4] >> 12) & 1023) ||
+      ((exposure.guest_fetch[4] >> 2) & 15) > uint32_t(lod) ||
+      ((exposure.guest_fetch[4] >> 6) & 15) < uint32_t(lod))
+    return false;
+  k.exposure_width = exposure.width;
+  k.exposure_height = exposure.height;
+  k.exposure_scale = FetchScale(exposure.guest_fetch[3]);
+  k.exposure_key = f.tone_map_constants[0];
+  k.log_scale = f.tone_map_constants[36];
+  return std::isfinite(k.exposure_key) && k.exposure_key > 0 &&
+         std::isfinite(k.log_scale);
+}
+bool SsxSceneColor::Initialize(const D3D12Provider& provider) {
+  if (pipeline_) return true;
+  if (unavailable_) return false;
+  unavailable_ = true;
+  D3D12_DESCRIPTOR_RANGE ranges[2]{};
+  ranges[0] = {D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 2, 0, 0, 0};
+  ranges[1] = {D3D12_DESCRIPTOR_RANGE_TYPE_UAV, 3, 0, 0, 2};
+  D3D12_ROOT_PARAMETER params[2]{};
+  params[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+  params[0].Constants = {0, 0, sizeof(SsxColorConstants) / 4};
+  params[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+  params[1].DescriptorTable = {2, ranges};
+  D3D12_ROOT_SIGNATURE_DESC desc{};
+  desc.NumParameters = 2;
+  desc.pParameters = params;
+  root_.Attach(util::CreateRootSignature(provider, desc));
+  if (!root_) return false;
+  pipeline_.Attach(
+      util::CreateComputePipeline(provider.GetDevice(), ssx_scene_color_cs,
+                                  sizeof(ssx_scene_color_cs), root_.Get()));
+  if (!pipeline_) return false;
+  pipeline_->SetName(
+      L"SSX scene decode before exposure and tone map (experimental)");
+  unavailable_ = false;
+  return true;
+}
+bool SsxSceneColor::Prepare(const D3D12Provider& provider, Slot& slot,
+                            uint32_t width, uint32_t height) {
+  if (slot.color && slot.width == width && slot.height == height) return true;
+  Slot replacement;
+  auto* device = provider.GetDevice();
+  D3D12_RESOURCE_DESC d{};
+  d.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+  d.Width = width;
+  d.Height = height;
+  d.DepthOrArraySize = d.MipLevels = d.SampleDesc.Count = 1;
+  d.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+  d.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+  if (!Resource(device, d, false, GuestInputTexture::kReadState,
+                replacement.color))
+    return false;
+  d.Width = d.Height = 1;
+  d.Format = DXGI_FORMAT_R32_FLOAT;
+  if (!Resource(device, d, false, GuestInputTexture::kReadState,
+                replacement.exposure))
+    return false;
+  replacement.samples = 1 + ((width + 31) / 32) * ((height + 31) / 32);
+  d.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+  d.Width = uint64_t(replacement.samples) * 16;
+  d.Height = 1;
+  d.Format = DXGI_FORMAT_UNKNOWN;
+  d.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+  if (!Resource(device, d, false, GuestInputTexture::kReadState,
+                replacement.diagnostics))
+    return false;
+  d.Flags = D3D12_RESOURCE_FLAG_NONE;
+  if (!Resource(device, d, true, D3D12_RESOURCE_STATE_COPY_DEST,
+                replacement.readback))
+    return false;
+  D3D12_DESCRIPTOR_HEAP_DESC heap{};
+  heap.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+  heap.NumDescriptors = 5;
+  heap.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+  if (FAILED(
+          device->CreateDescriptorHeap(&heap, IID_PPV_ARGS(&replacement.heap))))
+    return false;
+  replacement.width = width;
+  replacement.height = height;
+  replacement.color->SetName(L"SSX linear scene before tone map and exposure");
+  replacement.exposure->SetName(L"SSX scalar exposure (zero if invalid)");
+  slot = std::move(replacement);
+  return true;
+}
+void SsxSceneColor::ReadDiagnostics(Slot& slot) {
+  if (!slot.pending) return;
+  slot.pending = false;
+  float* values = nullptr;
+  D3D12_RANGE range{0, size_t(slot.samples) * 16};
+  if (FAILED(slot.readback->Map(0, &range, reinterpret_cast<void**>(&values))))
+    return;
+  uint32_t invalid = 0, highlights = 0;
+  float peak = 0;
+  for (uint32_t i = 1; i < slot.samples; ++i) {
+    const auto* p = values + i * 4;
+    if (!p[3]) {
+      ++invalid;
+      continue;
+    }
+    const auto v = std::max({p[0], p[1], p[2]});
+    peak = std::max(peak, v);
+    if (v > 1) ++highlights;
+  }
+  REXGPU_INFO(
+      "SSX_COLOR_GPU frame={} size={}x{} samples={} invalid={} above_one={} "
+      "peak={} "
+      "exposure_min={} exposure_max={} scalar={} scalar_valid={} "
+      "pre_tone_map=true dlss_ready=false",
+      slot.frame, slot.width, slot.height, slot.samples - 1, invalid,
+      highlights, peak, values[0], values[1], values[2], values[3] != 0);
+  D3D12_RANGE empty{0, 0};
+  slot.readback->Unmap(0, &empty);
+}
+SsxSceneColor::Result SsxSceneColor::Record(
+    const D3D12Provider& provider, ID3D12GraphicsCommandList* list,
+    const std::shared_ptr<const SsxFrameInputs>& frame, uint64_t submission,
+    uint64_t completed) {
+  for (auto& slot : slots_)
+    if (slot.submission <= completed) {
+      ReadDiagnostics(slot);
+      slot.input.reset();
+    }
+  SsxColorConstants k;
+  if (!frame || !PlanSsxSceneColor(*frame, k)) {
+    last_slot_ = -1;
+    return {};
+  }
+  if (last_slot_ >= 0 &&
+      slots_[last_slot_].frame == frame->metadata.guest_frame) {
+    auto& slot = slots_[last_slot_];
+    slot.submission = submission;
+    slot.input = frame;
+    return {slot.color.Get(), slot.exposure.Get(), slot.diagnostics.Get(),
+            false, true};
+  }
+  int chosen = -1;
+  for (int i = 0; i < int(slots_.size()); ++i)
+    if (slots_[i].submission <= completed) {
+      chosen = i;
+      break;
+    }
+  if (chosen < 0 || !Initialize(provider)) {
+    last_slot_ = -1;
+    return {};
+  }
+  auto& slot = slots_[chosen];
+  if (!Prepare(provider, slot, k.width, k.height)) {
+    last_slot_ = -1;
+    return {};
+  }
+  auto* device = provider.GetDevice();
+  auto handle = slot.heap->GetCPUDescriptorHandleForHeapStart();
+  const auto increment = device->GetDescriptorHandleIncrementSize(
+      D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+  D3D12_SHADER_RESOURCE_VIEW_DESC srv{};
+  srv.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+  srv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+  srv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+  srv.Texture2D.MipLevels = 1;
+  device->CreateShaderResourceView(frame->textures[0].resource.Get(), &srv,
+                                   handle);
+  handle.ptr += increment;
+  srv.Format = DXGI_FORMAT_R16_UNORM;
+  device->CreateShaderResourceView(
+      k.exposure_enabled ? frame->textures[2].resource.Get() : nullptr, &srv,
+      handle);
+  handle.ptr += increment;
+  D3D12_UNORDERED_ACCESS_VIEW_DESC uav{};
+  uav.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+  uav.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+  device->CreateUnorderedAccessView(slot.color.Get(), nullptr, &uav, handle);
+  handle.ptr += increment;
+  uav.Format = DXGI_FORMAT_R32_FLOAT;
+  device->CreateUnorderedAccessView(slot.exposure.Get(), nullptr, &uav, handle);
+  handle.ptr += increment;
+  uav = {};
+  uav.ViewDimension = D3D12_UAV_DIMENSION_BUFFER;
+  uav.Buffer.NumElements = slot.samples;
+  uav.Buffer.StructureByteStride = 16;
+  device->CreateUnorderedAccessView(slot.diagnostics.Get(), nullptr, &uav,
+                                    handle);
+  for (auto* resource :
+       {slot.color.Get(), slot.exposure.Get(), slot.diagnostics.Get()})
+    Transition(list, resource, GuestInputTexture::kReadState,
+               D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  auto* heap = slot.heap.Get();
+  list->SetDescriptorHeaps(1, &heap);
+  list->SetComputeRootSignature(root_.Get());
+  list->SetPipelineState(pipeline_.Get());
+  list->SetComputeRoot32BitConstants(0, sizeof(k) / 4, &k, 0);
+  list->SetComputeRootDescriptorTable(
+      1, heap->GetGPUDescriptorHandleForHeapStart());
+  list->Dispatch((k.width + 7) / 8, (k.height + 7) / 8, 1);
+  for (auto* resource :
+       {slot.color.Get(), slot.exposure.Get(), slot.diagnostics.Get()})
+    Transition(list, resource, D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+               GuestInputTexture::kReadState);
+  slot.input = frame;
+  slot.submission = submission;
+  slot.frame = frame->metadata.guest_frame;
+  if (!last_log_frame_ || slot.frame < last_log_frame_ ||
+      slot.frame - last_log_frame_ >= 120) {
+    Transition(list, slot.diagnostics.Get(), GuestInputTexture::kReadState,
+               D3D12_RESOURCE_STATE_COPY_SOURCE);
+    list->CopyBufferRegion(slot.readback.Get(), 0, slot.diagnostics.Get(), 0,
+                           uint64_t(slot.samples) * 16);
+    Transition(list, slot.diagnostics.Get(), D3D12_RESOURCE_STATE_COPY_SOURCE,
+               GuestInputTexture::kReadState);
+    slot.pending = true;
+    last_log_frame_ = slot.frame;
+  }
+  last_slot_ = chosen;
+  return {slot.color.Get(), slot.exposure.Get(), slot.diagnostics.Get(), true,
+          false};
+}
