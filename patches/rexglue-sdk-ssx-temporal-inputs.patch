+struct SsxColorConstants {
+  uint32_t width = 0, height = 0, exposure_width = 0, exposure_height = 0;
+  float color_scale = 1, exposure_scale = 1, exposure_key = 1, log_scale = 0;
+  uint32_t exposure_enabled = 0, reserved[3]{};
+};
+static_assert(sizeof(SsxColorConstants) == 48);
+// Reject unknown fetch semantics. Does not assert anything about GPU texel
+// values.
+bool PlanSsxSceneColor(const SsxFrameInputs& frame,
+                       SsxColorConstants& constants);
+
+// Separate decoded inputs. The original guest tone map and presentation remain.
+// Triple buffered, paint-thread owner, resources/input references retained to
+// fence.
+class SsxSceneColor {
+ public:
+  struct Result {
+    ID3D12Resource* color =
+        nullptr;  // R16G16B16A16_FLOAT, pre-tone/pre-exposure.
+    ID3D12Resource* exposure =
+        nullptr;  // 1x1 R32_FLOAT; 0 means invalid/nonuniform.
+    ID3D12Resource* diagnostics =
+        nullptr;  // float4[0]: exposure min/max/value/valid.
+    bool dispatched = false, repeated = false;
+    // No DLSS-ready assertion: sampled color diagnostics cannot prove full
+    // validity.
+  };
+  Result Record(const D3D12Provider& provider, ID3D12GraphicsCommandList* list,
+                const std::shared_ptr<const SsxFrameInputs>& frame,
+                uint64_t submission, uint64_t completed);
+
+ private:
+  struct Slot {
+    Microsoft::WRL::ComPtr<ID3D12Resource> color, exposure, diagnostics,
+        readback;
+    Microsoft::WRL::ComPtr<ID3D12DescriptorHeap> heap;
+    std::shared_ptr<const SsxFrameInputs> input;
+    uint64_t submission = 0, frame = 0;
+    uint32_t width = 0, height = 0, samples = 0;
+    bool pending = false;
+  };
+  bool Initialize(const D3D12Provider& provider);
+  bool Prepare(const D3D12Provider& provider, Slot& slot, uint32_t width,
+               uint32_t height);
+  void ReadDiagnostics(Slot& slot);
+  std::array<Slot, 3> slots_;
+  Microsoft::WRL::ComPtr<ID3D12RootSignature> root_;
+  Microsoft::WRL::ComPtr<ID3D12PipelineState> pipeline_;
+  bool unavailable_ = false;
+  int last_slot_ = -1;
+  uint64_t last_log_frame_ = 0;
+};
+}  // namespace rex::ui::d3d12
