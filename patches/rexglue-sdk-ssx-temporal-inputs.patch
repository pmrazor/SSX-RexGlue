+void D3D12CommandProcessor::ApplySsxJitter(uint64_t vs, draw_util::ViewportInfo& viewport) {
+  if (!REXCVAR_GET(d3d12_ssx_jitter) || !REXCVAR_GET(d3d12_ssx_frame_inputs) ||
+      ssx_title_id_ != 0x4541096D) return;
+  if (ssx_jitter_frame_ != frame_current_) {
+    ssx_jitter_frame_ = frame_current_;
+    ssx_jittered_draws_ = ssx_jitter_skipped_draws_ = 0;
+  }
+  const auto sx = texture_cache_->draw_resolution_scale_x();
+  const auto sy = texture_cache_->draw_resolution_scale_y();
+  if (!sx || !sy || viewport.xy_offset[0] || viewport.xy_offset[1] ||
+      viewport.xy_extent[0] % sx || viewport.xy_extent[1] % sy ||
+      !ui::d3d12::IsKnownSsxScene(viewport.xy_extent[0] / sx, viewport.xy_extent[1] / sy)) return;
+  const auto& regs = *register_file_;
+  const auto clip = regs.Get<reg::PA_CL_CLIP_CNTL>();
+  if ((regs.Get<reg::PA_CL_VTE_CNTL>().value & 0x73F) != 0x43F ||
+      clip.clip_disable || !clip.dx_clip_space_def ||
+      regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_ZSCALE) != -1 ||
+      regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_ZOFFSET) != 1) return;
+  if (!ui::d3d12::IsSsxJitterShader(vs)) {
+    ++ssx_jitter_skipped_draws_;
+    return;  // Fullscreen/HUD/unknown shaders never guessed to be scene geometry.
+  }
+  const auto offset = ui::d3d12::SsxJitterNdc(ui::d3d12::SsxJitterPixels(frame_current_),
+                                            viewport.xy_extent[0], viewport.xy_extent[1]);
+  viewport.ndc_offset[0] += offset[0];
+  viewport.ndc_offset[1] += offset[1];
+  ++ssx_jittered_draws_;
+}
