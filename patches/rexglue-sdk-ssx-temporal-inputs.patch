diff --git a/src/ui/shaders/ssx_scene_color.cs.hlsl b/src/ui/shaders/ssx_scene_color.cs.hlsl
new file mode 100644
index 0000000..65bd455
--- /dev/null
+++ b/src/ui/shaders/ssx_scene_color.cs.hlsl
@@ -0,0 +1,56 @@
+// Reconstructed from SSX A2CD8E82699B2C0A, before its rational SDR tone curve.
+// Fetch signs/swizzle/LOD are validated by the CPU plan; raw copies are unfiltered.
+cbuffer Constants : register(b0) {
+  uint2 extent;
+  uint2 exposure_extent;
+  float color_scale;
+  float exposure_scale;
+  float exposure_key;
+  float log_scale;
+  uint exposure_enabled;
+  uint3 reserved;
+};
+Texture2D<float4> encoded_color : register(t0);
+Texture2D<float> log_exposure : register(t1);
+RWTexture2D<float4> linear_color : register(u0);
+RWTexture2D<float> exposure : register(u1);
+RWStructuredBuffer<float4> diagnostic : register(u2);
+[numthreads(8, 8, 1)]
+void main(uint3 id : SV_DispatchThreadID) {
+  if (any(id.xy >= extent)) return;
+  float4 stored = encoded_color.Load(int3(id.xy, 0));
+  float3 decoded = stored.rgb * color_scale;
+  decoded *= decoded;
+  bool valid = all(isfinite(decoded)) && all(decoded <= 65504);
+  // Invalid values are flagged, never described as HDR highlight preservation.
+  linear_color[id.xy] = float4(valid ? decoded : float3(0, 0, 0), 1);
+  if (((id.x | id.y) & 31) == 0) {
+    uint index = 1 + (id.y / 32) * ((extent.x + 31) / 32) + id.x / 32;
+    diagnostic[index] = float4(decoded, valid ? 1 : 0);
+  }
+  if (any(id.xy != 0)) return;
+  float minimum = 1, maximum = 1, value = 1;
+  bool scalar_valid = true;
+  if (exposure_enabled) {
+    minimum = 3.402823466e+38F;
+    maximum = 0;
+    float raw_min = 1, raw_max = 0;
+    [loop] for (uint y = 0; y < exposure_extent.y; ++y) {
+      [loop] for (uint x = 0; x < exposure_extent.x; ++x) {
+        float raw = log_exposure.Load(int3(x, y, 0));
+        float e = exposure_key * exp2(-log_scale * raw * exposure_scale);
+        scalar_valid = scalar_valid && isfinite(e) && e > 0;
+        minimum = min(minimum, e);
+        maximum = max(maximum, e);
+        raw_min = min(raw_min, raw);
+        raw_max = max(raw_max, raw);
+      }
+    }
+    // Exact equality: only a uniform mip has a unique scalar independent of
+    // guest UV/filtering. Never average a spatially varying exposure field.
+    scalar_valid = scalar_valid && raw_min == raw_max;
+    value = scalar_valid ? minimum : 0;
+  }
+  exposure[uint2(0, 0)] = value;
+  diagnostic[0] = float4(minimum, maximum, value, scalar_valid ? 1 : 0);
+}
diff --git a/tests/unit/graphics/ssx_frame_inputs_test.cpp b/tests/unit/graphics/ssx_frame_inputs_test.cpp
index 9efeedd..3937ae9 100644
--- a/tests/unit/graphics/ssx_frame_inputs_test.cpp
+++ b/tests/unit/graphics/ssx_frame_inputs_test.cpp
@@ -60,3 +60,27 @@ TEST_CASE("SSX absent failed and ambiguous resources are not complete", "[ssx-in
   frame.duplicate_mask = 4;
   CHECK_FALSE(frame.RawResourcesComplete());
 }
+
+#include <rex/ui/d3d12/ssx_jitter.h>
+#include <catch2/catch_approx.hpp>
+TEST_CASE("SSX jitter phase is stable bounded host-pixel sized and shader gated", "[ssx-inputs]") {
+  CHECK(IsSsxJitterShader(0xC44105DD14EFDB33ull));
+  CHECK(IsSsxJitterShader(0x9897AE6BB3FD8C0Bull));
+  // Same rider positions are rendered again in later material passes. Both
+  // passes must receive identical jitter or the depth-equal material draw fails.
+  for (uint64_t vs : {0xC68B1C50089DDABEull, 0x6AC767636C7FD2DDull,
+                      0x3B73061891C4300Cull, 0xD3AFB22410B2671Eull})
+    CHECK(IsSsxJitterShader(vs));
+  CHECK_FALSE(IsSsxJitterShader(0xE857B4AF9617DC29ull));
+  CHECK_FALSE(IsSsxJitterShader(0));
+  for (uint64_t frame = 0; frame < 32; ++frame) {
+    const auto j = SsxJitterPixels(frame);
+    CHECK(j == SsxJitterPixels(frame + 16));
+    CHECK(std::abs(j[0]) <= .5f); CHECK(std::abs(j[1]) <= .5f);
+    for (auto size : {std::array<uint32_t,2>{3360,1752}, {3840,2160}}) {
+      const auto ndc = SsxJitterNdc(j, size[0], size[1]);
+      CHECK(ndc[0] * size[0] / 2 == Catch::Approx(j[0]));
+      CHECK(-ndc[1] * size[1] / 2 == Catch::Approx(j[1]));
+    }
+  }
+}
diff --git a/tests/unit/graphics/ssx_motion_test.cpp b/tests/unit/graphics/ssx_motion_test.cpp
index 2561c2f..606c6ca 100644
--- a/tests/unit/graphics/ssx_motion_test.cpp
+++ b/tests/unit/graphics/ssx_motion_test.cpp
@@ -137,3 +137,28 @@ TEST_CASE("SSX invalid or ambiguous camera and depth mappings cannot generate mo
     CHECK(h.Advance(f, 1.03).constants.reset == 1);
   }
 }
+
+TEST_CASE("SSX jitter is removed from motion and mode changes reset history", "[ssx-motion]") {
+  SsxMotionHistory h;
+  auto f = Frame();
+  f.jitter_enabled = true;
+  f.jitter_pixels = {.25f, -.25f};
+  h.Advance(f, 1);
+  f.guest_frame++;
+  f.jitter_pixels = {-.375f, .125f};
+  const auto p = h.Advance(f, 1.01);
+  REQUIRE(p.usable);
+  REQUIRE_FALSE(p.constants.reset);
+  const auto& k = p.constants;
+  for (float pixel : {17.5f, 512.5f, 1600.5f}) {
+    CHECK((pixel * k.pixel_to_clip[0] + k.pixel_to_clip[2]) * k.previous_clip_to_pixel[0] +
+          k.previous_clip_to_pixel[2] - pixel == Catch::Approx(0).margin(.0005));
+    CHECK((pixel * k.pixel_to_clip[1] + k.pixel_to_clip[3]) * k.previous_clip_to_pixel[1] +
+          k.previous_clip_to_pixel[3] - pixel == Catch::Approx(0).margin(.0005));
+  }
+  CHECK(h.Advance(f, 1.02).repeated);
+  f.guest_frame++; f.jitter_enabled = false; f.jitter_pixels = {};
+  CHECK(h.Advance(f, 1.03).constants.reset == 1);
+  f.guest_frame++; f.jitter_pixels[0] = std::numeric_limits<float>::quiet_NaN();
+  CHECK_FALSE(h.Advance(f, 1.04).usable);
+}
