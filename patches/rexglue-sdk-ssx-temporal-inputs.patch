+// Experimental raster jitter for the verified SSX camera shader family.
+#pragma once
+#include <array>
+#include <cstdint>
+
+namespace rex::ui::d3d12 {
+inline bool IsSsxJitterShader(uint64_t vs) {
+  // Audited straight-line c192..195 projection stored directly to oPos.
+  // Includes BOTH normal/depth and later material passes. Raster-only jitter
+  // on the former leaves the latter failing depth equality (purple corruption).
+  // See tools/jitter_shader_audit.py; no guest shader code is embedded here.
+  switch (vs) {
+    case 0x055F9A3939313971ull:
+    case 0x0BD84EEE78FD8CBEull:
+    case 0x0F20F851EA9BECB1ull:
+    case 0x12014C50E9E49E55ull:
+    case 0x1DF106D9BBC3DAB5ull:
+    case 0x1E427E91787634D1ull:
+    case 0x272D6564C1308846ull:
+    case 0x287D26954FF5AD45ull:
+    case 0x295831BA96AB5C97ull:
+    case 0x33AC737525766B5Bull:
+    case 0x3459D7A26FB84C7Dull:
+    case 0x3573BB2462A6F5F5ull:
+    case 0x3B6ED07F781A3914ull:
+    case 0x3B73061891C4300Cull:
+    case 0x3E9EA12E5250B8C4ull:
+    case 0x4349612AC66E8F15ull:
+    case 0x482A43BF1FB7565Bull:
+    case 0x5C28E9735F8C3AEDull:
+    case 0x5CD32258596BF2AEull:
+    case 0x5F453778407AE7DAull:
+    case 0x610E4FE388A0C31Eull:
+    case 0x649EC2CB0DEB26A3ull:
+    case 0x691A6D8072143BB5ull:
+    case 0x6A8EAF3F6492D76Eull:
+    case 0x6AC767636C7FD2DDull:
+    case 0x6E147097CF5A252Aull:
+    case 0x77B81F71D6C0F16Aull:
+    case 0x78ECD524E5C56778ull:
+    case 0x89E3A901BBDFA10Full:
+    case 0x8BD60966296E983Bull:
+    case 0x8C352E246EA106D7ull:
+    case 0x9897AE6BB3FD8C0Bull:
+    case 0x9FE5A1CCED02D99Aull:
+    case 0xA38394F5A2E17866ull:
+    case 0xA49A31B3A2A5A302ull:
+    case 0xAAA9EF936E094D12ull:
+    case 0xAE3803C400E798B4ull:
+    case 0xAF0880F5FD8D12CEull:
+    case 0xAF0AF0332B8F7C86ull:
+    case 0xAFF93F36A4608265ull:
+    case 0xB7704357FF939848ull:
+    case 0xB790B088C126B95Aull:
+    case 0xBC37AFB965F89696ull:
+    case 0xC44105DD14EFDB33ull:
+    case 0xC68B1C50089DDABEull:
+    case 0xC97ADEB23DF6FD62ull:
+    case 0xCB133FCDC47D5E6Aull:
+    case 0xCD03BB2AF23FA8EAull:
+    case 0xD3AFB22410B2671Eull:
+    case 0xDC293B9A91E2B87Full:
+    case 0xE8F989D1CB0A0054ull:
+    case 0xE9A8D82250AAAE8Cull:
+    case 0xEBC15D5C58BC02D6ull:
+    case 0xF41265609B144316ull:
+    case 0xF535D5BBF52F2AE5ull:
+      return true;
+    default:
+      return false;
+  }
+}
+// Pixel displacement in the host scene, +right/+down. Never advance on repaint.
+// A fixed 16-phase sequence is for input validation, not DLSS optimal settings.
+inline std::array<float, 2> SsxJitterPixels(uint64_t guest_frame) {
+  auto radical = [](uint32_t n, uint32_t base) {
+    float result = 0, weight = 1;
+    while (n) {
+      weight /= float(base);
+      result += float(n % base) * weight;
+      n /= base;
+    }
+    return result - .5f;
+  };
+  const uint32_t phase = uint32_t(guest_frame % 16) + 1;
+  return {radical(phase, 2), radical(phase, 3)};
+}
+inline std::array<float, 2> SsxJitterNdc(const std::array<float, 2>& pixels,
+                                         uint32_t width, uint32_t height) {
+  if (!width || !height) return {};
+  return {2 * pixels[0] / float(width), -2 * pixels[1] / float(height)};
+}
+}  // namespace rex::ui::d3d12
