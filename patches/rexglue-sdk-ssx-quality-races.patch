diff --git a/src/graphics/shaders/ssx_edram_rescale.cs.hlsl b/src/graphics/shaders/ssx_edram_rescale.cs.hlsl
new file mode 100644
index 0000000..f478751
--- /dev/null
+++ b/src/graphics/shaders/ssx_edram_rescale.cs.hlsl
@@ -0,0 +1,31 @@
+// Bitwise nearest replication. Color64 has interleaved low/high words;
+// color32 and depth have 40-word half tiles (depth swaps the halves).
+Buffer<uint> source : register(t0);
+RWBuffer<uint> destination : register(u0);
+cbuffer Parameters : register(b0) {
+  uint source_scale, dest_scale, first_tile, tile_count, words_per_pixel, msaa_log2;
+};
+uint resample(uint value, uint samples) {
+  return ((2 * (value / samples) + 1) * source_scale / (2 * dest_scale)) * samples + value % samples;
+}
+[numthreads(256,1,1)]
+void main(uint3 id : SV_DispatchThreadID) {
+  uint words = 1280 * dest_scale * dest_scale;
+  if (id.x >= words || id.y >= tile_count) return;
+  uint y = id.x / (80 * dest_scale);
+  uint x = id.x % (80 * dest_scale);
+  uint sx;
+  uint samples_x = msaa_log2 >= 2 ? 2 : 1;
+  uint samples_y = msaa_log2 >= 1 ? 2 : 1;
+  if (words_per_pixel == 2) {
+    sx = resample(x / 2, samples_x) * 2 + (x & 1);
+  } else {
+    uint half = x / (40 * dest_scale);
+    uint local_x = x % (40 * dest_scale);
+    sx = half * 40 * source_scale + resample(local_x, samples_x);
+  }
+  uint sy = resample(y, samples_y);
+  uint tile = first_tile + id.y;
+  uint offset = tile * 1280 * source_scale * source_scale + sy * 80 * source_scale + sx;
+  destination[tile * words + id.x] = source[offset];
+}
diff --git a/src/graphics/shaders/ssx_quality_extract.cs.hlsl b/src/graphics/shaders/ssx_quality_extract.cs.hlsl
new file mode 100644
index 0000000..43cd746
--- /dev/null
+++ b/src/graphics/shaders/ssx_quality_extract.cs.hlsl
@@ -0,0 +1,9 @@
+// Recover the exact original 2x sample from canonical 3x resolve storage.
+Texture2D<float4> source : register(t0);
+RWTexture2D<float4> destination : register(u0);
+cbuffer Parameters : register(b0) { uint width, height; };
+[numthreads(8,8,1)]
+void main(uint3 id : SV_DispatchThreadID) {
+  if (id.x >= width || id.y >= height) return;
+  destination[id.xy] = source.Load(int3(((2 * id.xy + 1) * 3) / 4, 0));
+}
