+bool D3D12CommandProcessor::SwitchSsxQualityScale(uint32_t scale) {
+  if (render_target_cache_->draw_resolution_scale_x() == scale)
+    return true;
+  if (!ssx_other_render_target_cache_ ||
+      ssx_other_render_target_cache_->draw_resolution_scale_x() != scale)
+    return false;
+  if (!EndSubmission(false) || !BeginSubmission(false))
+    return false;
+  if (!ssx_other_render_target_cache_->RescaleEdramFrom(*render_target_cache_))
+    return false;
+  if (!EndSubmission(false))
+    return false;
+  render_target_cache_.swap(ssx_other_render_target_cache_);
+  pipeline_cache_.swap(ssx_other_pipeline_cache_);
+  // The two caches have independent layout UID namespaces, and the EDRAM UAV
+  // identity has changed. Force new immutable tables, including shared EDRAM.
+  draw_view_bindful_heap_index_ = ui::d3d12::D3D12DescriptorHeapPool::kHeapIndexInvalid;
+  draw_sampler_bindful_heap_index_ = ui::d3d12::D3D12DescriptorHeapPool::kHeapIndexInvalid;
+  bindful_textures_written_vertex_ = bindful_textures_written_pixel_ = false;
+  bindful_samplers_written_vertex_ = bindful_samplers_written_pixel_ = false;
+  current_texture_layout_uid_vertex_ = current_texture_layout_uid_pixel_ = SIZE_MAX;
+  current_sampler_layout_uid_vertex_ = current_sampler_layout_uid_pixel_ = SIZE_MAX;
+  cbuffer_binding_system_.up_to_date = false;
+  cbuffer_binding_float_vertex_.up_to_date = false;
+  cbuffer_binding_float_pixel_.up_to_date = false;
+  return BeginSubmission(true);
+}
+
+bool D3D12CommandProcessor::BeginSsxQualityFrame() {
+  if (!ssx_other_render_target_cache_)
+    return true;
+  if (ssx_title_id_ != 0x4541096D)
+    return false;
+  if (!BeginSubmission(true))
+    return false;
+  if (ssx_quality_frame_ != frame_current_) {
+    ssx_quality_frame_ = frame_current_;
+    ssx_quality_scene_started_ = false;
+    if (!SwitchSsxQualityScale(3))
+      return false;
+  }
+  const auto& regs = *register_file_;
+  if (ssx_quality_scene_started_ || ssx_reconstruction_failed_ ||
+      regs.Get<reg::RB_MODECONTROL>().edram_mode != xenos::EdramMode::kColorDepth ||
+      regs.Get<reg::RB_SURFACE_INFO>().msaa_samples != xenos::MsaaSamples::k1X)
+    return true;
+  const auto clip = regs.Get<reg::PA_CL_CLIP_CNTL>();
+  if ((regs.Get<reg::PA_CL_VTE_CNTL>().value & 0x73F) != 0x43F || clip.clip_disable ||
+      !clip.dx_clip_space_def)
+    return true;
+  const auto depth = regs.Get<reg::RB_DEPTH_INFO>();
+  if (depth.depth_base != 720 || depth.depth_base_bit_11 ||
+      depth.depth_format != xenos::DepthRenderTargetFormat::kD24FS8)
+    return true;
+  draw_util::ViewportInfo viewport;
+  draw_util::GetHostViewportInfo(
+      regs, 1, 1, true, D3D12_VIEWPORT_BOUNDS_MAX, D3D12_VIEWPORT_BOUNDS_MAX, false,
+      draw_util::GetNormalizedDepthControl(regs), false, false, false, viewport);
+  if (viewport.xy_offset[0] || viewport.xy_offset[1] ||
+      !ui::d3d12::IsKnownSsxScene(viewport.xy_extent[0], viewport.xy_extent[1]))
+    return true;
+  ssx_quality_scene_started_ = true;
+  return SwitchSsxQualityScale(2);
+}
