+bool D3D12CommandProcessor::ResolveSsxQuality(uint32_t& address, uint32_t& length) {
+  if (!ssx_other_render_target_cache_ || render_target_cache_->draw_resolution_scale_x() == 3)
+    return render_target_cache_->Resolve(*memory_, *shared_memory_, *texture_cache_, address,
+                                         length);
+  // Resolve storage stays at 3x, independent of native raster resolution.
+  // Copy and clear only touched EDRAM tile spans, including depth clears.
+  draw_util::ResolveInfo info;
+  if (!draw_util::GetResolveInfo(*register_file_, *memory_, 3, 3, false, false, info))
+    return false;
+  if (!info.coordinate_info.width_div_8 || !info.height_div_8) {
+    address = length = 0;
+    return true;
+  }
+  std::vector<std::pair<uint32_t, uint32_t>> spans;
+  auto add = [&](draw_util::ResolveEdramInfo edram) {
+    uint32_t base, width, rows;
+    draw_util::GetResolveEdramTileSpan(edram, info.coordinate_info, info.height_div_8, base, width,
+                                       rows);
+    const uint32_t tiles = xenos::kEdramSizeBytes / 5120;
+    for (uint32_t row = 0; row < rows; ++row) {
+      const uint32_t tile = base + row * edram.pitch_tiles;
+      if (!width || tile >= tiles)
+        continue;
+      const uint32_t count = std::min(width, tiles - tile);
+      render_target_cache_->SetEdramWordsPerPixel(tile, count, edram.format_is_64bpp ? 2 : 1);
+      render_target_cache_->SetEdramSampleCountLog2(tile, count, uint32_t(edram.msaa_samples));
+      spans.emplace_back(tile, count);
+    }
+  };
+  if (info.copy_dest_extent_length)
+    add(info.IsCopyingDepth() ? info.depth_edram_info : info.color_edram_info);
+  if (info.IsClearingDepth())
+    add(info.depth_edram_info);
+  if (info.IsClearingColor())
+    add(info.color_edram_info);
+  // Coalesce adjacent rows when the resolve rectangle fills its tile pitch.
+  std::vector<std::pair<uint32_t, uint32_t>> merged;
+  for (auto [base, count] : spans) {
+    if (!merged.empty() && merged.back().first + merged.back().second == base)
+      merged.back().second += count;
+    else
+      merged.emplace_back(base, count);
+  }
+  spans.swap(merged);
+  for (auto [base, count] : spans)
+    if (!ssx_other_render_target_cache_->RescaleEdramFrom(*render_target_cache_, base, count))
+      return false;
+  if (!ssx_other_render_target_cache_->Resolve(*memory_, *shared_memory_, *texture_cache_, address,
+                                               length))
+    return false;
+  // Clear values propagate exactly back into the native samples. Overlapping
+  // spans are harmless; no filtering of packed words occurs in either direction.
+  if (info.IsClearingDepth() || info.IsClearingColor())
+    for (auto [base, count] : spans)
+      if (!render_target_cache_->RescaleEdramFrom(*ssx_other_render_target_cache_, base, count))
+        return false;
+  return true;
+}
