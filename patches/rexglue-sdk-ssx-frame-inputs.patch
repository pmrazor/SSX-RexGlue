+#include <catch2/catch_test_macros.hpp>
+#include <rex/ui/d3d12/guest_frame_inputs.h>
+
+using namespace rex::ui::d3d12;
+
+TEST_CASE("SSX pass selection excludes bloom and unrelated titles", "[ssx-inputs]") {
+  constexpr uint32_t title = 0x4541096D;
+  constexpr uint64_t tone_vs = 0xE857B4AF9617DC29ull, tone_ps = 0xA2CD8E82699B2C0Aull;
+  CHECK(IdentifySsxPass(title, tone_vs, tone_ps, 1120, 584) == SsxPass::kToneMap);
+  CHECK(IdentifySsxPass(title, tone_vs, tone_ps, 1280, 720) == SsxPass::kToneMap);
+  CHECK(IdentifySsxPass(title, tone_vs, tone_ps, 280, 146) == SsxPass::kNone);
+  CHECK(IdentifySsxPass(title, tone_vs, tone_ps, 3360, 1752) == SsxPass::kNone);
+  CHECK(IdentifySsxPass(0, tone_vs, tone_ps, 1120, 584) == SsxPass::kNone);
+  CHECK(IdentifySsxPass(title, tone_vs, tone_ps ^ 1, 1120, 584) == SsxPass::kNone);
+  CHECK(IdentifySsxPass(title, 0x7365E5786AD4C10Cull, 0x0E6C83314BF3FBA1ull, 560, 292) ==
+        SsxPass::kDepthReduction);
+  CHECK(IdentifySsxPass(title, 0x7365E5786AD4C10Cull, 0x0E6C83314BF3FBA1ull, 640, 360) ==
+        SsxPass::kDepthReduction);
+  CHECK(IdentifySsxPass(title, 0x7365E5786AD4C10Cull, 0x0E6C83314BF3FBA1ull, 0x80000230, 292) ==
+        SsxPass::kNone);
+  CHECK(IdentifySsxPass(title, 0xC44105DD14EFDB33ull, 0, 1120, 584) == SsxPass::kWorldTransform);
+}
+
+TEST_CASE("SSX pool never overwrites a CPU-held or GPU-pending frame", "[ssx-inputs]") {
+  SsxFrameInputPool pool;
+  std::array<std::shared_ptr<const SsxFrameInputs>, SsxFrameInputPool::kSlotCount> mailbox;
+  for (size_t i = 0; i < mailbox.size(); ++i) {
+    auto frame = pool.Acquire(100 + i, 0);
+    REQUIRE(frame);
+    frame->last_copy_submission = 20 + i;
+    frame->metadata.captured_mask = 7;
+    mailbox[i] = std::move(frame);
+  }
+  CHECK_FALSE(pool.Acquire(200, 100));  // GPU complete, but CPU consumers own every slot.
+  mailbox[0].reset();
+  CHECK_FALSE(pool.Acquire(200, 19));  // CPU released, but producer GPU still writing.
+  auto recycled = pool.Acquire(200, 20);
+  REQUIRE(recycled);
+  CHECK(recycled->metadata.guest_frame == 200);
+  CHECK(recycled->metadata.captured_mask == 0);
+  CHECK_FALSE(recycled->metadata.RawResourcesComplete());
+  CHECK(mailbox[1]->metadata.guest_frame == 101);
+  CHECK(mailbox[1]->metadata.RawResourcesComplete());
+  pool.Clear();
+  CHECK(mailbox[1]->metadata.RawResourcesComplete());  // Shutdown leaves consumers' refs intact.
+}
+
+TEST_CASE("SSX absent failed and ambiguous resources are not complete", "[ssx-inputs]") {
+  SsxFrameMetadata frame;
+  CHECK_FALSE(frame.RawResourcesComplete());
+  frame.captured_mask = 1;
+  CHECK(frame.Has(SsxInput::kEncodedColor));
+  CHECK_FALSE(frame.Has(SsxInput::kResolvedDepth));
+  CHECK_FALSE(frame.RawResourcesComplete());
+  frame.captured_mask = 7;
+  CHECK(frame.RawResourcesComplete());
+  frame.failed_mask = 2;
+  CHECK_FALSE(frame.RawResourcesComplete());
+  frame.failed_mask = 0;
+  frame.duplicate_mask = 4;
+  CHECK_FALSE(frame.RawResourcesComplete());
+}
