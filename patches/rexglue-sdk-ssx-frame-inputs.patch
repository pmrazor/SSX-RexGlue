diff --git a/src/ui/d3d12/guest_frame_inputs.cpp b/src/ui/d3d12/guest_frame_inputs.cpp
new file mode 100644
index 0000000..f595679
--- /dev/null
+++ b/src/ui/d3d12/guest_frame_inputs.cpp
@@ -0,0 +1,65 @@
+#include <rex/ui/d3d12/guest_frame_inputs.h>
+
+namespace rex::ui::d3d12 {
+bool GuestInputTexture::Prepare(ID3D12Device* device, DXGI_FORMAT format, uint32_t new_width,
+                                uint32_t new_height, bool& newly_created) {
+  newly_created = false;
+  if (!device || !new_width || !new_height || new_width > D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+      new_height > D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION)
+    return false;
+  if (resource && width == new_width && height == new_height &&
+      resource->GetDesc().Format == format)
+    return true;
+  // These are the three observed SSX input storage formats. Do not silently
+  // reinterpret a different resource as depth/color/exposure.
+  if (format != DXGI_FORMAT_R16G16B16A16_FLOAT && format != DXGI_FORMAT_R32_FLOAT &&
+      format != DXGI_FORMAT_R16_TYPELESS)
+    return false;
+  D3D12_RESOURCE_DESC desc{};
+  desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+  desc.Width = new_width;
+  desc.Height = new_height;
+  desc.DepthOrArraySize = 1;
+  desc.MipLevels = 1;
+  desc.Format = format;
+  desc.SampleDesc.Count = 1;
+  D3D12_HEAP_PROPERTIES heap{};
+  heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+  Microsoft::WRL::ComPtr<ID3D12Resource> replacement;
+  if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc,
+                                             D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                             IID_PPV_ARGS(&replacement))))
+    return false;
+  resource = std::move(replacement);
+  width = new_width;
+  height = new_height;
+  newly_created = true;
+  return true;
+}
+uint32_t GuestInputTexture::GetCopyRestoreBarriers(
+    ID3D12Resource* source, D3D12_RESOURCE_STATES source_state, uint32_t mip,
+    std::array<D3D12_RESOURCE_BARRIER, 3>& out) const {
+  uint32_t count = 0;
+  auto add = [&](ID3D12Resource* texture, D3D12_RESOURCE_STATES before,
+                 D3D12_RESOURCE_STATES after) {
+    if (before == after)
+      return;
+    auto& barrier = out[count++];
+    barrier = {};
+    barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier.Transition = {texture, D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES, before, after};
+  };
+  auto before = D3D12_RESOURCE_STATE_COPY_SOURCE;
+  if (mip) {
+    // The RTX 5090 probe observed later source writes leaking into a tiny mip
+    // snapshot with only COPY_SOURCE -> SRV restoration. Passing through COMMON
+    // preserves the copy under that same test, including batched barriers. Keep
+    // this path shared with the probe; do not trade correctness for fewer barriers.
+    add(source, before, D3D12_RESOURCE_STATE_COMMON);
+    before = D3D12_RESOURCE_STATE_COMMON;
+  }
+  add(source, before, source_state);
+  add(resource.Get(), D3D12_RESOURCE_STATE_COPY_DEST, kReadState);
+  return count;
+}
+}  // namespace rex::ui::d3d12
