+bool D3D12TextureCache::GetActiveTextureSnapshotSource(
+    uint32_t fetch_index, ActiveTextureSnapshotSource& out) const {
+  out = {};
+  if (fetch_index >= 32) return false;
+  const auto* binding = GetValidTextureBinding(fetch_index);
+  if (!binding || !binding->texture || binding->texture_signed ||
+      binding->key.dimension != xenos::DataDimension::k2DOrStacked ||
+      binding->key.GetDepthOrArraySize() != 1) return false;
+  const auto* texture = static_cast<const D3D12Texture*>(binding->texture);
+  const auto desc = texture->resource()->GetDesc();
+  if (desc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D ||
+      desc.SampleDesc.Count != 1 || desc.DepthOrArraySize != 1) return false;
+  out.resource = texture->resource();
+  out.state = texture->resource_state();
+  out.guest_width = binding->key.GetWidth();
+  out.guest_height = binding->key.GetHeight();
+  out.guest_address = binding->key.base_page << 12;
+  out.host_swizzle = binding->host_swizzle;
+  // Floating-point SSX color uses signed fetch components (0x55), even though
+  // signed and unsigned views share storage. Preserve interpretation metadata.
+  out.swizzled_signs = binding->swizzled_signs;
+  const auto fetch = register_file().GetTextureFetch(fetch_index);
+  static_assert(sizeof(fetch) == sizeof(out.guest_fetch));
+  std::memcpy(out.guest_fetch.data(), &fetch, sizeof(fetch));
+  // FindOrCreateTexture selects scaled storage on its copy of the key. The
+  // original guest binding key is not updated (see IsTextureBindingScaled).
+  out.scaled = texture->key().scaled_resolve;
+  return true;
+}
