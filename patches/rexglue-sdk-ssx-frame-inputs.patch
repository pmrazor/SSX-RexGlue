diff --git a/src/graphics/d3d12/ssx_frame_inputs.cpp b/src/graphics/d3d12/ssx_frame_inputs.cpp
new file mode 100644
index 0000000..db00f84
--- /dev/null
+++ b/src/graphics/d3d12/ssx_frame_inputs.cpp
@@ -0,0 +1,207 @@
+#include <rex/graphics/d3d12/command_processor.h>
+
+#include <cmath>
+#include <cstring>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_BOOL(d3d12_ssx_frame_inputs, false, "GPU/D3D12",
+                    "Collect SSX color/depth/exposure and transform candidates (not DLSS-ready)")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+
+namespace rex::graphics::d3d12 {
+using ui::d3d12::GuestInputTexture;
+using ui::d3d12::IdentifySsxPass;
+using ui::d3d12::SsxInput;
+using ui::d3d12::SsxPass;
+
+bool D3D12CommandProcessor::CopySsxInputTexture(SsxInput role, uint32_t fetch, DXGI_FORMAT format,
+                                                uint32_t mip) {
+  auto& metadata = ssx_inputs_->metadata;
+  const auto bit = 1u << size_t(role);
+  if ((metadata.captured_mask | metadata.failed_mask) & bit) {
+    metadata.duplicate_mask |= bit;
+    return false;
+  }
+  metadata.failed_mask |= bit;  // Every early return invalidates this input.
+  D3D12TextureCache::ActiveTextureSnapshotSource source;
+  if (!texture_cache_->GetActiveTextureSnapshotSource(fetch, source))
+    return false;
+  auto desc = source.resource->GetDesc();
+  if (desc.Format != format || mip >= desc.MipLevels)
+    return false;
+  const uint32_t sx = source.scaled ? metadata.scale_x : 1;
+  const uint32_t sy = source.scaled ? metadata.scale_y : 1;
+  const uint32_t width = std::max(1u, uint32_t(desc.Width) >> mip);
+  const uint32_t height = std::max(1u, desc.Height >> mip);
+  if (role == SsxInput::kLogExposure) {
+    // At 3x the last guest mip may be a small grid; don't invent a scalar.
+    if (width > 8 || height > 8)
+      return false;
+  } else if (source.guest_width != metadata.scene_width ||
+             source.guest_height != metadata.scene_height || mip != 0 ||
+             width != metadata.scene_width * sx || height != metadata.scene_height * sy ||
+             sx != metadata.scale_x || sy != metadata.scale_y)
+    return false;
+  auto& snapshot = ssx_inputs_->textures[size_t(role)];
+  bool created;
+  if (!snapshot.Prepare(GetD3D12Provider().GetDevice(), format, width, height, created))
+    return false;
+  if (created) {
+    static constexpr const wchar_t* names[] = {L"SSX encoded scene color snapshot",
+                                               L"SSX resolved depth snapshot",
+                                               L"SSX log exposure snapshot"};
+    snapshot.resource->SetName(names[size_t(role)]);
+  }
+  snapshot.source_mip = mip;
+  snapshot.guest_address = source.guest_address;
+  snapshot.host_swizzle = source.host_swizzle;
+  snapshot.swizzled_signs = source.swizzled_signs;
+  snapshot.guest_fetch = source.guest_fetch;
+  snapshot.view_format = role == SsxInput::kLogExposure ? DXGI_FORMAT_R16_UNORM : format;
+  // Flush RequestTextures' transitions, copy, then restore the exact tracked
+  // source state before the guest draw. Copying doesn't change graphics bindings.
+  PushTransitionBarrier(source.resource, source.state, D3D12_RESOURCE_STATE_COPY_SOURCE);
+  if (!created)
+    PushTransitionBarrier(snapshot.resource.Get(), GuestInputTexture::kReadState,
+                          D3D12_RESOURCE_STATE_COPY_DEST);
+  SubmitBarriers();
+  D3D12_TEXTURE_COPY_LOCATION from{};
+  from.pResource = source.resource;
+  from.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  from.SubresourceIndex = mip;
+  D3D12_TEXTURE_COPY_LOCATION to{};
+  to.pResource = snapshot.resource.Get();
+  to.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  deferred_command_list_.D3DCopyTextureRegion(&to, 0, 0, 0, &from, nullptr);
+  std::array<D3D12_RESOURCE_BARRIER, 3> restore;
+  const auto restore_count =
+      snapshot.GetCopyRestoreBarriers(source.resource, source.state, mip, restore);
+  deferred_command_list_.D3DResourceBarrier(restore_count, restore.data());
+  ssx_inputs_->last_copy_submission = submission_current_;
+  metadata.captured_mask |= bit;
+  metadata.failed_mask &= ~bit;
+  return true;
+}
+
+void D3D12CommandProcessor::CollectSsxFrameInputs(uint64_t vs, uint64_t ps,
+                                                  const draw_util::ViewportInfo& viewport) {
+  if (!REXCVAR_GET(d3d12_ssx_frame_inputs) || ssx_title_id_ != 0x4541096D)
+    return;
+  const auto sx = texture_cache_->draw_resolution_scale_x();
+  const auto sy = texture_cache_->draw_resolution_scale_y();
+  if (!sx || !sy || viewport.xy_offset[0] || viewport.xy_offset[1] || viewport.xy_extent[0] % sx ||
+      viewport.xy_extent[1] % sy)
+    return;
+  const uint32_t width = viewport.xy_extent[0] / sx;
+  const uint32_t height = viewport.xy_extent[1] / sy;
+  const auto pass = IdentifySsxPass(ssx_title_id_, vs, ps, width, height);
+  if (pass == SsxPass::kNone)
+    return;
+  if (ssx_input_attempt_frame_ != frame_current_) {
+    ssx_inputs_.reset();
+    ssx_input_attempt_frame_ = frame_current_;
+    ssx_inputs_ = ssx_input_pool_.Acquire(frame_current_, submission_completed_);
+  }
+  if (!ssx_inputs_)
+    return;  // Bounded pool full: skip collection, not gameplay.
+  auto& metadata = ssx_inputs_->metadata;
+  const auto scene_width = pass == SsxPass::kDepthReduction ? width * 2 : width;
+  const auto scene_height = pass == SsxPass::kDepthReduction ? height * 2 : height;
+  if (metadata.scene_width &&
+      (metadata.scene_width != scene_width || metadata.scene_height != scene_height)) {
+    metadata.failed_mask = 7;
+    return;
+  }
+  metadata.scene_width = scene_width;
+  metadata.scene_height = scene_height;
+  metadata.scale_x = sx;
+  metadata.scale_y = sy;
+  const auto& regs = *register_file_;
+  if (pass == SsxPass::kWorldTransform) {
+    std::array<float, 16> candidate;
+    std::memcpy(candidate.data(), &regs[XE_GPU_REG_SHADER_CONSTANT_000_X + 192 * 4],
+                sizeof(candidate));
+    for (float value : candidate)
+      if (!std::isfinite(value))
+        metadata.camera_conflict = true;
+    if (metadata.camera_samples++) {
+      if (metadata.world_to_clip_candidate != candidate)
+        metadata.camera_conflict = true;
+    } else {
+      metadata.world_to_clip_candidate = candidate;
+      std::memcpy(metadata.first_object_to_world.data(),
+                  &regs[XE_GPU_REG_SHADER_CONSTANT_000_X + 244 * 4], sizeof(candidate));
+      metadata.guest_viewport_z = {regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_ZSCALE),
+                                   regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_ZOFFSET)};
+      metadata.guest_depth_info = regs[XE_GPU_REG_RB_DEPTH_INFO];
+    }
+  } else if (pass == SsxPass::kToneMap) {
+    CopySsxInputTexture(SsxInput::kEncodedColor, 0, DXGI_FORMAT_R16G16B16A16_FLOAT);
+    std::memcpy(metadata.tone_map_constants.data(), &regs[XE_GPU_REG_SHADER_CONSTANT_256_X],
+                9 * 4 * sizeof(float));
+    std::memcpy(metadata.tone_map_constants.data() + 36,
+                &regs[XE_GPU_REG_SHADER_CONSTANT_256_X + 255 * 4], 4 * sizeof(float));
+    metadata.exposure_branch = (regs[XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031 + 4] & 1) != 0;
+    const float lod = metadata.tone_map_constants[4];
+    if (metadata.exposure_branch && std::isfinite(lod) && lod >= 0 && lod <= 15 &&
+        std::floor(lod) == lod) {
+      metadata.exposure_source_mip = uint32_t(lod);
+      CopySsxInputTexture(SsxInput::kLogExposure, 1, DXGI_FORMAT_R16_TYPELESS, uint32_t(lod));
+    } else
+      metadata.failed_mask |= 1u << size_t(SsxInput::kLogExposure);
+  } else if (pass == SsxPass::kDepthReduction) {
+    CopySsxInputTexture(SsxInput::kResolvedDepth, 0, DXGI_FORMAT_R32_FLOAT);
+  }
+}
+
+std::shared_ptr<const ui::d3d12::SsxFrameInputs> D3D12CommandProcessor::SealSsxFrameInputs(
+    uint32_t width, uint32_t height) {
+  if (!REXCVAR_GET(d3d12_ssx_frame_inputs))
+    return nullptr;
+  bool log = !ssx_last_input_log_frame_ || frame_current_ - ssx_last_input_log_frame_ >= 120;
+  if (log)
+    ssx_last_input_log_frame_ = frame_current_;
+  if (!ssx_inputs_ || ssx_inputs_->metadata.guest_frame != frame_current_) {
+    if (log)
+      REXGPU_INFO("SSX_INPUTS frame={} title={:08X} packet=missing reason={} dlss_ready=false",
+                  frame_current_, ssx_title_id_,
+                  ssx_input_attempt_frame_ == frame_current_ ? "pool_busy" : "no_matching_pass");
+    return nullptr;
+  }
+  auto& data = ssx_inputs_->metadata;
+  data.output_width = width;
+  data.output_height = height;
+  if (log) {
+    REXGPU_INFO(
+        "SSX_INPUTS frame={} scene={}x{} scale={}x{} captured={:X} failed={:X} "
+        "duplicates={:X} camera_samples={} camera_conflict={} exposure_mip={} "
+        "color_encoding=sqrt depth_convention=unverified dlss_ready=false",
+        data.guest_frame, data.scene_width, data.scene_height, data.scale_x, data.scale_y,
+        data.captured_mask, data.failed_mask, data.duplicate_mask, data.camera_samples,
+        data.camera_conflict, data.exposure_source_mip);
+    for (size_t i = 0; i < size_t(SsxInput::kCount); ++i) {
+      if (!data.Has(SsxInput(i)))
+        continue;
+      const auto& texture = ssx_inputs_->textures[i];
+      const auto& f = texture.guest_fetch;
+      REXGPU_INFO(
+          "SSX_INPUT_TEXTURE frame={} role={} size={}x{} mip={} format={} "
+          "address={:08X} swizzle={:X} signs={:X} fetch={:08X},{:08X},{:08X},{:08X},{:08X},{:08X}",
+          data.guest_frame, i, texture.width, texture.height, texture.source_mip,
+          uint32_t(texture.view_format), texture.guest_address, texture.host_swizzle,
+          texture.swizzled_signs, f[0], f[1], f[2], f[3], f[4], f[5]);
+    }
+    if (data.camera_samples) {
+      const auto& m = data.world_to_clip_candidate;
+      REXGPU_INFO(
+          "SSX_INPUT_CAMERA frame={} guest_z_scale={} guest_z_offset={} depth_info={:08X} "
+          "world_to_clip={},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{}",
+          data.guest_frame, data.guest_viewport_z[0], data.guest_viewport_z[1],
+          data.guest_depth_info, m[0], m[1], m[2], m[3], m[4], m[5], m[6], m[7], m[8], m[9], m[10],
+          m[11], m[12], m[13], m[14], m[15]);
+    }
+  }
+  return ssx_inputs_;
+}
+}  // namespace rex::graphics::d3d12
