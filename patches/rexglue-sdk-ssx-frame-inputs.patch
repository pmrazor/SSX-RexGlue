diff --git a/include/rex/ui/d3d12/guest_frame_inputs.h b/include/rex/ui/d3d12/guest_frame_inputs.h
new file mode 100644
index 0000000..be7fe91
--- /dev/null
+++ b/include/rex/ui/d3d12/guest_frame_inputs.h
@@ -0,0 +1,120 @@
+// SSX input collection checkpoint. Raw candidates are not DLSS-ready inputs.
+#pragma once
+
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <memory>
+
+#include <rex/ui/d3d12/d3d12_api.h>
+
+namespace rex::ui::d3d12 {
+
+enum class SsxInput : size_t { kEncodedColor, kResolvedDepth, kLogExposure, kCount };
+enum class SsxPass { kNone, kWorldTransform, kToneMap, kDepthReduction };
+
+inline bool IsKnownSsxScene(uint32_t width, uint32_t height) {
+  return (width == 1120 && height == 584) || (width == 1280 && height == 720);
+}
+
+// Guest dimensions, not host allocation dimensions. Excludes the quarter-size
+// tone-map draw which uses the same shaders as the full scene.
+inline SsxPass IdentifySsxPass(uint32_t title, uint64_t vs, uint64_t ps, uint32_t width,
+                               uint32_t height) {
+  if (title != 0x4541096D)
+    return SsxPass::kNone;
+  if (IsKnownSsxScene(width, height)) {
+    if (vs == 0xC44105DD14EFDB33ull)
+      return SsxPass::kWorldTransform;
+    if (vs == 0xE857B4AF9617DC29ull && ps == 0xA2CD8E82699B2C0Aull)
+      return SsxPass::kToneMap;
+  }
+  if (((width == 560 && height == 292) || (width == 640 && height == 360)) &&
+      vs == 0x7365E5786AD4C10Cull && ps == 0x0E6C83314BF3FBA1ull)
+    return SsxPass::kDepthReduction;
+  return SsxPass::kNone;
+}
+
+struct SsxFrameMetadata {
+  uint64_t guest_frame = 0;
+  uint32_t scene_width = 0, scene_height = 0;
+  uint32_t scale_x = 0, scale_y = 0;
+  uint32_t output_width = 0, output_height = 0;
+  uint32_t captured_mask = 0;
+  uint32_t failed_mask = 0;
+  uint32_t duplicate_mask = 0;
+  uint32_t camera_samples = 0;
+  bool camera_conflict = false;
+  bool exposure_branch = false;
+  // Shader C441... first applies c244..247 to the vertex, then c192..195
+  // to that result. Keep both separately; never call their product a camera.
+  std::array<float, 16> world_to_clip_candidate{};
+  std::array<float, 16> first_object_to_world{};
+  std::array<float, 2> guest_viewport_z{};
+  uint32_t guest_depth_info = 0;
+  // Guest PS c0..8 and c255, in register order (not packed host CB indices).
+  std::array<float, 40> tone_map_constants{};
+  uint32_t exposure_source_mip = 0;
+
+  bool Has(SsxInput role) const { return (captured_mask & (1u << size_t(role))) != 0; }
+  bool RawResourcesComplete() const {
+    return captured_mask == 7 && failed_mask == 0 && duplicate_mask == 0;
+  }
+  // Projection/depth convention, jitter, previous camera and dense object motion
+  // are intentionally NOT marked valid by this collection checkpoint.
+};
+
+struct GuestInputTexture {
+  Microsoft::WRL::ComPtr<ID3D12Resource> resource;
+  DXGI_FORMAT view_format = DXGI_FORMAT_UNKNOWN;
+  uint32_t host_swizzle = 0;
+  uint32_t swizzled_signs = 0;
+  // Unmodified fetch words include guest swizzle, sign, exponent adjustment,
+  // mip range and filtering. Copying the storage does not apply these to texels.
+  std::array<uint32_t, 6> guest_fetch{};
+  uint32_t guest_address = 0;
+  uint32_t source_mip = 0;
+  uint32_t width = 0, height = 0;
+  static constexpr D3D12_RESOURCE_STATES kReadState =
+      D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+
+  // Only call on a pool slot which is CPU-exclusive and whose copy fence has
+  // completed. The pool caller establishes this lifetime guarantee; Prepare
+  // checks dimensions, format and allocation success, not fences or references.
+  bool Prepare(ID3D12Device* device, DXGI_FORMAT format, uint32_t new_width, uint32_t new_height,
+               bool& newly_created);
+  uint32_t GetCopyRestoreBarriers(ID3D12Resource* source, D3D12_RESOURCE_STATES source_state,
+                                  uint32_t mip, std::array<D3D12_RESOURCE_BARRIER, 3>& out) const;
+};
+
+struct SsxFrameInputs {
+  SsxFrameMetadata metadata;
+  std::array<GuestInputTexture, size_t(SsxInput::kCount)> textures;
+  uint64_t last_copy_submission = 0;
+};
+
+// Bounded memory and no waits on the game thread. Mailbox and paint references
+// keep a slot immutable; its producing GPU submission must also have completed.
+class SsxFrameInputPool {
+ public:
+  static constexpr size_t kSlotCount = 6;
+  std::shared_ptr<SsxFrameInputs> Acquire(uint64_t frame, uint64_t completed_submission) {
+    for (auto& slot : slots_) {
+      if (!slot)
+        slot = std::make_shared<SsxFrameInputs>();
+      if (slot.use_count() != 1 || slot->last_copy_submission > completed_submission)
+        continue;
+      slot->metadata = {};
+      slot->metadata.guest_frame = frame;
+      return slot;
+    }
+    return nullptr;
+  }
+  // Caller drains the producer queue first; consumers retain their own refs.
+  void Clear() { slots_ = {}; }
+
+ private:
+  std::array<std::shared_ptr<SsxFrameInputs>, kSlotCount> slots_;
+};
+
+}  // namespace rex::ui::d3d12
