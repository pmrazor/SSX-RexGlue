+void D3D12CommandProcessor::BeginRenderDocGuestCapture() {
+  if (!renderdoc_guest_capture_requested.exchange(false)) {
+    return;
+  }
+  if (!renderdoc_api_) {
+    renderdoc_api_ = ui::RenderDocAPI::CreateIfConnected();
+  }
+  if (!renderdoc_api_) {
+    REXGPU_WARN("SSX_CAPTURE unavailable; launch this build through RenderDoc first");
+    return;
+  }
+  const auto* api = renderdoc_api_->api_1_0_0();
+  if (api->IsFrameCapturing()) {
+    REXGPU_WARN("SSX_CAPTURE skipped; another RenderDoc capture is already active");
+    return;
+  }
+  // A null window deliberately selects device capture: the guest renderer
+  // produces an offscreen image, and the independent UI may present it later.
+  api->StartFrameCapture(GetD3D12Provider().GetDevice(), nullptr);
+  renderdoc_capture_owned_ = api->IsFrameCapturing() != 0;
+  if (renderdoc_capture_owned_) {
+    REXGPU_INFO("SSX_CAPTURE begin guest_frame={}", frame_current_);
+  } else {
+    REXGPU_WARN("SSX_CAPTURE RenderDoc did not start a capture");
+  }
+}
+
+void D3D12CommandProcessor::EndRenderDocGuestCapture() {
+  if (!renderdoc_capture_owned_) {
+    return;
+  }
+  renderdoc_capture_owned_ = false;
+  const auto* api = renderdoc_api_->api_1_0_0();
+  const bool saved = api->EndFrameCapture(GetD3D12Provider().GetDevice(), nullptr) != 0;
+  REXGPU_INFO("SSX_CAPTURE end guest_frame={} saved={}", frame_current_, saved);
+}
