 using rex::ui::GuestReflex;
 using namespace std::chrono_literals;
 
+TEST_CASE("SSX render-driven Reflex permits extra renders between physics jobs", "[ssx-reflex]") {
+  GuestReflex scheduler;
+  unsigned begin_count = 0, input_count = 0, end_count = 0;
+  GuestReflex::Backend backend;
+  backend.begin = [&](uint64_t) {
+    ++begin_count;
+    return true;
+  };
+  backend.end = [&](uint64_t) {
+    ++end_count;
+    return true;
+  };
+  backend.bind = [](uint64_t a, uint64_t b) { return a == b; };
+  scheduler.Attach(&scheduler, backend, true);
+  // No physics tick is due: rendering must not wait for a 30 Hz worker.
+  for (uint64_t render = 20; render < 24; ++render) {
+    REQUIRE(scheduler.BeginRenderUpdate(render, [&] {
+      ++input_count;
+      return true;
+    }));
+    GuestReflex::Sample ignored;
+    CHECK_FALSE(scheduler.Selection(render, 1, ignored));  // Original interpolation survives.
+    scheduler.Complete(render);
+  }
+  CHECK(begin_count == 4);
+  CHECK(end_count == 4);
+  CHECK(input_count == 4);
+
+  std::atomic<bool> begun{false};
+  std::atomic<uint64_t> consumed{0};
+  std::thread worker([&] {
+    begun = scheduler.BeginWorker(100);
+    if (begun) {
+      consumed = scheduler.InputUpdateForWorker(100);
+      scheduler.Input(100);
+      for (uint32_t user = 0; user < 4; ++user)
+        scheduler.ConsumedInput(100, consumed.load(), user);
+      scheduler.Published(100, {uint64_t(1) << 32 | 10, 1, 123});
+      scheduler.Published(100, {uint64_t(2) << 32 | 20, 2, 123});
+      scheduler.EndWorker(100);
+    }
+  });
+  // Scheduling need not put the worker first. Keep rendering without depending
