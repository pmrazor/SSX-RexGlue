diff --git a/include/rex/ui/frame_generation_stats.h b/include/rex/ui/frame_generation_stats.h
new file mode 100644
index 0000000..568ed78
--- /dev/null
+++ b/include/rex/ui/frame_generation_stats.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <cstdint>
+#include <mutex>
+
+namespace rex::ui {
+// One presenter publishes actual backend presentation counts. UI readers never
+// query Streamline (GetState consumes its counters), or multiply guest FPS.
+class FrameGenerationStats {
+ public:
+  struct Snapshot {
+    bool enabled = false, active = false, sampled = false;
+    uint32_t multiplier = 2;
+    double output_fps = 0;
+  };
+  static FrameGenerationStats& Get();
+  static double Now();
+  void Record(bool enabled, bool active, uint32_t multiplier, uint32_t presented) {
+    RecordAt(Now(), enabled, active, multiplier, presented);
+  }
+  Snapshot Read() const { return ReadAt(Now()); }
+  // Explicit times make pause, stale-data and multiplier transitions testable.
+  void RecordAt(double now, bool enabled, bool active, uint32_t multiplier, uint32_t presented);
+  Snapshot ReadAt(double now) const;
+
+ private:
+  mutable std::mutex mutex_;
+  Snapshot snapshot_;
+  double last_ = 0, begin_ = 0;
+  uint64_t presented_ = 0;
+  bool initialized_ = false;
+};
+}  // namespace rex::ui
