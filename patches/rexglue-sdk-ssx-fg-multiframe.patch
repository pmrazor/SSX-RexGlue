diff --git a/tests/unit/graphics/frame_generation_stats_test.cpp b/tests/unit/graphics/frame_generation_stats_test.cpp
new file mode 100644
index 0000000..c959094
--- /dev/null
+++ b/tests/unit/graphics/frame_generation_stats_test.cpp
@@ -0,0 +1,54 @@
+#include <catch2/catch_test_macros.hpp>
+#include <rex/ui/frame_generation_stats.h>
+
+using rex::ui::FrameGenerationStats;
+
+TEST_CASE("SSX FG rate uses actual presentations rather than the requested multiplier", "[ssx-fg]") {
+  FrameGenerationStats stats;
+  CHECK_FALSE(stats.ReadAt(10).enabled);
+  stats.RecordAt(10, true, true, 3, 3);
+  CHECK_FALSE(stats.ReadAt(10).sampled);
+  // 64 rendered frames/sec, but only two real presentations per call even
+  // though the user selected 3x. The overlay must report 128, not 192 FPS.
+  for (unsigned i = 1; i <= 32; ++i)
+    stats.RecordAt(10 + double(i) / 64, true, true, 3, 2);
+  auto value = stats.ReadAt(10.5);
+  CHECK(value.sampled);
+  CHECK(value.multiplier == 3);
+  CHECK(value.output_fps == 128);
+  for (unsigned i = 33; i <= 64; ++i)
+    stats.RecordAt(10 + double(i) / 64, true, true, 3, 3);
+  CHECK(stats.ReadAt(11).output_fps == 192);
+}
+
+TEST_CASE("SSX FG rate clears stale output on pause resize and mode changes", "[ssx-fg]") {
+  FrameGenerationStats stats;
+  stats.RecordAt(1, true, true, 3, 3);
+  stats.RecordAt(1.5, true, true, 3, 90);
+  REQUIRE(stats.ReadAt(1.5).output_fps == 180);
+  SECTION("pause and resume") {
+    stats.RecordAt(1.6, true, false, 3, 1);
+    CHECK_FALSE(stats.ReadAt(1.6).active);
+    CHECK(stats.ReadAt(1.6).output_fps == 0);
+    stats.RecordAt(1.7, true, true, 3, 3);
+    CHECK_FALSE(stats.ReadAt(1.7).sampled);
+  }
+  SECTION("hidden window with no Present calls") {
+    auto stale = stats.ReadAt(2.6);
+    CHECK_FALSE(stale.active);
+    CHECK(stale.output_fps == 0);
+    stats.RecordAt(2.7, true, true, 3, 3);
+    CHECK_FALSE(stats.ReadAt(2.7).sampled);
+  }
+  SECTION("multiplier changes start a fresh measurement") {
+    stats.RecordAt(1.6, true, true, 2, 2);
+    CHECK_FALSE(stats.ReadAt(1.6).sampled);
+    CHECK(stats.ReadAt(1.6).multiplier == 2);
+  }
+  SECTION("disabled mode cannot show active FG") {
+    stats.RecordAt(1.6, false, true, 3, 3);
+    CHECK_FALSE(stats.ReadAt(1.6).active);
+    CHECK_FALSE(stats.ReadAt(1.6).enabled);
+    CHECK(stats.ReadAt(1.6).output_fps == 0);
+  }
+}
