diff --git a/src/ui/frame_generation_stats.cpp b/src/ui/frame_generation_stats.cpp
new file mode 100644
index 0000000..19efaa0
--- /dev/null
+++ b/src/ui/frame_generation_stats.cpp
@@ -0,0 +1,49 @@
+#include <rex/ui/frame_generation_stats.h>
+#include <chrono>
+#include <cmath>
+
+namespace rex::ui {
+FrameGenerationStats& FrameGenerationStats::Get() {
+  static FrameGenerationStats stats;
+  return stats;
+}
+double FrameGenerationStats::Now() {
+  return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+void FrameGenerationStats::RecordAt(double now, bool enabled, bool active, uint32_t multiplier,
+                                    uint32_t presented) {
+  std::lock_guard lock(mutex_);
+  active &= enabled;
+  if (!std::isfinite(now)) {
+    snapshot_ = {};
+    initialized_ = false;
+    return;
+  }
+  if (!initialized_ || now < last_ || now - last_ > 1.0 || !active ||
+      snapshot_.enabled != enabled || snapshot_.active != active ||
+      snapshot_.multiplier != multiplier) {
+    snapshot_ = {enabled, active, false, multiplier, 0};
+    initialized_ = true;
+    begin_ = last_ = now;
+    presented_ = 0;
+    return;  // This Present establishes the new interval's starting boundary.
+  }
+  last_ = now;
+  presented_ += presented;
+  if (now - begin_ >= 0.5) {
+    snapshot_.output_fps = double(presented_) / (now - begin_);
+    snapshot_.sampled = true;
+    presented_ = 0;
+    begin_ = now;
+  }
+}
+FrameGenerationStats::Snapshot FrameGenerationStats::ReadAt(double now) const {
+  std::lock_guard lock(mutex_);
+  auto result = snapshot_;
+  if (!initialized_ || !std::isfinite(now) || now < last_ || now - last_ > 1.0) {
+    result.active = result.sampled = false;
+    result.output_fps = 0;
+  }
+  return result;
+}
+}  // namespace rex::ui
